# Disposable compiler/linker products.  Configure every local build below this
# repository root.  artifacts/ is deliberately not ignored: anything retained
# there is an admitted, reviewable repository artifact.
/build/

# Leak protection for compiler/linker products accidentally emitted outside
# the disposable build root.
*.obj
*.exe
*.pdb
*.ilk
*.map
*.lib
*.a
stdout.txt
stderr.txt
NUL.obj

# External comparison/import checkouts live under refs/.
refs/
