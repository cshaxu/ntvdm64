        "/* DIVERGENCE(MVDM-HOST-DIV-911): original thunk state and frame projections. */",
        "#include \"wow_thunk_provider.h\"",
        "VOID WINAPI wow_original_thunk_capture(wow_thunk_mode *mode)",
