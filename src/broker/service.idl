import "wtypes.idl";
[
    uuid(7d3e78bd-0472-4736-8797-e64e966d692e),
    version(1.0),
    pointer_default(unique)
]
interface vdm_service
{
    typedef [context_handle] void *VDM_CONNECTION;
    error_status_t Connect(
        [in] handle_t binding,
        [in, system_handle(sh_process)] HANDLE process,
        [out] VDM_CONNECTION *connection,
        [out] unsigned long *generation);
    error_status_t First(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out] unsigned long *first);
    /* The fixed-size reply is the copied BasepCheckVDM scalar envelope.
     * A resident VDM's source-shaped parent completion event crosses only as
     * a typed attachment; the companion receipt remains broker-local for
     * the original BasepGetVDMExitCode lookup. */
    error_status_t Check(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long request_bytes,
        [in, size_is(request_bytes)] byte *request,
        [out] unsigned long *parent_event_count,
        [out, system_handle(sh_event), size_is(,*parent_event_count)] HANDLE **parent_events,
        [out] unsigned long *parent_receipt,
        [out] unsigned long *reply_bytes,
        [out] byte reply[40]);
    error_status_t Get(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long request_bytes,
        [in, size_is(request_bytes)] byte *request,
        [out] unsigned long *wait_event_count,
        [out, system_handle(sh_event), size_is(,*wait_event_count)] HANDLE **wait_events,
        /* Standard streams are returned only through authenticated typed
         * attachments.  The copied reply retains receipt IDs, not HANDLEs. */
        [out] unsigned long *stream_count,
        [out, system_handle(sh_file), size_is(,*stream_count)] HANDLE **streams,
        [out] unsigned long *reply_bytes,
        [out, size_is(,*reply_bytes)] byte **reply);
    /* ExitVDM has no caller-owned command payload.  The worker states only
     * which original branch it is executing and, for WOW, the original task
     * identifier.  Console identity remains bound to its authenticated
     * connection.  The reply is deliberately a Boolean: a worker-local wait
     * event was already delivered by Get and must now be closed locally. */
    error_status_t Exit(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long is_wow,
        [in] unsigned long wow_task,
        [out] unsigned long *close_worker_wait);
    error_status_t Update(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long request_bytes,
        [in, size_is(request_bytes)] byte *request,
        [out] unsigned long *parent_event_count,
        [out, system_handle(sh_event), size_is(,*parent_event_count)] HANDLE **parent_events,
        [out] unsigned long *parent_receipt,
        [out] unsigned long *reply_bytes,
        [out] byte reply[32]);
    /* A receipt identifies the broker-local parent wait object already
     * created by original BaseSrv.  It is not a handle and is valid only for
     * this authenticated connection/generation. */
    error_status_t ExitCode(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long parent_receipt,
        [out] unsigned long *exit_code);
    /* This carries only the original INCREMENT_REENTER_COUNT or
     * DECREMENT_REENTER_COUNT selector.  Console identity stays bound to
     * the authenticated connection at BaseSrv, just as it is for GetNext. */
    error_status_t Reenter(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long increment);
    /* Reservation identifiers correlate a launch rollback only.  Worker
     * authority is the authenticated system process attachment in Prepare,
     * and Console identity remains local to the broker connection. */
    error_status_t Reserve(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long task,
        [out] hyper *reservation);
    error_status_t Prepare(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] hyper reservation,
        [in, system_handle(sh_process)] HANDLE worker);
    error_status_t Release(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] hyper reservation);
    error_status_t Disconnect(
        [in] handle_t binding,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in,out] VDM_CONNECTION *connection);
    error_status_t AttachFile(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long role,
        [in, system_handle(sh_file)] HANDLE stream,
        [out] unsigned long *receipt);
    error_status_t AttachPipe(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long role,
        [in, system_handle(sh_pipe)] HANDLE stream,
        [out] unsigned long *receipt);
    error_status_t RevokeStream(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long receipt);
}
