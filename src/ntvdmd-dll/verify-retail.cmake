if(NOT EXISTS "${REFERENCE}" OR NOT EXISTS "${IMAGE}")
  message(FATAL_ERROR "Both the expanded SP3 reference and the linked worker-side DLL are required")
endif()
file(REAL_PATH "${REFERENCE}" reference_path)
file(REAL_PATH "${IMAGE}" image_path)
if(reference_path STREQUAL image_path)
  message(FATAL_ERROR "The reference and build output must be separate files")
endif()
file(SHA256 "${REFERENCE}" retail)
if(NOT retail STREQUAL "1993dc8b41eb51ed2206a91a78d26c2c156974ec91e58d176d4ecb1edcb7436f")
  message(FATAL_ERROR "Unexpected Professional SP3 NTVDMD.DLL reference: ${retail}")
endif()
file(SHA256 "${IMAGE}" linked)
if(linked STREQUAL retail)
  message(STATUS "NTVDMD.DLL is byte-identical to SP3: ${linked}")
else()
  message(STATUS "NTVDMD.DLL comparison: locally linked=${linked} SP3 retail=${retail}")
endif()
