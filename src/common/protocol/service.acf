interface vdm_service
{
    [async] First();
    [async] Check();
    [async] Get();
    [async] Exit();
    [async] Update();
    [async] ExitCode();
    [async] Reenter();
    [async] AttachFile();
    [async] AttachPipe();
    [async] RevokeStream();
    [async] RegisterWowExec();
    [async] WowStyle();
    [async] WowStarted();
    [async] WowStartup();
    [async] TaskSnapshot();
    [async] WorkerTaskTrace();
    [async] SubmitNativeRequest();
    [async] FinishNativeRequest();
    [async] StartVdmWorker();
    [async] StartNativeWorker();
    [async] RetainFrontendRoot();
    [async] RequestFrontend();
    [async] ObserveNativeCreationAsync();
    [async] ObserveDosEventAsync();
    /* Exit reporting must not queue behind a blocking command receive. */
    [async] RequestParticipantExit([context_handle_noserialize] connection);
    [async] WaitFrontendConsoleRestored();
    [async] Connect();
    [async] CloseManagementNode();
    [async] FrontendCloseQuiesced();
    [async] FrontendConsoleRestored();
    [async] RetireWorkerlessFrontend();
    [async] FrontendJoinCandidate();
    [async] FrontendJoinDecision();
    [async] FrontendLeaseReady();
    [async] FrontendRequest();
    [async] FrontendIoDisconnected();
    [async] RegisterFrontendRoot();
    [async] RegisterFrontendLease();
    [async] ReportConsoleMembers();
    [async] AttachFrontendRequest();
    [async] StartFrontend();
    [async] FrontendStateChanged();
    [async] FrontendStartupResult();
    [async] Disconnect();
    [async] WorkerFrontendCapability();
    [async] WorkerIoReleaseEvent();
    [async] AcquireConsoleContext();
    [async] BindConsoleContext();
    /* These calls retain the same context identity. Service locks protect
     * mutable fields; RPC still excludes Close/rundown until calls finish.
     * A blocking receive must not exclude its worker's completion/sampling. */
    GetNextNativeCommand([context_handle_noserialize] connection);
    /* The resident worker remains in GetNextNativeCommand while its first
     * delivery registers the frontend backend and binds the suspended
     * native target.  These are authenticated worker-local state changes,
     * protected by the service lock; context serialization would otherwise
     * queue them behind that intentional blocking receive. */
    [async] RegisterNativeBackend([context_handle_noserialize] connection);
    [async] BindNativeTarget([context_handle_noserialize] connection);
    [async] CompleteWorkerChannel([context_handle_noserialize] connection);
    [async] NativeStartupResult([context_handle_noserialize] connection);
    [async] TakeFrontend([context_handle_noserialize] connection);
    /* The serving I/O thread must acquire/release its connection while the
     * worker's command thread is blocked in GetNextNativeCommand. Both calls
     * use the same authenticated identity and service-lock/CV protection. */
    [async] WorkerIoTransition([context_handle_noserialize] connection);
    [async] WorkerIoCheckpoint([context_handle_noserialize] connection);
    [async] WaitFrontend([context_handle_noserialize] connection);
}
