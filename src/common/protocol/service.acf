interface vdm_service
{
    /* These calls retain the same context identity. Service locks protect
     * mutable fields; RPC still excludes Close/rundown until calls finish.
     * A blocking receive must not exclude its worker's completion/sampling. */
    GetNextNativeCommand([context_handle_noserialize] connection);
    /* The resident worker remains in GetNextNativeCommand while its first
     * delivery registers the frontend backend and binds the suspended
     * native target.  These are authenticated worker-local state changes,
     * protected by the service lock; context serialization would otherwise
     * queue them behind that intentional blocking receive. */
    RegisterNativeBackend([context_handle_noserialize] connection);
    BindNativeTarget([context_handle_noserialize] connection);
    CompleteWorkerChannel([context_handle_noserialize] connection);
    NativeStartupResult([context_handle_noserialize] connection);
    TakeFrontend([context_handle_noserialize] connection);
    /* The serving I/O thread must acquire/release its connection while the
     * worker's command thread is blocked in GetNextNativeCommand. Both calls
     * use the same authenticated identity and service-lock/CV protection. */
    WorkerIoTransition([context_handle_noserialize] connection);
    WaitFrontend([context_handle_noserialize] connection);
}
