import "wtypes.idl";
[
    uuid(7d3e78bd-0472-4736-8797-e64e966d692e),
    version(34.0),
    pointer_default(unique)
]
interface vdm_service
{
    typedef [context_handle] void *VDM_CONNECTION;
    /* Copied native launch/control only; worker/frontend I/O stays direct.
     * The launcher classifies before admission. A NULL frontend submits a GUI
     * startup request: no character route, service-held actual process lifetime.
     * A non-NULL authenticated frontend retains the existing CUI/resume route. */
    error_status_t SubmitNativeRequest(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in, system_handle(sh_event)] HANDLE frontend,
        [in, range(0,1048576)] unsigned long bytes,
        [in, unique, size_is(bytes)] byte *payload,
        [out, system_handle(sh_process)] HANDLE *target,
        [out, system_handle(sh_event)] HANDLE *receipt,
        [out] unsigned long *request);
    error_status_t FinishNativeRequest(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation, [in] unsigned long request,
        [out] unsigned long *exit_code,
        /* True only after this caller consumes a real target completion.
         * Final I/O failure is separate from an unfinished worker failure. */
        [out] unsigned long *target_completed);
    /* Original Check selects kind/task; the caller cannot choose an image,
     * command line, creation flags or a worker process to resume. */
    error_status_t StartVdmWorker(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in, range(2,65536)] unsigned long environment_chars,
        [in, size_is(environment_chars)] wchar_t *environment,
        [in] unsigned long show_window,
        [in, system_handle(sh_event)] HANDLE frontend,
        [out, system_handle(sh_process)] HANDLE *worker,
        [out, system_handle(sh_event)] HANDLE *parent,
        [out] unsigned long *parent_receipt);
    error_status_t StartNativeWorker(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out, system_handle(sh_process)] HANDLE *worker);
    /* The broker creates the exact product frontend. Console operations are
     * performed by that frontend against this authenticated caller. */
    error_status_t StartFrontend(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation, [in] hyper console_window,
        [in] unsigned long borrowed,
        [out, system_handle(sh_process)] HANDLE *root,
        [out, system_handle(sh_event)] HANDLE *capability,
        [out, system_handle(sh_event)] HANDLE *restored);
    error_status_t ReturnFrontendConsole(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation);
    /* Startup outcome from the exact broker-admitted frontend process.
     * This is not the later Console restoration acknowledgement. */
    error_status_t FrontendStartupResult(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in, system_handle(sh_event)] HANDLE capability,
        [in] unsigned long status);
    error_status_t FrontendConsoleRestored(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation);
    error_status_t WaitFrontendConsoleRestored(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation);
    error_status_t WorkerShutdownEvent(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out, system_handle(sh_event)] HANDLE *shutdown);
    error_status_t CompleteWorkerChannel(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation, [in] unsigned long request,
        [in] unsigned long exit_code,
        [in] unsigned long io_error, [in] unsigned long io_flags);
    error_status_t NativeExitCode(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation, [in] unsigned long request,
        [out] unsigned long *exit_code);
    /* Explicit native-worker grant in the authenticated execution Console. */
    error_status_t SelectNativeWorker(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out, system_handle(sh_process)] HANDLE *worker);
    /* Native worker's one-command blocking acquire.  This is deliberately
     * shaped as GetNext rather than a transport wait: the recipient owns one
     * admitted Direct command, completes it, and then acquires the next. */
    error_status_t GetNextNativeCommand(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in, range(1,1048576)] unsigned long capacity,
        [out, size_is(capacity), length_is(*bytes)] byte *payload,
        [out] unsigned long *bytes,
        [out, system_handle(sh_process)] HANDLE *caller_process,
        [out, system_handle(sh_event)] HANDLE *execution,
        [out, system_handle(sh_event)] HANDLE *frontend,
        [out] unsigned long *request, [out] unsigned long *caller_generation);
    error_status_t NativeStartupResult(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation, [in] unsigned long caller_generation,
        [in] unsigned long request, [in] unsigned long status,
        [in, system_handle(sh_process)] HANDLE target,
        [in, system_handle(sh_event)] HANDLE receipt);
    error_status_t RegisterNativeBackend(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in, system_handle(sh_event)] HANDLE frontend,
        [in, system_handle(sh_event)] HANDLE stop,
        [in, system_handle(sh_event)] HANDLE closed);
    /* The authenticated native worker binds an admitted direct record to the
     * actual target it just created.  This is a typed process attachment,
     * never a launcher-nominated numeric PID. */
    error_status_t BindNativeTarget(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation, [in] unsigned long request,
        [in, system_handle(sh_process)] HANDLE target,
        [in, system_handle(sh_event)] HANDLE receipt);
    /* Execution Console association only; not frontend ownership or task selection. */
    error_status_t AcquireConsoleContext(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in, system_handle(sh_event)] HANDLE frontend,
        [out, system_handle(sh_event)] HANDLE *capability);
    error_status_t BindConsoleContext(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in, system_handle(sh_event)] HANDLE capability);
    error_status_t WorkerFrontendCapability(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out, system_handle(sh_event)] HANDLE *capability);
    error_status_t RegisterFrontendRoot(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in, system_handle(sh_event)] HANDLE capability);
    /* Console window is a serialized selection key, never authorization.
     * The root verifies a proposed launcher against its live Console list. */
    error_status_t AcquireFrontendRoot(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation, [in] hyper console_window,
        [out] unsigned long *create_root,
        [out, system_handle(sh_process)] HANDLE *root,
        [out, system_handle(sh_event)] HANDLE *capability,
        [out, system_handle(sh_event)] HANDLE *retire,
        [out, system_handle(sh_event)] HANDLE *restored);
    error_status_t CancelFrontendRootReservation(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation);
    error_status_t RegisterFrontendLease(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation, [in] hyper console_window,
        [in] unsigned long creator_pid, [in] unsigned long borrowed,
        [in, system_handle(sh_event)] HANDLE retire,
        [in, system_handle(sh_event)] HANDLE restored);
    error_status_t FrontendJoinCandidate(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out] unsigned long *nonce, [out] unsigned long *candidate_pid);
    error_status_t FrontendJoinDecision(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation, [in] unsigned long nonce,
        [in] unsigned long same_console);
    error_status_t FrontendLeaseReady(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation);
    error_status_t RetainFrontendRoot(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in, system_handle(sh_event)] HANDLE capability,
        [out, system_handle(sh_process)] HANDLE *root,
        [out] unsigned long *root_generation);
    error_status_t RequestFrontend(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in, system_handle(sh_event)] HANDLE capability);
    error_status_t FrontendRequest(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out] unsigned long *request,
        [out, system_handle(sh_process)] HANDLE *worker);
    error_status_t AttachFrontendRequest(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation, [in] unsigned long request,
        [in, system_handle(sh_pipe)] HANDLE channel,
        [in, system_handle(sh_event)] HANDLE ready);
    /* Original Check/Update chooses the worker. This grants only a pinned
     * query/synchronize capability to its waiting launcher, not a caller-
     * nominated process or a frame transport through BaseSrv. */
    error_status_t CommandWorker(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out, system_handle(sh_process)] HANDLE *worker);
    /* Direct frontend channel attachments only. No input/frame payloads or
     * caller-selected worker identity pass through these methods. */
    error_status_t AttachFrontend(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in, system_handle(sh_pipe)] HANDLE channel,
        [in, system_handle(sh_event)] HANDLE ready);
    error_status_t TakeFrontend(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out, system_handle(sh_pipe)] HANDLE *channel,
        [out, system_handle(sh_process)] HANDLE *frontend,
        [out] unsigned long *frontend_generation,
        [out, system_handle(sh_event)] HANDLE *ready);
    error_status_t WaitFrontend(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out, system_handle(sh_pipe)] HANDLE *channel,
        [out, system_handle(sh_process)] HANDLE *frontend,
        [out] unsigned long *frontend_generation,
        [out, system_handle(sh_event)] HANDLE *ready);
    /* This is an authenticated, copied management projection.  PID is its
     * sole cross-process worker identity; BaseSrv's sequence/generation stays
     * private routing state.  No HANDLE, guest pointer or record pointer is
     * serialized. */
    typedef struct _DTASKMGR_WORKER {
        unsigned long process_id;
        unsigned long kind;
        unsigned long state;
        hyper started_filetime;
        unsigned long task;
        /* Original DOS/WOW records or admitted native Direct records only. */
        unsigned long stack_depth;
        wchar_t image[260];
    } DTASKMGR_WORKER;
    /* Authenticated lifetime capability, not a PID or restart authority. */
    error_status_t BrokerProcess(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out, system_handle(sh_process)] HANDLE *server);
    error_status_t Connect(
        [in] handle_t binding,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long protocol,
        [in] byte application_version[32],
        [out] unsigned long *server_protocol,
        [out] byte server_version[32],
        [out] VDM_CONNECTION *connection,
        [out] unsigned long *generation);
    /* A launcher reports only the PIDs currently attached to its own
     * Console.  BaseSrv compares this local observation with authenticated
     * connections to choose an existing ConsoleRecord; no helper process,
     * Console HANDLE or caller-selected worker crosses the boundary. */
    error_status_t ReportConsoleMembers(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long member_count,
        [in, size_is(member_count)] unsigned long member_ids[]);
    error_status_t First(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out] unsigned long *first);
    /* The fixed-size reply is the copied BasepCheckVDM scalar envelope.
     * A resident VDM's source-shaped parent completion event crosses only as
     * a typed attachment; the companion receipt remains broker-local for
     * the original BasepGetVDMExitCode lookup. */
    error_status_t Check(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long request_bytes,
        [in, size_is(request_bytes)] byte *request,
        [out] unsigned long *parent_event_count,
        [out, system_handle(sh_event), size_is(,*parent_event_count)] HANDLE **parent_events,
        [out] unsigned long *parent_receipt,
        [out] unsigned long *reply_bytes,
        [out] byte reply[40]);
    error_status_t Get(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long request_bytes,
        [in, size_is(request_bytes)] byte *request,
        [out] unsigned long *wait_event_count,
        [out, system_handle(sh_event), size_is(,*wait_event_count)] HANDLE **wait_events,
        /* Standard streams are returned only through authenticated typed
         * attachments.  The copied reply retains receipt IDs, not HANDLEs. */
        /* A standard stream can be either a file or a pipe.  MIDL validates
         * system_handle object types, so do not mislabel a ConPTY pipe as a
         * file.  Each packed array is mapped back to stdin/stdout/stderr by
         * its position mask; the two masks must partition the scalar stream
         * presence bits in the copied reply. */
        [out] unsigned long *pipe_stream_mask,
        [out] unsigned long *pipe_stream_count,
        [out, system_handle(sh_pipe), size_is(,*pipe_stream_count)] HANDLE **pipe_streams,
        [out] unsigned long *file_stream_mask,
        [out] unsigned long *file_stream_count,
        [out, system_handle(sh_file), size_is(,*file_stream_count)] HANDLE **file_streams,
        [out] unsigned long *reply_bytes,
        [out, size_is(,*reply_bytes)] byte **reply);
    /* ExitVDM has no caller-owned command payload.  The worker states only
     * which original branch it is executing and, for WOW, the original task
     * identifier.  Console identity remains bound to its authenticated
     * connection.  The reply is deliberately a Boolean: a worker-local wait
     * event was already delivered by Get and must now be closed locally. */
    error_status_t Exit(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long is_wow,
        [in] unsigned long wow_task,
        [out] unsigned long *close_worker_wait);
    error_status_t Update(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long request_bytes,
        [in, size_is(request_bytes)] byte *request,
        [out] unsigned long *parent_event_count,
        [out, system_handle(sh_event), size_is(,*parent_event_count)] HANDLE **parent_events,
        [out] unsigned long *parent_receipt,
        [out] unsigned long *reply_bytes,
        [out] byte reply[32]);
    /* A receipt identifies the broker-local parent wait object already
     * created by original BaseSrv.  It is not a handle and is valid only for
     * this authenticated connection/generation. */
    error_status_t ExitCode(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long parent_receipt,
        [out] unsigned long *exit_code);
    /* This carries only the original INCREMENT_REENTER_COUNT or
     * DECREMENT_REENTER_COUNT selector.  Console identity stays bound to
     * the authenticated connection at BaseSrv, just as it is for GetNext. */
    error_status_t Reenter(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long increment);
    /* Reservation identifiers correlate a launch rollback only.  Worker
     * authority is the authenticated system process attachment in Prepare,
     * and Console identity remains local to the broker connection. */
    error_status_t Reserve(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long task,
        [in] unsigned long native_worker,
        [out] hyper *reservation);
    error_status_t Prepare(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] hyper reservation,
        [in, system_handle(sh_process)] HANDLE worker);
    error_status_t Release(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] hyper reservation);
    error_status_t Disconnect(
        [in] handle_t binding,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in,out] VDM_CONNECTION *connection);
    error_status_t AttachFile(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long role,
        [in, system_handle(sh_file)] HANDLE stream,
        [out] unsigned long *receipt);
    error_status_t AttachPipe(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long role,
        [in, system_handle(sh_pipe)] HANDLE stream,
        [out] unsigned long *receipt);
    error_status_t RevokeStream(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long receipt);
    /* These calls deliberately have no VDM_CONNECTION.  A viewer must not
     * become a registered worker/client merely by polling management state. */
    error_status_t TaskSnapshot(
        [in] handle_t binding,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long protocol,
        [in] byte application_version[32],
        [out] unsigned long *count,
        [out, size_is(,*count)] DTASKMGR_WORKER **entries);
    error_status_t TerminateWorker(
        [in] handle_t binding,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long protocol,
        [in] byte application_version[32],
        [in] unsigned long process_id);
    error_status_t RegisterWowExec(
        [in] handle_t binding,
        [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [in] unsigned long window);
    error_status_t FrontendUsage(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out] unsigned long *pending,
        [out] unsigned long *tasks);
    error_status_t RetireWorkerlessFrontend(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out] unsigned long *retired);
    /* Root-private auto-reset state event. It is separate from the
     * request-ready capability and wakes retirement retry only. */
    error_status_t FrontendStateChanged(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out, system_handle(sh_event)] HANDLE *state_changed);
    /* Launcher-private wake for worker registration/reservation changes.
     * Never share the frontend retirement auto-reset event with NTCON. */
    error_status_t WorkerStateChanged(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation,
        [out, system_handle(sh_event)] HANDLE *state_changed);
    error_status_t RetireFrontend(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation);
    error_status_t WowStarted(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation, [in] unsigned long task);
    error_status_t WowStartup(
        [in] handle_t binding, [in] VDM_CONNECTION connection,
        [in, system_handle(sh_process)] HANDLE process,
        [in] unsigned long generation, [in] unsigned long parent_receipt,
        [out, system_handle(sh_event)] HANDLE *event,
        [out] unsigned long *started);
}
