                  "/***************************************************************************\\",
                  "* InitLookaside",
                  "*",
                  "* Initializes the lookaside list. This improves control locality",
                  "* by keeping control entries in a single page",
                  "*",
                  "* 05-04-95 JimA         Created.",
                  "\\***************************************************************************/",
                  "",
                  "NTSTATUS",
                  "InitLookaside(",
                  "    PLOOKASIDE pla,",
                  "    DWORD cbEntry,",
                  "    DWORD cEntries)",
                  "{",
                  "    ULONG i;",
