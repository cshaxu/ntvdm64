        "        EM_stores(to, from, length);",
        "        return SUCCESS;",
        "    }",
        "    sas_overwrite_memory(guest_to, count);",
        "    ",
        "    result = mvdm_softpc_guest_memory_copy_to(guest_to, from, count) ?",
        "        SUCCESS : FAILURE;",
        "    ",
        "    return result;",
        "}",
