      "original": [
        "\tUTINY           cmos_byte;",
        "\tUTINY drive \t= hostID - C_FLOPPY_A_DEVICE;",
        "\tFLP flp \t= &floppy_data[drive];",
        "",
        "\tif(!strcmp(vals->string,\"\"))",
        "\t\treturn(C_CONFIG_OP_OK);",
        "",
        "\tstrcpy(flp->device_name, host_expand_environment_vars(vals->string));",
        "",
        "\tif(!host_validate_pathname(flp->device_name))",
        "\t{",
        "\t\tstrcpy(err, host_strerror(errno));",
        "\t\tflp->device_name[0] = '\\0';",
        "\t\treturn( EG_MISSING_FILE );",
        "\t}",
        "\tif(!host_file_is_char_dev(flp->device_name))",
        "\t{",
        "\t\tflp->device_name[0] = '\\0';",
        "\t\treturn( EG_NOT_CHAR_DEV );",
        "\t}",
        "",
        "\t/* Check the CMOS RAM values */",
        "\tcmos_read_byte(CMOS_DISKETTE, &cmos_byte);",
        "\tif (drive == 0)",
        "\t\tcmos_byte >>= 4;",
        "",
        "\tcmos_byte &= 0xf;       /* compare nibble value only */",
        "\tflp->drive_type = host_rflop_drive_type(drive);",
        "\tif (cmos_byte != flp->drive_type)",
        "\t\tvals->rebootReqd = TRUE;"
      ],
