      "current_count": 1,
      "original": [
        "\tFLP flp = &floppy_data[drive];",
        "",
        "\tswitch (rate)",
        "\t{",
        "\t\t/* 2.88M high-density floppies */",
        "\t\tcase DCR_RATE_1000:",
        "",
        "\t\t\tflp->density_state = DENSITY_EXTENDED;",
        "\t\t\tset_floppy_parms (flp);",
        "\t\t\tbreak;",
        "",
        "\t\t/* 1.2M or 1.44M high-density floppies */",
        "\t\tcase DCR_RATE_500:",
        "",
        "\t\t\tflp->density_state = DENSITY_HIGH;",
        "\t\t\tset_floppy_parms (flp);",
        "\t\t\tbreak;",
