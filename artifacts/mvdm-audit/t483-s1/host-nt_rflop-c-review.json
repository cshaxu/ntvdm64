      "current_count": 1,
      "original": [
        "GLOBAL void host_floppy_eject IFN1(UTINY, drive)",
        "{",
        "\tCHAR           *ebuf;",
        "\tFLP             flp = &floppy_data[drive];",
        "\tBOOL            device_was_closed = FALSE;",
        "",
        "\t/* open the device */",
        "\tif (flp->diskette_fd == INVALID_HANDLE_VALUE)",
        "\t{",
        "\t\tdevice_was_closed = TRUE;",
        "\t\t(void) nt_rdiskette_open_drive(drive);",
        "\t}",
        "",
        "\t/* Do the ioctl, put your ioctl here ",
        "",
        "\tif (ioctl(flp->diskette_fd, SMFDEJECT) < 0)",
        "\t{",
        "\t\tebuf = host_strerror(errno);",
        "\t\tassert1(NO, \"host_eject_floppy: %s\", ebuf);",
        "\t}*/",
        "",
        "\t/* Close the device if it wasn't open */",
        "",
        "\tif (device_was_closed)",
        "\t{",
        "\t\tnt_gfi_rdiskette_term(flp);",
        "\t}",
        "\telse",
        "\t{",
        "\t\t/* Line change ONLY if device was actively open */",
        "\t\tflp->change_line_state = TRUE;",
        "\t}",
        "}",
        ""
      ],
      "current": [
        "#error Unsupported excluded original configuration"
