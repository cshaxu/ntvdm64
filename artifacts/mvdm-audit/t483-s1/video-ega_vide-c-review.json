      "current": [
        "\t/* DIVERGENCE(MVDM-HOST-DIV-890): BIOS port writes are virtualised",
        "\t * in software V86; read the same VM's CRTC, not physical PCDisplay. */",
        "\telse if (video_adapter == VGA && getVM())",
        "\t{",
        "\t\thalf_word index, low, overflow, control;",
        "\t\tio_addr port = sas_w_at_no_check(VID_INDEX);",
        "\t\tinb(port, &index);",
        "\t\toutb(port, 0x12); inb(port + 1, &low);",
        "\t\toutb(port, 7); inb(port + 1, &overflow);",
        "\t\toutb(port, 0x17); inb(port + 1, &control);",
        "\t\toutb(port, index);",
        "\t\tscan_lines = low | ((overflow & 2) << 7) | ((overflow & 0x40) << 3);",
        "\t\t/* Preserve get_screen_height's V7 retrace multiplier and +1. */",
        "\t\tscan_lines = ((scan_lines + 1) << ((control >> 2) & 1)) + 1;",
        "\t}"
      ]
    },
