      "original": [
        "\t/*",
        "\t* Tim August 92, Microsoft.",
        "\t* Make text modes (0-3) use our mode parameters in KEYBOARD.SYS",
        "\t* Three entries in table: 40x25, 80x25 & 80x25 mono",
        "\t* Make that 4 - add font load mode B. We have to be defensive in",
        "\t* case of dubious values from cards or m/c. (Pro II/EISA, Olivetti MP)",
        "\t* Table order: 40x25, 80x25, mono, font",
        "\t*/",
        "\t{",
        "\t\textern word babyModeTable;",
        "\t\textern UTINY tempbabymode[];",
        "",
        "\t\tif(babyModeTable == 0)    /* ntio not loaded - use temp table */",
        "\t\t{",
        "\t\t    if (!soft_reset)       /* be absolutely sure about this */",
        "\t\t    {",
        "\t\t\t/* magic location:good until 16 bit code is running */",
        "\t\t\tsas_stores(0x41000, tempbabymode, 2 * EGA_PARMS_SIZE);",
        "\t\t\tif (mode == 0xb)",
        "\t\t\t    params_addr = 0x41000 + EGA_PARMS_SIZE;",
        "\t\t\telse",
        "\t\t\t    params_addr = 0x41000;  /* if not mode 3 tough */",
        "\t\t\treturn params_addr;",
        "\t\t    }",
        "#ifndef PROD",
        "\t\t    else",
        "\t\t\tprintf(\"NTVDM:video window parm table not loaded but system initialised\\n\");",
        "#endif",
        "\t\t}",
        "\t\tif(babyModeTable > 0)",
        "\t\t{",
        "\t\t    if (get_VGA_lines() == S350 && mode < 4)",
        "\t\t    {",
        "\t\t\tif (mode < 2)",
        "\t\t\t    params_addr = babyModeTable + 4*EGA_PARMS_SIZE;",
        "\t\t\telse",
        "\t\t\t    params_addr = babyModeTable + 5*EGA_PARMS_SIZE;",
        "\t\t    }",
        "\t\t    else",
        "\t\t    {",
        "\t\t\tif (mode < 4)",
        "\t\t\t{",
        "\t\t\t    mode = mode/2;",
        "\t\t\t\tparams_addr = babyModeTable + mode*EGA_PARMS_SIZE;",
        "\t\t\t}",
        "\t\t\telse",
        "\t\t\t{",
        "\t\t\t    if (mode == 0xb)",
        "\t\t\t\tparams_addr = babyModeTable + 3 * EGA_PARMS_SIZE;",
        "\t\t\t    else if (mode == 7)\t/* skip first 2 table entries */",
        "\t\t\t\tparams_addr = babyModeTable + 2 * EGA_PARMS_SIZE;",
        "\t\t\t}",
        "\t\t    }",
        "\t\t}",
        "\t}"
      ],
