        "        } Bytes;",
        "        struct {",
        "            ULONG   BaseMid : 8;",
        "            ULONG   Type : 5;",
        "            ULONG   Dpl : 2;",
        "            ULONG   Pres : 1;",
        "            ULONG   LimitHi : 4;",
        "            ULONG   Sys : 1;",
        "            ULONG   Reserved_0 : 1;",
        "            ULONG   Default_Big : 1;",
        "            ULONG   Granularity : 1;",
        "            ULONG   BaseHi : 8;",
        "        } Bits;",
        "    } HighWord;",
        "} VDMLDT_ENTRY;",
        "",
        ""
