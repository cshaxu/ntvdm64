      "original": [
        "LOCAL VOID",
        "ega_mode2_chn_move_guts IFN8(UTINY *, eas, UTINY *, ead, LONG, count,",
        "\tUTINY *, EGA_plane, ULONG, scratch, ULONG, plane, ULONG, w,",
        "\tULONG, src_flag )",
        "{",
        "\tULONG src, dst;",
        "\tUTINY *source;",
        "\tUSHORT value;",
        "\tULONG lsb;",
        "",
        "\tsrc = (ULONG) eas;",
        "",
        "\tdst = (ULONG) ead;",
        "",
        "\t/*",
        "\t *\teven planes cannot start with odd addresses",
        "\t *\todd planes cannot start with even addresses",
        "\t */",
        "",
        "\tif(( dst & 1 ) != ( plane & 1 ))\t",
        "\t{",
        "#ifdef BACK_M",
        "\t\tsrc--;",
        "\t\tscratch--;",
        "#else",
        "\t\tsrc++;",
        "\t\tscratch++;",
        "#endif",
        "\t\tdst++;",
        "\t\tcount--;",
        "\t}",
        "",
        "\tlsb = dst & 1;",
        "\tdst = (dst >> 1) << 2;",
        "\tdst |= lsb;",
        "",
        "\tif( src_flag )",
        "\t{",
        "\t\tlsb = src & 1;",
        "\t\tsrc = (src >> 1) << 2;",
        "\t\tsrc |= lsb;",
        "",
        "\t\tif( plane & 1 )",
        "\t\t{",
        "",
        "\t\t/*",
        "\t\t *\tThis causes latches to be read from 2 bytes above the word",
        "\t\t *\tthat was read if it was on an odd address, ie it only applies",
        "\t\t *\tto planes 1 and 3 in chained mode word operations.",
        "\t\t */",
        "",
        "\t\t\tsource = w ? &EGA_plane[src] + 2 : &EGA_plane[src];",
        "\t\t}",
        "\t\telse",
        "\t\t{",
        "\t\t\tsource = &EGA_plane[src];",
        "\t\t}",
        "",
        "\t\tsrc = scratch;",
        "\t}",
        "",
        "\tif( EGA_CPU.fun_or_protection )",
        "\t{",
        "\t\twhile( count > 0 )",
        "\t\t{",
        "\t\t\tcount -= 2;",
        "",
