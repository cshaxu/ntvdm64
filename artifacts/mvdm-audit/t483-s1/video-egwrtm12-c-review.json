      "current_count": 7,
      "original": [
        "/* used by both byte and word mode1 fill */",
        "",
        "LOCAL VOID",
        "ega_mode1_chn_fill IFN2(ULONG, offset, ULONG, count )",
        "{",
        "\tULONG low_offset;\t\t\t/* distance into regen buffer of start of write */",
        "\tULONG high_offset;\t\t/* distance into regen buffer of end of write */",
        "\tULONG length;\t\t\t/* length of fill in bytes */",
        "\tULONG lsb;",
        "",
        "\tnote_entrance0(\"ega_mode1_chn_fill\");",
        "",
        "\t/*",
        "\t *\tComplicated by possibility that only one of a chained pair of",
        "\t *\tplanes is write enabled, needing alternate bytes to be written.",
        "\t */",
        "",
        "\thigh_offset = offset + count - 1;",
        "\tlsb = high_offset & 1;",
        "\thigh_offset = (high_offset >> 1) << 2;",
        "\thigh_offset |= lsb;",
        "",
        "\tlow_offset = offset;",
        "\tlength = count;",
        "",
        "\tswitch( getVideoplane_enable() & 3 )",
        "\t{",
        "\t\tcase 1:\t/* just plane 0, ie even addresses to be written */",
        "\t\t\tif( offset & 1 )",
        "\t\t\t\tlow_offset++;",
        "",
        "\t\t\tlow_offset = (low_offset >> 1) << 2;",
        "\t\t\tfill_alternate_bytes( &EGA_plane01[low_offset],",
        "\t\t\t\t\t\t\t&EGA_plane01[high_offset], get_latch0 );",
        "\t\t\tbreak;",
        "",
        "\t\tcase 2:\t/* just plane 1, ie odd addresses to be written */",
        "\t\t\tif(( offset & 1 ) == 0 )",
        "\t\t\t\tlow_offset++;",
        "",
        "\t\t\tlow_offset = (low_offset >> 1) << 2;",
        "\t\t\tfill_alternate_bytes( &EGA_plane01[low_offset],",
        "\t\t\t\t\t\t\t&EGA_plane01[high_offset], get_latch1 );",
        "\t\t\tbreak;",
        "",
        "\t\tcase 3:\t/* sensible case is to have both chained planes write enabled */",
        "\t\t\tlsb = low_offset & 1;",
        "\t\t\tlow_offset = (low_offset >> 1) << 2;",
        "",
        "\t\t\tif( lsb )",
        "\t\t\t{",
        "\t\t\t\tEGA_plane01[low_offset + 1] = get_latch1;",
        "\t\t\t\tlow_offset += 4;",
        "\t\t\t\tlength--;",
        "\t\t\t}",
        "",
        "\t\t\tif( length & 1 )",
        "\t\t\t{",
        "\t\t\t\tlength -= 1;",
        "\t\t\t\tEGA_plane01[low_offset + (length << 1)] = get_latch0;",
        "\t\t\t}",
        "",
        "\t\t\tfill_both_bytes( get_latch1 | get_latch0 << 8,",
        "\t\t\t\t\t\t\t(USHORT *)&EGA_plane01[low_offset], length >> 1 );",
        "\t\t\tbreak;",
        "\t}\t/* end of switch on plane01 enabled */",
        "",
        "\tlow_offset = offset;",
        "\tlength = count;",
        "",
        "\tswitch( getVideoplane_enable() & 0xc )\t/* isolate 2 bits for planes2 and 3 */",
        "\t{",
        "\t\tcase 4:\t/* just plane 2, ie even addresses to be written */",
        "\t\t\tif( low_offset & 1 )",
        "\t\t\t\tlow_offset++;",
        "",
        "\t\t\tlow_offset = (low_offset >> 1) << 2;",
        "\t\t\tfill_alternate_bytes( &EGA_plane23[low_offset],",
        "\t\t\t\t\t\t\t&EGA_plane23[high_offset], get_latch2 );",
        "\t\t\tbreak;",
        "",
        "\t\tcase 8:\t/* just plane 3, ie odd addresses to be written */",
        "\t\t\tif(( low_offset & 1 ) == 0 )",
        "\t\t\t\tlow_offset++;",
        "",
        "\t\t\tlow_offset = (low_offset >> 1) << 2;",
        "\t\t\tfill_alternate_bytes( &EGA_plane23[low_offset],",
        "\t\t\t\t\t\t\t&EGA_plane23[high_offset], get_latch3 );",
        "\t\t\tbreak;",
        "",
        "\t\tcase 12:\t/* sensible case is to have both chained planes write enabled */",
        "\t\t\tlsb = low_offset & 1;",
        "\t\t\tlow_offset = (low_offset >> 1) << 2;",
        "",
        "\t\t\tif( lsb )",
        "\t\t\t{",
        "\t\t\t\tEGA_plane23[low_offset + 1] = get_latch1;",
        "\t\t\t\tlow_offset += 4;",
        "\t\t\t\tlength--;",
        "\t\t\t}",
        "",
        "\t\t\tif( length & 1 )",
        "\t\t\t{",
        "\t\t\t\tlength -= 1;",
        "\t\t\t\tEGA_plane23[low_offset + (length << 1)] = get_latch0;",
        "\t\t\t}",
        "",
        "\t\t\tfill_both_bytes( get_latch1 | get_latch0 << 8,",
        "\t\t\t\t\t\t\t(USHORT *)&EGA_plane23[low_offset], length >> 1 );",
        "\t\t\tbreak;",
        "\t}\t/* end of switch on plane23 enabled */",
        "}",
        "",
        "VOID",
        "ega_mode1_chn_b_fill IFN3(ULONG, value, ULONG, offset, ULONG, count )",
        "{",
        "  UNUSED(value);",
        "  ",
        "  note_entrance0(\"ega_mode1_chn_b_fill\");",
        "",
        "  ega_mode1_chn_fill( offset, count );",
        "  update_alg.mark_fill( offset, offset + count - 1 );",
        "}",
        "",
        "VOID",
        "ega_mode1_chn_w_fill IFN3(ULONG, value, ULONG, offset, ULONG, count )",
        "{",
        "\tUNUSED(value);",
        "\t",
        "\tnote_entrance0(\"ega_mode1_chn_w_fill\");",
        "",
        "\tega_mode1_chn_fill( offset, count );",
        "\tupdate_alg.mark_fill( offset, offset + count - 1 );",
        "}",
        "",
        "LOCAL VOID",
        "ega_mode1_chn_move_vid_src IFN5(ULONG, ead, ULONG, eas, ULONG, count,",
        "\tUTINY\t*, EGA_plane, ULONG, plane )",
        "{",
        "\tULONG end, lsbd, lsbs, dst, src;",
        "",
        "\tlsbs = eas & 1;",
        "\teas = (eas >> 1) << 2;\t",
        "\teas |= lsbs;",
        "",
        "\tend = ead + count - 1;",
        "\tlsbd = end & 1;",
        "\tend = (end >> 1) << 2;\t",
        "\tend |= lsbd;",
        "",
        "\tlsbd = ead & 1;",
        "\tead = (ead >> 1) << 2;\t",
        "\tead |= lsbd;",
        "",
        "\tif( lsbd != ( plane & 1 ))",
        "\t{",
        "\t\tdst = lsbd ? ead + 3 : ead + 1;",
        "\t\tsrc = lsbs ? eas + 3 : eas + 1;",
        "\t}",
        "\telse",
        "\t{",
        "\t\tdst = ead;",
        "\t\tsrc = eas;",
        "\t}",
        "",
        "\tcopy_alternate_bytes( &EGA_plane[dst], &EGA_plane[end], &EGA_plane[src] );",
        "}",
        "",
        "GLOBAL VOID",
        "ega_mode1_chn_b_move IFN4(ULONG, ead, ULONG, eas, ULONG, count, ULONG, src_flag )",
        "{",
        "\tnote_entrance0(\"ega_mode1_chn_b_move\");",
        "",
        "\tif( src_flag )",
        "\t{",
        "\t\tif( getDF() )",
        "\t\t{",
        "\t\t\teas -= count - 1;",
        "\t\t\tead -= count - 1;",
        "\t\t}",
        "",
        "\t\tif( getVideoplane_enable() & 1 )",
        "\t\t\tega_mode1_chn_move_vid_src( ead, eas, count, EGA_plane01, 0 );",
        "",
        "\t\tif( getVideoplane_enable() & 2 )",
        "\t\t\tega_mode1_chn_move_vid_src( ead, eas, count, EGA_plane01, 1 );",
        "",
        "\t\tif( getVideoplane_enable() & 4 )",
        "\t\t\tega_mode1_chn_move_vid_src( ead, eas, count, EGA_plane23, 2 );",
        "",
        "\t\tif( getVideoplane_enable() & 8 )",
        "\t\t\tega_mode1_chn_move_vid_src( ead, eas, count, EGA_plane23, 3 );",
        "\t}",
        "\telse\t/* source is not in ega memory, it becomes a fill */",
        "\t{",
        "\t\tif( getDF() )",
        "\t\t\tead -= count - 1;",
        "",
        "\t\tega_mode1_chn_fill( ead, count );",
        "\t}",
        "",
        "\tupdate_alg.mark_string( ead, ead + count - 1 );",
        "}",
        "",
        "VOID",
        "ega_mode1_chn_w_move IFN4(ULONG, ead, ULONG, eas, ULONG, count, ULONG, src_flag)",
        "{",
        "\tnote_entrance0(\"ega_mode1_chn_w_move\");",
        "",
        "\tcount <<= 1;",
        "",
        "\tif( src_flag )",
        "\t{",
        "\t\tif( getDF() )",
        "\t\t{",
        "\t\t\teas -= count - 2;",
        "\t\t\tead -= count - 2;",
        "\t\t}",
        "",
        "\t\tif( getVideoplane_enable() & 1 )",
        "\t\t\tega_mode1_chn_move_vid_src( ead, eas, count, EGA_plane01, 0 );",
        "",
        "\t\tif( getVideoplane_enable() & 2 )",
        "\t\t\tega_mode1_chn_move_vid_src( ead, eas, count, EGA_plane01, 1 );",
        "",
        "\t\tif( getVideoplane_enable() & 4 )",
        "\t\t\tega_mode1_chn_move_vid_src( ead, eas, count, EGA_plane23, 2 );",
        "",
        "\t\tif( getVideoplane_enable() & 8 )",
        "\t\t\tega_mode1_chn_move_vid_src( ead, eas, count, EGA_plane23, 3 );",
        "\t}",
        "\telse\t/* source is not in ega memory, it becomes a fill */",
        "\t{",
        "\t\tif( getDF() )",
        "\t\t\tead -= count - 2;",
        "",
        "\t\tega_mode1_chn_fill( ead, count );",
        "\t}",
        "",
        "\tupdate_alg.mark_string( ead, ead + count - 1 );",
        "}"
      ],
