    {
      "original_start": 158,
      "original_count": 182,
      "current_start": 101,
      "current_count": 0,
      "original": [
        "#ifdef CPU_30_STYLE",
        "#ifndef GISP_CPU    /* GISP has its own versions of these internal to the CPU */",
        "",
        "#define GET_SELECTOR_INDEX_TIMES8(x)  ((x) & 0xfff8)",
        "#define GET_SELECTOR_TI(x)            (((x) & 0x0004) >> 2)",
        "",
        "#if defined(CPU_40_STYLE)",
        "#if defined(PROD) && !defined(CCPU)",
        "#undef effective_addr",
        "GLOBAL LIN_ADDR effective_addr IFN2(IU16, seg, IU32, off)",
        "{",
        "\treturn (*(Cpu.EffectiveAddr))(seg, off);",
        "}",
        "#endif\t/* PROD & !CCPU */",
        "#else\t/* !CPU_40_STYLE */",
        "#if !(defined(NTVDM) && defined(MONITOR))  /* MS NT monitor has own effective_addr fn */",
        "/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/",
        "/* Calculate effective address.                                       */",
        "/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/",
        "",
        "GLOBAL LIN_ADDR effective_addr IFN2(IU16, seg, IU32, off)",
        "{",
        "\tLIN_ADDR descr_addr;",
        "\tDESCR entry;",
        "",
        "\tif ((!getPE()) || getVM()) {",
        "\t\treturn ((LIN_ADDR)seg << 4) + off;",
        "\t} else {",
        "#if defined(SWIN_CPU_OPTS) || defined(CPU_40_STYLE)",
        "\t\tLIN_ADDR base;",
        "",
        "\t\tif (Cpu_find_dcache_entry( seg, &base ))",
        "\t\t{",
        "\t\t\t/* Cache Hit!! */",
        "\t\t\treturn base + off;",
        "\t\t}",
        "#endif /* SWIN_CPU_OPTS or CPU_40_STYLE*/",
        "",
        "\t\tif ( selector_outside_table(seg, &descr_addr) == 1 ) {",
        "",
        "\t\t\t/*",
        "\t\t\t * This is probably not a major disaster, just a result",
        "\t\t\t * of the fact that after protected mode is invoked it",
        "\t\t\t * will take say 5-10 instructions for an application",
        "\t\t\t * to update all the segment registers. We just",
        "\t\t\t * maintain real mode semantics while this error occurs.",
        "\t\t\t */",
        "",
        "\t\t\treturn ((LIN_ADDR)seg << 4) + off;",
        "\t\t}",
        "\t\telse",
        "\t\t{",
        "\t\t\tread_descriptor(descr_addr, &entry);",
        "\t\t\treturn entry.base + off;",
        "\t\t}",
        "      \t}",
        "}",
        "",
        "#endif\t/* !(NTVDM & MONITOR) */",
        "",
        "/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/",
        "/* Read a decriptor table entry from memory.                          */",
        "/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/",
        "#endif\t/* !CPU_40_STYLE */",
        "",
        "GLOBAL void read_descriptor IFN2(LIN_ADDR, addr, DESCR *, descr)",
        "{",
        "\tIU32 first_dword, second_dword;",
        "\tIU32 limit;",
        "",
        "\t/*",
        "\t * The format of a 286 descriptor is:-",
        "\t *",
        "\t * ===========================",
        "\t * +1 |        LIMIT 15-0       | +0",
        "\t * ===========================",
        "\t * +3 |        BASE 15-0        | +2",
        "\t * ===========================",
        "\t * +5 |     AR     | BASE 23-16 | +4",
        "\t * ===========================",
        "\t * +7 |         RESERVED        | +6",
        "\t * ===========================",
        "\t */",
        "\t/*",
        "\t * The format of a 386 descriptor is:-",
        "\t *",
        "\t *    =============================      AR  = Access Rights.",
        "\t * +1 |         LIMIT 15-0        | +0   AVL = Available.",
        "\t *    =============================      D   = Default Operand",
        "\t * +3 |         BASE 15-0         | +2          Size, = 0 16-bit",
        "\t *    =============================                   = 1 32-bit.",
        "\t * +5 |      AR     | BASE 23-16  | +4   G   = Granularity,",
        "\t *    =============================             = 0 byte limit",
        "\t *    |             | | | |A|LIMIT|             = 1 page limit.",
        "\t * +7 | BASE 31-24  |G|D|0|V|19-16| +6",
        "\t *    |             | | | |L|     |",
        "\t *    =============================",
        "\t *",
        "\t */",
        "",
        "\t/* read in decriptor with minimum interaction with memory */",
        "#if defined(NTVDM) && defined(CPU_40_STYLE)",
        "    /* On NT, this routine can be called from non-CPU threads, so we don't */",
        "    /* want to use SAS at all. Instead, we rely on NtGetPtrToLinAddrByte,  */",
        "    /* which is provided by the CPU and is safe for multi-threading. We are*/",
        "    /* also relying on the fact the NT is always little-endian. */",
        "    {",
        "        IU32 *desc_addr = (IU32 *) NtGetPtrToLinAddrByte(addr);",
        "",
        "        first_dword = *desc_addr;",
        "        second_dword = *(desc_addr + 1);",
        "    }",
        "#else",
        "\tfirst_dword = sas_dw_at(addr);",
        "\tsecond_dword = sas_dw_at(addr+4);",
        "#endif",
        "",
        "\t/* load attributes and access rights */",
        "\tdescr->AR = (second_dword >> 8) & 0xff;",
        "",
        "\t/* unpack the base */",
        "\tdescr->base = (first_dword >> 16) | ",
        "#ifdef SPC386",
        "\t    (second_dword & 0xff000000) |",
        "#endif",
        "\t    (second_dword << 16 & 0xff0000 );",
        "",
        "\t/* unpack the limit */",
        "#ifndef SPC386",
        "\tdescr->limit = first_dword & 0xffff;",
        "#else",
        "\tlimit = (first_dword & 0xffff) | (second_dword & 0x000f0000);",
        "",
        "\tif ( second_dword & 0x00800000 ) /* check bit 23 */",
        "\t\t{",
        "\t\t\t/* Granularity Bit Set. Limit is expressed in pages",
        "\t (4k bytes), convert to byte limit */",
        "\t\t\tlimit = limit << 12 | 0xfff;",
        "\t\t}",
        "\tdescr->limit = limit;",
        "#endif /* ifndef SPC386 else */",
        "",
        "}",
        "",
        "#if !(defined(NTVDM) && defined(MONITOR))  /* MS NT monitor has own selector_outside_table fn */",
        "/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/",
        "/* Check if selector outside bounds of GDT or LDT                     */",
        "/* Return 1 for outside table, 0 for inside table.                    */",
        "/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/",
        "",
        "GLOBAL boolean selector_outside_table IFN2(IU16, selector, LIN_ADDR *, descr_addr)",
        "{",
        "\t/* selector\t\t(I) selector to be checked */",
        "\t/* descr_addr\t(O) address of related descriptor */",
        "",
        "\tLIN_ADDR offset;",
        "",
        "\toffset = GET_SELECTOR_INDEX_TIMES8(selector);",
        "",
        "\t/* choose a table */",
        "\tif ( GET_SELECTOR_TI(selector) == 0 )",
        "\t{",
        "\t\t/* GDT - trap NULL selector or outside table */",
        "\t\tif ( offset == 0 || offset + 7 > getGDT_LIMIT() )",
        "\t\t\treturn 1;",
        "\t\t*descr_addr = getGDT_BASE() + offset;",
        "\t}",
        "\telse",
        "\t{",
        "\t\t/* LDT - trap invalid LDT or outside table */",
        "\t\tif ( getLDT_SELECTOR() == 0 || offset + 7 > getLDT_LIMIT() )",
        "\t\t\treturn 1;",
        "\t\t*descr_addr = getLDT_BASE() + offset;",
        "\t}",
        "",
        "\treturn 0;",
        "}",
        "",
        "#endif\t/* !(NTVDM & MONITOR) */",
        "",
        "#endif /* !GISP_CPU */",
        "#endif /* CPU_30_STYLE */"
      ],
      "current": []
