    {
      "original_start": 451,
      "original_count": 51,
      "current_start": 348,
      "current_count": 1,
      "original": [
        "    Mask = 1 << ((dwBase - UMB->Base) / HOST_PAGE_SIZE);",
        "    SizeView =\tHOST_PAGE_SIZE;",
        "    Count = (USHORT)(Size / HOST_PAGE_SIZE);",
        "    SectionOffset.HighPart = 0;",
        "    SectionOffset.LowPart = dwBase - UMB_BASE_ADDRESS;",
        "",
        "    for (; Count > 0; Count--, Mask <<= 1) {",
        "\t// Commit memory if didn't do this before",
        "\tif ((UMB->Mask & Mask) == 0) {",
        "\t    Status = NtAllocateVirtualMemory(NtCurrentProcess(),",
        "\t\t\t\t\t     (PVOID *)&dwBase,",
        "\t\t\t\t\t     0,",
        "\t\t\t\t\t     &SizeView,",
        "\t\t\t\t\t     MEM_COMMIT,",
        "\t\t\t\t\t     UMB_PAGE_PROTECTION",
        "\t\t\t\t\t     );",
        "\t    if (!NT_SUCCESS(Status)) {",
        "\t\tSetLastError(ERROR_OUTOFMEMORY);",
        "\t\treturn FALSE;",
        "\t    }",
        "\t    UMB->Mask |= Mask;",
        "\t}",
        "\telse {",
        "\t    // the section has memory for it,",
        "\t    // first unmap it and then map it with correct commit size",
        "\t    Status = NtUnmapViewOfSection(NtCurrentProcess(),",
        "\t\t\t\t\t   (PVOID)dwBase",
        "\t\t\t\t\t   );",
        "\t    if (!NT_SUCCESS(Status)) {",
        "\t\tSetLastError(ERROR_ACCESS_DENIED);",
        "\t\treturn FALSE;",
        "\t    }",
        "\t    Status = NtMapViewOfSection(UMBSectionHandle,",
        "\t\t\t\t\tNtCurrentProcess(),",
        "\t\t\t\t\t(PVOID *)&dwBase,",
        "\t\t\t\t\t0,",
        "\t\t\t\t\tHOST_PAGE_SIZE,",
        "\t\t\t\t\t&SectionOffset,",
        "\t\t\t\t\t&SizeView,",
        "\t\t\t\t\tViewUnmap,",
        "\t\t\t\t\tMEM_DOS_LIM,",
        "\t\t\t\t\tUMB_PAGE_PROTECTION",
        "\t\t\t\t\t);",
        "\t    if (!NT_SUCCESS(Status)) {",
        "\t\tSetLastError(ERROR_OUTOFMEMORY);",
        "\t\treturn FALSE;",
        "\t    }",
        "\t}",
        "\tSectionOffset.LowPart += HOST_PAGE_SIZE;",
        "\tdwBase += HOST_PAGE_SIZE;",
        "    }"
