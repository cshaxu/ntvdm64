      ]
    },
    {
      "original_start": 680,
      "original_count": 6,
      "current_start": 538,
      "current_count": 1,
      "original": [
        "    ULONG h32;",
        "    int i = h16 >> 2;",
        "",
        "    h32 = i | (ULONG)(((PENTRYWOW)gpGdiHandleInfo)[i].FullUnique) << 16;",
        "",
        "    return((HANDLE)h32);"
      ],
      "current": [
        "    return mvdm_wow_gdi_handle_to_native((HAND16)h16);"
