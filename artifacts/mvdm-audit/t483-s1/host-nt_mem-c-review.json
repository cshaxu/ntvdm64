      "original": [
        "",
        "",
        "/*",
        "=========================== Dump Header Linked List ===========================",
        "PURPOSE:",
        "\tDump the headers linked list controlling allocated blocks",
        "",
        "",
        "INPUT:\t    None",
        "OUTPUT:     Via printf",
        "",
        "================================================================================",
        "*/",
        "",
        "GLOBAL VOID DumpAllocationHeaders IFN1(char*, where)",
        "{",
        "",
        "    SECTION_HEADER  *headerPtr; /* Pointer for searching through linked list. */",
        "",
        "    /* Dump headers */",
        "    printf(\"NTVDM: Dump Allocation Headers %s\\n\", where);",
        "    printf(\"ptr        address   status size     (k)     commit\\n\");",
        "",
        "    for(headerPtr = &headerTable[0] ;",
        "\theaderPtr != NULL ;",
        "\theaderPtr = headerPtr->next)",
        "    {",
        "\tprintf(\"%08lxh: %08lxh [%s] %08lxh (%05dK)%s%s\\n\",",
        "               headerPtr,",
        "\t       headerPtr->address - intelMem,",
        "\t       SECTION_IS_FREE(headerPtr) ? \"FREE\" : \"USED\",",
        "\t       headerPtr->size, headerPtr->size / ONE_K,",
        "\t       headerPtr->flags & HDR_COMMITTED_FLAG ? \" COMMITTED\" : \"\",",
        "\t       headerPtr->flags & HDR_REMAP_FLAG ? \" REMAPPED\" : \"\");",
        "    }",
        "",
        "    printf(\"\\n\");",
        "}",
        "",
        ""
      ],
      "current": [
