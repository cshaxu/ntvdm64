        "GLOBAL void herc_video_init IFN0()",
        "{",
        "",
        "/* Initialize the INTs */",
        "\tsas_storew(BIOS_EXTEND_CHAR*4, EGA_INT1F_OFF);",
        "\tsas_storew(BIOS_EXTEND_CHAR*4+2, EGA_SEG);",
        "\tsas_move_bytes_forward(BIOS_VIDEO_IO*4, 0x42*4, 4);  /* save old INT 10 as INT 42 */ ",
        "#ifdef GISP_SVGA",
        "\tif((ULONG) config_inquire(C_GFX_ADAPTER, NULL) == CGA )",
        "\t\tsas_storew(int_addr(0x10), CGA_VIDEO_IO_OFFSET);",
        "\telse",
        "#endif      /* GISP_SVGA */",
        "\tsas_storew(BIOS_VIDEO_IO*4, VIDEO_IO_OFFSET);",
        "\tsas_storew(BIOS_VIDEO_IO*4+2, VIDEO_IO_SEGMENT);",
        "",
        "",
        "/* Now set up the EGA BIOS variables */",
        "\tsas_storew(EGA_SAVEPTR,VGA_PARMS_OFFSET);",
        "\tsas_storew(EGA_SAVEPTR+2,EGA_SEG);",
        "\tsas_store(ega_info, 0x00);   /* Clear on mode change, 64K, EGA active, emulate cursor */",
        "\tsas_store(ega_info3, 0xf9);  /* feature bits = 0xF, EGA installed, use 8*14 font */",
        "\tset_VGA_flags(S350 | VGA_ACTIVE | VGA_MONO);",
        "\thost_memset(EGA_planes, 0, 4*EGA_PLANE_SIZE);",
        "\thost_mark_screen_refresh();",
        "\tinit_herc_globals();",
        "\tload_herc_font(EGA_CGMN,256,0,0,14);\t/* To initialize font */",
        "}",
        "",
        "",
        "GLOBAL void herc_char_gen IFN0()",
        "{",
        "\tswitch (getAL())",
        "\t{",
        "\t\tcase 3:",
        "\t\t\tbreak;",
        "\t\tcase 0:",
        "\t\tcase 0x10:",
        "\t\t\tload_herc_font(effective_addr(getES(),getBP()),getCX(),getDX(),getBL(),getBH());",
        "\t\t\tif(getAL()==0x10)",
        "\t\t\t\trecalc_text(getBH());",
        "\t\t\tbreak;",
        "\t\tcase 1:",
        "\t\tcase 0x11:",
        "\t\t\tload_herc_font(EGA_CGMN,256,0,getBL(),14);",
        "\t\t\tif(getAL()==0x11)",
        "\t\t\t\trecalc_text(14);",
        "\t\t\tbreak;",
        "",
        "\t\tcase 0x30:",
        "\t\t\tsetCX(sas_hw_at(ega_char_height));",
        "\t\t\tsetDL(VD_ROWS_ON_SCREEN);",
        "\t\t\tswitch (getBH())",
        "\t\t\t{",
        "\t\t\t\tcase 0:",
        "\t\t\t\t\tsetBP(sas_w_at(BIOS_EXTEND_CHAR*4));",
        "\t\t\t\t\tsetES(sas_w_at(BIOS_EXTEND_CHAR*4+2));",
        "\t\t\t\t\tbreak;",
        "\t\t\t\tcase 1:",
        "\t\t\t\t\tsetBP(sas_w_at(EGA_FONT_INT*4));",
        "\t\t\t\t\tsetES(sas_w_at(EGA_FONT_INT*4+2));",
        "\t\t\t\t\tbreak;",
        "\t\t\t\tcase 2:",
        "\t\t\t\t\tsetBP(EGA_CGMN_OFF);",
        "\t\t\t\t\tsetES(EGA_SEG);",
        "\t\t\t\t\tbreak;",
        "",
        "\t\t\t\tdefault:",
        "\t\t\t\t\tassert2(FALSE,\"Illegal char_gen subfunction %#x %#x\",getAL(),getBH());",
        "\t\t\t}",
        "\t\t\tbreak;",
        "\t\tdefault:",
        "\t\t\tassert1(FALSE,\"Illegal char_gen %#x\",getAL());",
        "\t}",
        "}",
        "",
        "GLOBAL load_herc_font IFN5(sys_addr, table, int, count, int, char_off, int, font_no, int, nbytes)",
        "{",
        "\tregister int i, j;",
        "\tregister host_addr font_addr;",
        "\tregister sys_addr data_addr;",
        "\tSAVED word font_off[] = { 0, 0x4000, 0x8000, 0xc000, 0x2000, 0x6000, 0xa000, 0xe000 };",
        "",
        "\t/*",
        "\t * Work out where to put the font. We know where",
        "\t * it's going to end up in the planes so ...",
        "\t */",
        "",
        "\tfont_addr = &EGA_planes[FONT_BASE_ADDR] +",
        "\t\t\t\t\t(font_off[font_no] << 2) + (FONT_MAX_HEIGHT*char_off << 2);",
        "\tdata_addr = table;",
        "",
        "\tassert2( FALSE, \"Font No. = %4d, No. of Bytes/char. def. = %4d\", font_no, nbytes );",
        "",
        "\tfor(i=0; i<count; i++) {",
        "",
        "\t\tfor(j=0; j<nbytes; j++) {",
        "\t\t\t*font_addr = sas_hw_at(data_addr++);",
        "\t\t\tfont_addr += 4;",
        "\t\t}",
        "",
        "\t\tfont_addr += ((FONT_MAX_HEIGHT - nbytes) << 2);",
        "\t}",
        "",
        "\thost_update_fonts();",
        "}",
        "",
