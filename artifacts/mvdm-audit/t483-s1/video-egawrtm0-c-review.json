      "original": [
        "LOCAL VOID",
        "ega_copy_move IFN6(UTINY *, dst, UTINY *, eas, ULONG, count, ULONG, src_flag,",
        "\tULONG, w, IBOOL, forward )",
        "{",
        "\tULONG lsbeas, lsbdst;",
        "\tULONG easinc, dstinc;",
        "\tULONG easoff, dstoff;",
        "\tUTINY *planes;",
        "",
        "\tnote_entrance0(\"ega_copy_move\");",
        "",
        "\t(*update_alg.mark_string)( (ULONG) dst, (ULONG) dst + count - 1);",
        "",
        "\tplanes = (UTINY *) getVideowplane();",
        "",
        "\tif( src_flag == 1 )",
        "\t{",
        "\t\tif(!forward)",
        "\t\t{",
        "\t\t\teas += w;",
        "\t\t\tdst += w;",
        "\t\t}",
        "",
        "\t\tlsbeas = (ULONG) eas & 0x1;",
        "\t\tlsbdst = (ULONG) dst & 0x1;",
        "",
        "\t\tif(forward)",
        "\t\t{",
        "\t\t\teasinc = lsbeas ? 3 : 1;",
        "\t\t\tdstinc = lsbdst ? 3 : 1;",
        "\t\t}",
        "\t\telse",
        "\t\t{",
        "\t\t\teasinc = lsbeas ? -1 : -3;",
        "\t\t\tdstinc = lsbdst ? -1 : -3;",
        "\t\t}",
        "",
        "\t\teasoff = (( (ULONG) eas >> 1 ) << 2 ) | lsbeas;",
        "\t\tdstoff = (( (ULONG) dst >> 1 ) << 2 ) | lsbdst;",
        "",
        "\t\twhile( count-- )",
        "\t\t{",
        "\t\t\t*(planes + dstoff) = *(planes + easoff);",
        "",
        "\t\t\tdstoff += dstinc;",
        "\t\t\teasoff += easinc;",
        "\t\t\tdstinc ^= 0x2;",
        "\t\t\teasinc ^= 0x2;",
        "\t\t}",
        "\t}",
        "\telse",
        "\t{",
        "\t\tif(!forward)",
        "\t\t{",
        "\t\t\tdst += w;",
        "#ifdef BACK_M",
        "\t\t\teas -= w;",
        "#else",
        "\t\t\teas += w;",
        "#endif",
        "\t\t}",
        "",
        "\t\tlsbdst = (ULONG) dst & 0x1;",
        "",
        "\t\tif(forward)",
        "\t\t{",
        "#ifdef BACK_M",
        "\t\t\teasinc = -1;",
        "#else",
        "\t\t\teasinc = 1;",
        "#endif",
        "\t\t\tdstinc = lsbdst ? 3 : 1;",
        "\t\t}",
        "\t\telse",
        "\t\t{",
        "#ifdef BACK_M",
        "\t\t\teasinc = 1;",
        "#else",
        "\t\t\teasinc = -1;",
        "#endif",
        "\t\t\tdstinc = lsbdst ? -1 : -3;",
        "\t\t}",
        "",
        "\t\tdstoff = (((ULONG) dst >> 1 ) << 2 ) | lsbdst;",
        "",
        "\t\twhile( count-- )",
        "\t\t{",
        "\t\t\t*(planes + dstoff) = *eas;",
        "",
        "\t\t\tdstoff += dstinc;",
        "\t\t\teas += easinc;",
        "\t\t\tdstinc ^= 0x2;",
        "\t\t}",
        "\t}",
        "}",
        "",
        "",
        "VOID",
        "ega_copy_b_move IFN4(UTINY *,  offset, UTINY *, eas, ULONG, count,",
        "\tULONG, src_flag )",
        "{",
        "\tega_copy_move(offset, eas, count, src_flag, 0, getDF() ? FALSE : TRUE);",
        "}",
        "",
        "VOID",
        "ega_copy_b_move_fwd IFN4(ULONG,  offset, ULONG, eas, ULONG, count,",
        "\tULONG, src_flag )",
        "{",
        "\tega_copy_move( (UTINY *)offset, (UTINY *)eas, count, src_flag, 0, TRUE );",
        "}",
        "",
        "VOID",
        "ega_copy_b_move_bwd IFN4(ULONG,  offset, ULONG, eas, ULONG, count,",
        "\tULONG, src_flag )",
        "{",
        "\tega_copy_move( (UTINY *)offset, (UTINY *)eas, count, src_flag, 0, FALSE );",
        "}",
        "",
        "VOID",
        "ega_copy_w_move IFN4(UTINY *,  offset, UTINY *, eas, ULONG, count,",
        "\tULONG, src_flag )",
        "{",
        "\tega_copy_move(offset, eas, count << 1, src_flag, 1, getDF() ? FALSE : TRUE);",
        "}",
        "",
        "VOID",
        "ega_copy_w_move_fwd IFN4(ULONG,  offset, ULONG, eas, ULONG, count,",
        "\tULONG, src_flag )",
        "{",
        "\tega_copy_move( (UTINY *)offset, (UTINY *)eas, count << 1, src_flag, 1, TRUE );",
        "}",
        "",
        "VOID",
        "ega_copy_w_move_bwd IFN4(ULONG,  offset, ULONG, eas, ULONG, count,",
        "\tULONG, src_flag )",
        "{",
        "\tega_copy_move( (UTINY *)offset, (UTINY *)eas, count << 1, src_flag, 1, FALSE );",
        "}"
