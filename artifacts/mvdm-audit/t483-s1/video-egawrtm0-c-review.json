      "current_count": 4,
      "original": [
        "LOCAL VOID",
        "ega_mode0_chn_move_ram_src IFN5(UTINY *, eas, LONG, count, UTINY *, ead,",
        "\tUTINY *, EGA_plane, ULONG, plane )",
        "{",
        "\tULONG\toffset;",
        "\tUTINY *src_offset;",
        "\tUTINY value;",
        "\tULONG lsb, srcinc;",
        "",
        "\tsrc_offset = (UTINY *) eas;",
        "\toffset = (ULONG) ead;",
        "",
        "\tif(( offset & 1 ) != ( plane & 1 ))",
        "\t{",
        "#ifdef BACK_M",
        "\t\tsrc_offset--;",
        "#else",
        "\t\tsrc_offset++;",
        "#endif",
        "\t\toffset++;",
        "\t\tcount--;",
        "\t}",
        "",
        "#ifdef BACK_M",
        "\tsrcinc = -2;",
        "#else",
        "\tsrcinc = 2;",
        "#endif",
        "",
        "\tlsb = offset & 1;",
        "\toffset = (offset >> 1) << 2;",
        "\toffset |= lsb;",
        "",
        "\t/*",
        "\t * check if set/reset function enable for this plane ",
        "\t */",
        "",
        "\tif( EGA_CPU.sr_enable & ( 1 << plane ))",
        "\t{",
        "\t\tvalue = *((UTINY *) &EGA_CPU.sr_value + plane );",
        "",
        "\t\twhile( count > 0 )",
        "\t\t{",
        "\t\t\tcount -= 2;",
        "",
        "\t\t\tEGA_plane[offset] = do_logicals( value, get_latch(plane) );",
        "\t\t\toffset += 4;",
        "\t\t}",
        "\t}",
        "\telse",
        "\t{",
        "\t\twhile( count > 0 )",
        "\t\t{",
        "\t\t\tvalue = *src_offset;",
        "\t\t\tsrc_offset += srcinc;",
        "\t\t\tcount -= 2;",
        "",
        "\t\t\t/*",
        "\t\t\t * set/reset not enabled so here we go",
        "\t\t\t */",
        "",
        "\t\t\tif( getVideorotate() > 0 )",
        "\t\t\t\tvalue = rotate( value, getVideorotate() );",
        "",
        "\t\t\tvalue = do_logicals( value, get_latch(plane) );",
        "\t\t\tEGA_plane[offset] = value;",
        "\t\t\toffset += 4;",
        "\t\t}",
        "\t}",
        "}",
        "",
        "LOCAL VOID",
        "ega_mode0_chn_move_vid_src IFN7(UTINY *, eas, LONG, count, UTINY *, ead,",
        "\tUTINY *, EGA_plane, UTINY *, scratch, ULONG, plane, ULONG, w )",
        "{",
        "\tULONG\toffset;",
        "\tULONG src_offset;",
        "\tUTINY *source;",
        "\tUTINY value;",
        "\tUTINY valsrc;",
        "\tULONG lsb, inc, srcinc;",
        "",
        "\toffset = (ULONG ) ead;",
        "",
        "\tif(( offset & 1 ) != ( plane & 1 ))",
        "\t{",
        "\t\teas++;",
        "#ifdef BACK_M",
        "\t\tscratch--;",
        "#else",
        "\t\tscratch++;",
        "#endif",
        "\t\toffset++;",
        "\t\tcount--;",
        "\t}",
        "",
        "\tsrc_offset = (ULONG) eas;",
        "",
        "#ifdef BACK_M",
        "\tsrcinc = -2;",
        "#else",
        "\tsrcinc = 2;",
        "#endif",
        "\tinc = 4;",
        "",
        "\tlsb = offset & 1;",
        "\toffset = (offset >> 1) << 2;",
        "\toffset |= lsb;",
        "",
        "\tlsb = src_offset & 1;",
        "\tsrc_offset = (src_offset >> 1) << 2;",
        "\tsrc_offset |= lsb;",
        "",
        "\tsource = &EGA_plane[src_offset] + (w << 2);",
        "",
        "\t/*",
        "\t * check if set/reset function enable for this plane ",
        "\t */",
        "",
        "\tif( EGA_CPU.sr_enable & ( 1 << plane ))",
        "\t{",
        "\t\tvalue = *((UTINY *) &EGA_CPU.sr_value + plane );",
        "",
        "\t\twhile( count > 0 )",
        "\t\t{",
        "\t\t\tcount -= 2;",
        "\t\t\tvalsrc = *source;",
        "\t\t\tsource += inc;",
        "\t\t\tEGA_plane[offset] = do_logicals( value, valsrc );",
        "\t\t\toffset += inc;",
        "\t\t}",
        "\t}",
        "\telse",
        "\t{",
        "\t\twhile( count > 0 )",
        "\t\t{",
        "\t\t\tcount -= 2;",
        "",
        "\t\t\tvalue = *(UTINY *) scratch;",
        "\t\t\tscratch += srcinc;",
        "",
        "\t\t\tvalsrc = *source;",
        "\t\t\tsource += inc; ",
        "",
        "\t\t\t/*",
        "\t\t\t * set/reset not enabled so here we go",
        "\t\t\t */",
        "",
        "\t\t\tif( getVideorotate() > 0 )",
        "\t\t\t\tvalue = rotate( value, getVideorotate() );",
        "",
        "\t\t\tvalue = do_logicals( value, valsrc );",
        "\t\t\tEGA_plane[offset] = value;",
        "\t\t\toffset += inc;",
        "\t\t}",
        "\t}",
        "}",
        "",
        "VOID",
        "ega_mode0_chn_move IFN6(UTINY, w, UTINY *, ead, UTINY *, eas, ULONG, count,",
        "\tULONG, src_flag, IBOOL, forwards )",
        "{",
        "\tUTINY *scratch;",
        "\tIMPORT VOID (*string_read_ptr)();",
        "",
        "\tnote_entrance0(\"ega_mode0_chn_move\");",
        "",
        "\tif( src_flag == 1 )",
        "\t{",
        "\t\t/*",
        "\t\t *\tSource is in EGA, latches will change with each byte moved. We",
        "\t\t *\trestore CPU's view of source in regen, and use it to update planes",
        "\t\t *\twith the aid of the SAS scratch area.",
        "\t\t */",
        "",
        "#ifdef BACK_M",
        "\t\tscratch = getVideoscratch() + 0x10000 - 1;",
        "#else",
        "\t\tscratch = getVideoscratch();",
        "#endif",
        "",
        "\t\tif( !forwards )",
        "\t\t{",
        "\t\t\teas += - count + 1 + w;",
        "\t\t\tead += - count + 1 + w;",
        "\t\t}",
        "",
        "\t\t(*string_read_ptr)( scratch, eas, count );",
        "",
        "\t\tif( getVideoplane_enable() & 1 )",
        "\t\t\tega_mode0_chn_move_vid_src( eas, count, ead, EGA_plane01, scratch, 0, 0 );",
        "",
        "\t\tif( getVideoplane_enable() & 2 )",
        "\t\t\tega_mode0_chn_move_vid_src( eas, count, ead, EGA_plane01, scratch, 1, w );",
        "",
        "\t\tif( getVideoplane_enable() & 4 )",
        "\t\t\tega_mode0_chn_move_vid_src( eas, count, ead, EGA_plane23, scratch, 2, 0 );",
        "",
        "\t\tif( getVideoplane_enable() & 8 )",
        "\t\t\tega_mode0_chn_move_vid_src( eas, count, ead, EGA_plane23, scratch, 3, w );",
        "\t}",
        "\telse",
        "\t{",
        "\t\tif( !forwards )",
        "\t\t{",
        "#ifdef BACK_M",
        "\t\t\teas += count - 1 - w;",
        "#else",
        "\t\t\teas += - count + 1 + w;",
        "#endif",
        "\t\t\tead += - count + 1 + w;",
        "\t\t}",
        "",
        "\t\tif( getVideoplane_enable() & 1 )",
        "\t\t\tega_mode0_chn_move_ram_src( eas, count, ead, EGA_plane01, 0 );",
        "",
        "\t\tif( getVideoplane_enable() & 2 )",
        "\t\t\tega_mode0_chn_move_ram_src( eas, count, ead, EGA_plane01, 1 );",
        "",
        "\t\tif( getVideoplane_enable() & 4 )",
        "\t\t\tega_mode0_chn_move_ram_src( eas, count, ead, EGA_plane23, 2 );",
        "",
        "\t\tif( getVideoplane_enable() & 8 )",
        "\t\t\tega_mode0_chn_move_ram_src( eas, count, ead, EGA_plane23, 3 );",
        "\t}",
        "",
        "\t(*update_alg.mark_string)( (ULONG) ead, (ULONG) ead + count );",
        "}",
        "",
        "",
        "VOID",
        "ega_mode0_chn_b_move IFN4(ULONG, ead, ULONG, eas, ULONG, count, ULONG, src_flag)",
        "{",
        "\tega_mode0_chn_move( 0, (UTINY *)ead, (UTINY *)eas, count, src_flag, getDF() ? FALSE : TRUE);",
        "}",
        "",
        "VOID",
        "ega_mode0_chn_b_move_fwd IFN4(ULONG, ead, ULONG, eas, ULONG, count,",
        "\tULONG, src_flag )",
        "{",
        "\tega_mode0_chn_move( 0, (UTINY *)ead, (UTINY *)eas, count, src_flag, TRUE );",
        "}",
        "",
        "VOID",
        "ega_mode0_chn_b_move_bwd IFN4(ULONG, ead, ULONG, eas, ULONG, count,",
        "\tULONG, src_flag )",
        "{",
        "\tega_mode0_chn_move( 0, (UTINY *)ead, (UTINY *)eas, count, src_flag, FALSE );",
        "}",
        "",
        "VOID",
