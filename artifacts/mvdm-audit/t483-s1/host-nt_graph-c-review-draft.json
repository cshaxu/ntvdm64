      "original": [
        "/* The mouse calls this func when it sees a mode change. If we're windowed",
        " * we pass it off to the softpc bios (who may want to switch to fullscreen).",
        " * If we're fullscreen we do nothing as the native bios will take care of",
        " * everything.",
        " */",
        "void host_call_bios_mode_change(void)",
        "{",
        "    extern void ega_video_io();",
        "    half_word mode;",
        "",
        "    if (sc.ScreenState == WINDOWED)",
        "    {",
        "\tega_video_io();",
        "    }",
        "    else",
        "    {",
        "",
        "\t/*",
        "\t * We have a fullscreen mode change so we need to change the mouse",
        "\t * buffer so that we get mouse coordinates of the correct resolution.",
        "\t */",
        "\tmode = getAL();",
        "\tSelectMouseBuffer(mode, 0);",
        "    }",
        "}"
      ],
      "current": [
        "#error DIVERGENCE MVDM-HOST-DIV-507: MONITOR branch is not selected for this source; see mirror register."
