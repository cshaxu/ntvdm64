      "current_count": 1,
      "original": [
        "",
        "/*",
        "\tThe following functions are MEM_HANDLER functions for the CGA-only",
        "\tbuild with no C_VID (no a common build). They are unused for most",
        "\tvariants of SoftPC.",
        "*/",
        "",
        "#define INTEL_SRC\t0",
        "#define HOST_SRC\t1",
        "",
        "/*",
        "======================== cga_only_simple_handler =========================",
        "PURPOSE:\tThis function provides a stub for the unused MEM_HANDLER",
        "\t\tfunctions. This function probably shouldn't be called hence",
        "\t\tthe trace statement.",
        "INPUT:\t\tNone.",
        "OUTPUT:\t\tNone.",
        "==========================================================================",
        "*/",
        "LOCAL void cga_only_simple_handler IFN0()",
        "{",
        "\talways_trace0(\"cga_only_simple_handler called\");",
        "\tsetVideodirty_total(getVideodirty_total() + 1);",
        "}",
        "",
        "/*",
        "=========================== cga_only_b_write =============================",
        "PURPOSE:\tByte write function. Puts the value at the given address",
        "\t\tand increments dirty_flag.",
        "INPUT:\t\tAddress (in terms of M) and value to put there.",
        "OUTPUT:\t\tNone.",
        "==========================================================================",
        "*/",
        "LOCAL void cga_only_b_write IFN2(UTINY *, addr, ULONG, val)",
        "{",
        "\thost_addr\tptr;",
        "\tULONG\t\toffs;",
        "\t",
        "\toffs = (ULONG) (addr - gvi_pc_low_regen);",
        "\tptr = get_screen_ptr(offs);",
        "\t*ptr = val & 0xff;",
        "\tsetVideodirty_total(getVideodirty_total() + 1);",
        "}",
        "",
        "/*",
        "=========================== cga_only_w_write =============================",
        "PURPOSE:\tWord write function. Puts the value at the given address",
        "\t\tand increments dirty_flag.",
        "INPUT:\t\tAddress (in terms of M) and value to put there.",
        "OUTPUT:\t\tNone.",
        "==========================================================================",
        "*/",
        "LOCAL void cga_only_w_write IFN2(UTINY *, addr, ULONG, val)",
        "{",
        "\thost_addr\tptr;",
        "\tULONG\t\toffs;",
        "\t",
        "\toffs = (ULONG) (addr - gvi_pc_low_regen);",
        "\tptr = get_screen_ptr(offs);",
        "\t*ptr++ = val & 0xff;",
        "\t*ptr = (val >> 8) & 0xff;",
        "\tsetVideodirty_total(getVideodirty_total() + 2);",
        "}",
        "",
        "/*",
        "=========================== cga_only_b_fill ==============================",
        "PURPOSE:\tByte fill function. Fills the given address range with the",
        "\t\tvalue and increments dirty_flag.",
        "INPUT:\t\tAddress range (in terms of M) and value to put there.",
        "OUTPUT:\t\tNone.",
        "==========================================================================",
        "*/",
        "LOCAL void cga_only_b_fill IFN3(UTINY *, laddr, UTINY *, haddr, ULONG, val )",
        "{",
        "\thost_addr\tptr;",
        "\tIS32\t\tlen;",
        "\tULONG\t\toffs;",
        "\t\t",
        "\toffs = (ULONG) (laddr - gvi_pc_low_regen);",
        "\tptr = get_screen_ptr(offs);",
        "\tfor (len = (haddr - laddr); len > 0; len--)",
        "\t\t*ptr++ = val;",
        "}",
        "",
        "/*",
        "=========================== cga_only_w_fill ==============================",
        "PURPOSE:\tWord fill function. Fills the given address range with the",
        "\t\tvalue and increments dirty_flag.",
        "INPUT:\t\tAddress range (in terms of M) and value to put there.",
        "OUTPUT:\t\tNone.",
        "==========================================================================",
        "*/",
        "LOCAL void cga_only_w_fill IFN3(UTINY *, laddr, UTINY *, haddr, ULONG, val )",
        "{",
        "\thost_addr\tptr;",
        "\tIS32\t\tlen;",
        "\tIU8\t\tlo;",
        "\tIU8\t\thi;",
        "\tULONG\t\toffs;",
        "\t",
        "\tlo = val & 0xff;",
        "\thi = (val >> 8) & 0xff;",
        "\toffs = (ULONG) (laddr - gvi_pc_low_regen);",
        "\tptr = get_screen_ptr(offs);",
        "\tfor (len = (haddr - laddr) >> 1; len > 0; len--)",
        "\t{",
        "\t\t*ptr++ = lo;",
        "\t\t*ptr++ = hi;",
        "\t}",
        "}",
        "",
        "LOCAL void cga_only_b_move IFN4(UTINY *, laddr, UTINY *, haddr, UTINY *, src,",
        "\tUTINY, src_type)",
        "{",
        "\thost_addr\tsrc_ptr;",
        "\thost_addr\tdst_ptr;",
        "\tIS32\t\tlen;",
        "\tULONG\t\toffs;",
        "\tBOOL\t\tmove_bwds = getDF();",
        "\t",
        "\toffs = (ULONG) (laddr - gvi_pc_low_regen);",
        "\tdst_ptr = get_screen_ptr(offs);",
        "\tlen = haddr - laddr;",
        "\tif ((src_type == HOST_SRC) || (src < (UTINY *)gvi_pc_low_regen) ||",
        "\t\t((UTINY *)gvi_pc_high_regen < src))",
        "\t{",
        "\t\t/* Ram source */",
        "\t\tif (src_type == INTEL_SRC)",
        "\t\t\tsrc_ptr = get_byte_addr(src);",
        "\t\telse",
        "\t\t\tsrc_ptr = src;",
        "\t\t",
        "\t\t/* Ram to video move - video is always forwards, ram",
        "\t\t** depends on BACK_M.",
        "\t\t*/",
        "\t\tif (move_bwds)",
        "\t\t{",
        "\t\t\tdst_ptr += len;",
        "#ifdef\tBACK_M",
        "\t\t\tsrc_ptr -= len;",
        "\t\t\tfor ( ; len > 0; len--)",
        "\t\t\t\t*(--dst_ptr) = *(++src_ptr);",
        "#else",
        "\t\t\tsrc_ptr += len;",
        "\t\t\tfor ( ; len > 0; len--)",
        "\t\t\t\t*(--dst_ptr) = *(--src_ptr);",
        "#endif\t/* BACK_M */",
        "\t\t}",
        "\t\telse",
        "\t\t{",
        "#ifdef\tBACK_M",
        "\t\t\tfor ( ; len > 0; len--)",
        "\t\t\t\t*dst_ptr++ = *src_ptr--;",
        "#else",
        "\t\t\tmemcpy(dst_ptr, src_ptr, len);",
        "#endif\t/* BACK_M */",
        "\t\t}",
        "\t}",
        "\telse",
        "\t{",
        "\t\t/* Video source */",
        "\t\toffs = (ULONG) (src - gvi_pc_low_regen);",
        "\t\tsrc_ptr = get_screen_ptr(offs);",
        "\t\t",
        "\t\t/* Video to video move - both sets of memory are always",
        "\t\t** forwards.",
        "\t\t*/",
        "\t\tif (move_bwds)",
        "\t\t{",
        "\t\t\tdst_ptr += len;",
        "\t\t\tsrc_ptr += len;",
        "\t\t\tfor ( ; len > 0; len--)",
        "\t\t\t\t*(--dst_ptr) = *(--src_ptr);",
        "\t\t}",
        "\t\telse",
        "\t\t\tmemcpy(dst_ptr, src_ptr, len);",
        "\t}",
        "}",
        "",
        "LOCAL MEM_HANDLERS cga_only_handlers =",
        "{",
        "\tcga_only_b_write,",
        "\tcga_only_w_write,",
        "\tcga_only_b_fill,",
        "\tcga_only_w_fill,",
        "\tcga_only_b_move,",
        "\tcga_only_simple_handler\t\t/* word move - not used? */",
        "};",
        ""
      ],
      "current": [
        "#error Unsupported excluded CGA-only configuration"
      ]
