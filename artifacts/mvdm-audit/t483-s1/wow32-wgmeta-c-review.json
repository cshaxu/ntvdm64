        "    ULONG ul = 0;",
        "    register PGETMETAFILEBITS16 parg16;",
        "",
        "    GETARGPTR(pFrame, sizeof(GETMETAFILEBITS16), parg16);",
        "",
        "    if (GlobalLock16(parg16->f1,NULL))",
        "    {",
        "        GlobalUnlock16(parg16->f1);",
        "        ul = parg16->f1;",
        "    }",
        "",
        "    FREEARGPTR(parg16);",
        "    RETURN(ul);",
        "}",
        "",
        "ULONG FASTCALL WG32SetMetaFileBits(PVDMFRAME pFrame)",
        "{",
        "    ULONG ul;",
