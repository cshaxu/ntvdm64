        "{",
        "    ULONG AddrBopTable, IretBopSize;",
        "",
        "    ASSERT(line <= 15);",
        "",
        "    if (!(iretHookMask & (1 << line))) {",
        "        return 0;",
        "        }",
        "",
        "    if (getMSW() & 1) {",
        "\tAddrBopTable = (VDM_PM_IRETBOPSEG << 16) | VDM_PM_IRETBOPOFF;",
        "\tIretBopSize = VDM_PM_IRETBOPSIZE;",
        "    }",
        "    else {",
        "\tAddrBopTable = AddrIretBopTable;",
        "\tIretBopSize = VDM_RM_IRETBOPSIZE;",
        "    }",
        "    return AddrBopTable + IretBopSize * line;",
        "",
        "}"
