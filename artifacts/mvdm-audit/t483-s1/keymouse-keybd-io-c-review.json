        "",
        "LOCAL VOID PutInBufferFunc IFN2(half_word, s, half_word, v)",
        "{",
        "\tword\tbuffer_head, buffer_tail, buffer_ptr;",
        "",
        "\tbuffer_tail = sas_w_at_no_check(BIOS_KB_BUFFER_TAIL);",
        "\tbuffer_head = sas_w_at_no_check(BIOS_KB_BUFFER_HEAD);",
        "\tbuffer_ptr = inc_buffer_ptr(/* from: */buffer_tail);",
        "",
        "\tif (buffer_ptr == buffer_head) {",
        "\t\tBEEP(\"BIOS keyboard buffer overflow\");",
        "\t}",
        "\telse {",
        "\t\tsas_store_no_check(BIOS_VAR_START + buffer_tail, v);",
        "\t\tsas_store_no_check(BIOS_VAR_START + buffer_tail+1, s);",
        "\t\tsas_storew_no_check(BIOS_KB_BUFFER_TAIL, buffer_ptr);",
        "",
        "\t\toutb(0x20, 0x20);",
        "\t\tsetAX(0x9102);",
        "\t\tINT15();",
        "",
        "\t\toutb(KEYBA_STATUS_CMD, ENA_KBD);",
        "\t\tsas_store (kb_flag_3, sas_hw_at(kb_flag_3) & ~(LC_E0 + LC_E1));",
        "\t\tsetIF(0);",
        "\t}",
        "",
        "\texit_from_kbd_int();",
        "}",
        "",
        ""
      ],
