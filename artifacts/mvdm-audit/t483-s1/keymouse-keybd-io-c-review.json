    {
      "original_start": 1535,
      "original_count": 306,
      "current_start": 1495,
      "current_count": 1,
      "original": [
        "void keyboard_io()",
        "{",
        "    /*",
        "     * Request to keyboard.  The AH register holds the type of request:",
        "     *",
        "     * AH == 0          Read an character from the queue - wait if no",
        "     *                  character available.  Return character in AL",
        "     *                  and the scan code in AH.",
        "     *",
        "     * AH == 1          Determine if there is a character in the queue.",
        "     *                  Set ZF = 0 if there is a character and return",
        "     *                  it in AX (but leave it in the queue).",
        "     *",
        "     * AH == 2          Return shift state in AL.",
        "     *",
        "     * For AH = 0 to 2, the value returned in AH is zero. This correction",
        "     * made in r2.69.",
        "     *",
        "     * NB : The order of reference/increment of buffer_head is critical to",
        "     *      ensure we do not upset put_in_buffer().",
        "     *",
        "     *",
        "     * XT-SFD BIOS Extended functions:",
        "     *",
        "     * AH == 5          Place ASCII char/scan code pair (CL / CH)",
        "     *                  into tail of keyboard buffer. Return 0 in",
        "     *                  AL if successful, 1 if buffer already full.",
        "     *",
        "     * AH == 0x10       Extended read for enhanced keyboard.",
        "     *",
        "     * AH == 0x11       Extended function 1 for enhanced keyboard.",
        "     *",
        "     * AH == 0x12       Extended shift status. AL contains kb_flag,",
        "     *                  AH has bits for left/right Alt and Ctrl keys",
        "     *                  from kb_flag_1 and kb_flag_3.",
        "     */",
        "    word \tbuffer_head,\t/* local copy of BIOS data area variable*/",
        "    \t\tbuffer_tail,\t/* local copy of BIOS data area variable*/",
        "\t\tbuffer_ptr;\t/* pointer into BIOS keyboard buffer    */",
        "",
        "#define INT16H_DEC  0x12    /* AH decremented by this if invalid command */",
        "",
        "    word \tCS_save,\t/* CS before recursive CPU call\t\t*/",
        "    \t\tIP_save;\t/* IP before recursive CPU call\t\t*/",
        "    half_word\tdata,\t\t/* byte conyaining typamatic data\t*/",
        "\t\tstatus1,\t/* temp variables used for storing\t*/",
        "\t\tstatus2;\t/* status in funtion 0x12\t\t*/",
        "",
        "    INT\t\tfunc_index;     /* func_index == AH */",
        "",
        "",
        "    setZF(0);",
        "    func_index = (INT)getAH();",
        "",
        "    note_trace1( BIOS_KB_VERBOSE, \"Keyboard BIOS func 0x%x\", func_index);",
        "",
        "",
        "    switch (func_index) {",
        "",
        "    case  0x00:\t\t\t/* Read next char in Kbd buffer */",
        "",
        "\t/*",
        "\t * The AT emulation of the BIOS uses a recursive CPU to handle",
        "\t * the HW interrrupts, so there is no need to set the Zero Flag",
        "\t * and return to our CPU (see original xt version )",
        "\t */",
        "        buffer_head = sas_w_at_no_check(BIOS_KB_BUFFER_HEAD);",
        "        buffer_tail = sas_w_at_no_check(BIOS_KB_BUFFER_TAIL);",
        "",
        "\tif (buffer_tail == buffer_head)",
        "\t{",
        "\t\tIDLE_waitio();",
        "",
        "\t\tsetAX(0x9002);",
        "\t\tINT15();\t/* call int 15h  - wait function\t*/",
        "\t}",
        "",
        "\tdo",
        "\t{",
        "\t\tcheck_indicators(0);\t/* see if LED's need updating\t*/",
        "",
        "\t\tbuffer_head = sas_w_at_no_check(BIOS_KB_BUFFER_HEAD);",
        "\t\tbuffer_tail = sas_w_at_no_check(BIOS_KB_BUFFER_TAIL);",
        "",
        "\t\tif (buffer_tail == buffer_head)",
        "\t\t{",
        "\t\t\tCS_save = getCS();",
        "\t\t\tIP_save = getIP();",
        "",
        "\t\t\t/* wait for character in buffer\t\t*/",
        "",
        "        \t\tdo {",
        "\t\t\t\tIDLE_poll();",
        "",
        "\t       \t\t\tsetCS(rcpu_poll_segment);",
        "\t       \t\t\tsetIP(rcpu_poll_offset);",
        "                                host_simulate();",
        "\t\t\t\tbuffer_head = sas_w_at_no_check(BIOS_KB_BUFFER_HEAD);",
        "\t\t\t\tbuffer_tail = sas_w_at_no_check(BIOS_KB_BUFFER_TAIL);",
        "",
        "\t\t       \t} while (buffer_tail == buffer_head);",
        "",
        "",
        "\t\t       \tsetCS(CS_save);",
        "\t\t       \tsetIP(IP_save);",
        "\t\t}",
        "",
        "\t       \tsetAX(sas_w_at_no_check(BIOS_VAR_START + buffer_head));",
        "",
        "        \tbuffer_head = inc_buffer_ptr(/* from: */buffer_head);",
        "\t        sas_storew_no_check(BIOS_KB_BUFFER_HEAD, buffer_head);",
        "",
        "\t\ttranslate_std();\t/*translate scan_code pairs\t\t\t*/",
        "\t}",
        "\twhile (getCF());\t\t/* if CF set throw code away and start again\t*/",
        "",
        "\tsetIF(1);",
        "",
        "\tIDLE_init();",
        "",
        "\tbreak;",
        "",
        "",
        "    case 0x01:\t\t\t\t/* Set ZF to reflect char availability in Kbd buffer */",
        "",
        "\tdo",
        "\t{",
        "\t\tcheck_indicators(1);\t\t/* see if LED's need updating\t\t*/",
        "\t\t\t\t\t\t/* and issue an   out 20h,20h\t\t*/",
        "",
        "\t\tbuffer_head = sas_w_at_no_check(BIOS_KB_BUFFER_HEAD);",
        "\t\tbuffer_tail = sas_w_at_no_check(BIOS_KB_BUFFER_TAIL);",
        "",
        "\t       \tsetAX(sas_w_at_no_check(BIOS_VAR_START + buffer_head));",
        "",
        "\t\tif (buffer_tail == buffer_head)",
        "\t\t{",
        "\t\t\t/* buffer empty - set flag and return */",
        "\t\t\tIDLE_poll();",
        "",
        "\t\t\tsetZF(1);",
        "\t\t\tbreak;",
        "\t\t}",
        "\t\telse",
        "\t\t\tIDLE_init();",
        "",
        "\t\ttranslate_std();\t/* translate scan_code pairs, returns CF if throwaway */",
        "\t\tif(getCF())",
        "\t\t{",
        "\t\t\t/* throw code away by incrementing pointer\t*/",
        "\t        \tbuffer_head = inc_buffer_ptr(/* from: */buffer_head);",
        "\t\t        sas_storew_no_check(BIOS_KB_BUFFER_HEAD, buffer_head);",
        "\t\t}",
        "\t}",
        "\twhile (getCF());\t\t/* if CF set -  start again\t*/",
        "\tsetIF(1);",
        "",
        "\tbreak;",
        "",
        "",
        "    case 0x02:\t\t\t\t/* AL := Current Shift Status (really \"kb_flag\") */",
        "",
        "        setAH(0);",
        "        setAL(sas_hw_at_no_check(kb_flag));",
        "",
        "\tbreak;",
        "",
        "",
        "    case 0x03:\t\t\t\t/* Alter typematic rate */",
        "",
