        "        setAH( status1 );",
        "        setAL( sas_hw_at_no_check(kb_flag) );",
        "",
        "\tbreak;",
        "",
        "",
        "    default:",
        "        setAH((func_index - INT16H_DEC));",
        "\tbreak;",
        "    }",
        "}"
