        "\ttranslate_ext();\t\t/* translate scan_code pairs\t*/",
        "",
        "\tsetIF(1);",
        "\tbreak;",
        "",
        "",
        "    case 0x11:\t\t\t\t/* Extended ASCII Status\t*/",
        "",
        "\tcheck_indicators(1);\t\t/* see if LED's need updating\t*/",
        "\t\t\t\t\t/* and issue an   out 20h,20h\t*/",
        "",
        "\tbuffer_head = sas_w_at_no_check(BIOS_KB_BUFFER_HEAD);",
