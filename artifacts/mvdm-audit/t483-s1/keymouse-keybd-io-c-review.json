        "\t\t\tbuffer_head = sas_w_at_no_check(BIOS_KB_BUFFER_HEAD);",
        "\t\t\tbuffer_tail = sas_w_at_no_check(BIOS_KB_BUFFER_TAIL);",
        "\t       \t}",
        "",
        "\t\tIDLE_init();",
        "",
        "\t       \tsetCS(CS_save);",
        "\t       \tsetIP(IP_save);",
        "\t}",
        "",
        "\tsetAX(sas_w_at_no_check(BIOS_VAR_START + buffer_head));\t/* Pickup the \"current\" scancode/char pair */",
        "",
        "       \tbuffer_head = inc_buffer_ptr(/* from: */buffer_head);",
        "        sas_storew_no_check(BIOS_KB_BUFFER_HEAD, buffer_head);",
