      "current_count": 1,
      "original": [
        "",
        "GLOBAL VOID\tvga_ipstat1_inb IFN2(io_addr,port,half_word *,value)",
        "{",
        "",
        "\t/*",
        "\t * The whole of this routine has been nicked from the cga without modification",
        "\t * The s_lengths array should probably be altered for the ega timings, and somewhere",
        "\t * an interrupt should be fired off.",
        "\t */",
        "",
        "\tSAVED TINY sub_state = 0;\t/* sub state for ega state 2 */",
        "",
        "     SAVED ULONG gmfudge = 17; /* Random number seed for pseudo-random",
        "\t\t\t\t\t\tbitstream generator to give the state",
        "\t\t\t\t\t\tlengths below that 'genuine' feel to",
        "\t\t\t\t\t\tprogs that require it! */",
        "     FAST ULONG h;",
        "",
        "    /*",
        "     * relative 'lengths' of each state. State 2 is *3 as it has 3 sub states",
        "     */",
        "",
        "\tSAVED TINY s_lengths[] = { 8, 18, 8, 6 };",
        "",
        "",
        "#ifdef PROD",
        "\tUNUSED(port);",
        "#endif",
        "    note_entrance2(\"vga_ipstat1_inb(%x,%x)\", port, value);",
        "",
        "#ifdef V7VGA",
        "\tattribute_controller.address.as_bfld.index_state = 0;",
        "#else",
        "    set_index_state();\t/* Initialize the Attribute register flip-flop (EGA tech ref, p 56) */",
        "#endif /* V7VGA */",
        "",
        "    vga_ip0_state_count --;\t/* attempt relative 'timings' */",
        "    switch (vga_ip0_state) {",
        "",
        "    case 0:",
        "\tif (vga_ip0_state_count == 0) {\t/* change to next state ? */",
        "            h = gmfudge << 1;",
        "            gmfudge = (h&0x80000000) ^ (gmfudge & 0x80000000)? h|1 : h;",
        "\t    vga_ip0_state_count = s_lengths[1] + (gmfudge & 3);",
        "\t    vga_ip0_state = 1;",
        "\t}",
        "\tinput_status_register_zero.as_bfld.crt_interrupt = 0;\t/* = !VS */",
        "\t*value = 0x05;",
        "\tbreak;",
        "",
        "    case 1:",
        "\tif (vga_ip0_state_count == 0) {\t/* change to next state ? */",
        "            h = gmfudge << 1;",
        "            gmfudge = (h&0x80000000) ^ (gmfudge & 0x80000000)? h|1 : h;",
        "\t    vga_ip0_state_count = s_lengths[2] + (gmfudge & 3);",
        "\t    vga_ip0_state = 2;",
        "\t    sub_state = 2;",
        "\t}",
        "\tswitch (sub_state) {\t/* cycle through 0,0,1 sequence */",
        "\tcase 0:\t\t/* to represent DE toggling */",
        "\t    *value = 0x04;",
        "\t    sub_state = 1;",
        "\t    break;",
        "\tcase 1:",
        "\t    *value = 0x04;",
        "\t    sub_state = 2;",
        "\t    break;",
        "\tcase 2:",
        "\t    *value = 0x05;",
        "\t    sub_state = 0;",
        "\t    break;",
        "        }",
        "\tinput_status_register_zero.as_bfld.crt_interrupt = 0;\t/* = !VS */",
        "\tbreak;",
        "",
        "    case 2:",
        "\tif (vga_ip0_state_count == 0) {\t/* change to next state ? */",
        "            h = gmfudge << 1;",
        "            gmfudge = (h&0x80000000) ^ (gmfudge & 0x80000000)? h|1 : h;",
        "\t    vga_ip0_state_count = s_lengths[3] + (gmfudge & 3);",
        "\t    vga_ip0_state = 3;",
        "\t}",
        "\t*value = 0x05;",
        "\tinput_status_register_zero.as_bfld.crt_interrupt = 0;\t/* = !VS */",
        "\tbreak;",
        "",
        "    case 3:",
        "\tif (vga_ip0_state_count == 0) {\t/* wrap back to first state */",
        "            h = gmfudge << 1;",
        "            gmfudge = (h&0x80000000) ^ (gmfudge & 0x80000000)? h|1 : h;",
        "\t    vga_ip0_state_count = s_lengths[0] + (gmfudge & 3);",
        "\t    vga_ip0_state = 0;",
        "\t}",
        "\tinput_status_register_zero.as_bfld.crt_interrupt = 1;\t/* = !VS */",
        "\t*value = 0x0d;",
        "\tbreak;",
        "    }",
        "    note_entrance1(\"returning %x\",*value);",
        "}",
        ""
      ],
      "current": [
        "#error Unsupported excluded original configuration"
      ]
