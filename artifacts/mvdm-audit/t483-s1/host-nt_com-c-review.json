      "original": [
        "GLOBAL CPU UTINY host_com_read_char( int adapter, FIFORXDATA * buffer, UTINY count)",
        "{",
        "    CURRENT_ADAPTER();",
        "    UCHAR host_error;",
        "    RXBUFCHARTYPE CharType;",
        "    UTINY RetCount = count;",
        "   /* if xoff is in progress, don't read nothing */",
        "   if (!current->XOFFInProgress) {",
        "\twhile (count) {",
        "\t    CharType = GetCharacterTypeInBuffer(current);",
        "\t    if (CharType == RXCHAR || CharType == CHARINERROR) {",
        "\t\tbuffer->error = 0;",
        "\t\tGetCharFromRXBuffer(current, CharType, &buffer->data, &host_error);",
        "\t\tif (!host_error)",
        "\t\t    buffer->error = MapHostToBaseError(host_error);",
        "\t\tbuffer++;",
        "\t\tcount--;",
        "\t    }",
        "\t    else",
        "\t\tbreak;",
        "\t}",
        "    }",
        "      /* Tell comms idle system that there has been comms activity */",
        "    IDLE_comlpt();",
        "    current->SuspendTickCounter = current->SuspendTimeoutTicks;",
        "    return (RetCount - count);",
        "",
        "}",
        "GLOBAL CPU void host_com_fifo_char_read(int adapter)",
        "{",
        "    CURRENT_ADAPTER();",
        "    current->CharReadFromUART = TRUE;",
        "}"
      ],
      "current": [
        "#error DIVERGENCE MVDM-HOST-DIV-525: FIFO_ON platform branch is not selected; see mirror register."
      ]
