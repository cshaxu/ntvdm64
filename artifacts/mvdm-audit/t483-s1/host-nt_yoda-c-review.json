        "",
        "/******INCLUDES**********/",
        "#include <stdio.h>",
        "#include \"xt.h\"",
        "#include CpuH",
        "#include \"hunter.h\"",
        "#include \"nt_getXX.h\"",
        "",
        "/******DEFINES***********/",
        "#define EXPORT",
        "",
        "/* Get the size of a table. */",
        "#define sizeoftable(tab)\t(sizeof(tab)/sizeof(tab[0]))",
        "",
        "/* Different types of CALL instruction. */",
        "#define CT_IMM\t0",
        "#define CT_EA\t1",
        "#define CT_REG\t2",
        "",
        "/* Mod-rm table flags. */",
        "#define MR_BX\t0x01",
        "#define MR_BP\t0x02",
        "#define MR_SI\t0x04",
        "#define MR_DI\t0x08",
        "#define MR_D8\t0x10",
        "#define MR_D16\t0x20",
        "",
        "/* Segment defines, correspond to entries in get_seg table. */",
        "#define NO_OVERRIDE\t(-1)",
        "#define SEG_ES\t\t(0)",
        "#define SEG_CS\t\t(1)",
        "#define SEG_SS\t\t(2)",
        "#define SEG_DS\t\t(3)",
        "",
        "/* Maximum size of the call stack. */",
        "#define MAX_CALL_STACK\t128",
        "",
        "/******TYPEDEFS**********/",
        "",
        "/* Effective address call type additional data. */",
        "typedef\tstruct",
        "{",
        "    word\tseg;\t\t/* The segment of the effective address. */",
        "    word\toff;\t\t/* The offset of the effective address. */",
        "    sys_addr\taddr;\t\t/* 20-bit effective address. */",
        "    IS8\t\tseg_override;\t/* Segment override if any. */",
        "    IBOOL\tdisp_present;\t/* Is there a displacement present? */",
        "    word\tdisp;\t\t/* The value of the displacement.*/",
        "    IU8\t\tmodrm_index;\t/* Index into mod-rm look-up tables. */",
        "} CALL_EA_DATA;",
        "",
        "/* Register call type additional data. */",
        "typedef IU8 CALL_REG_DATA;      /* Index into register look-up tables. */",
        "",
        "/* Data structure which holds call stack entries. */",
        "typedef struct",
        "{",
        "    IU8\t\ttype;\t\t/* CALL instruction type one of",
        "\t\t\t\t\tCT_IMM - immediate",
        "\t\t\t\t\tCT_EA  - effective address in mod-rm",
        "\t\t\t\t\tCT_REG - register in mod-rm. */",
        "    word\tcs;\t\t/* Code segment of call instruction. */",
        "    word\tip;\t\t/* Instruction pointer of call instruction. */",
        "    sys_addr\tinst_addr;\t/* 20-bit address of call instruction. */",
        "    IU8\t\tnbytes;\t\t/* Length of op-code. */",
        "    IU8\t\topcode[5];\t/* Op-code bytes. */",
        "    IBOOL\tcfar;\t\t/* Is it a far CALL? */",
        "    word\tseg;\t\t/* Target segment for CALL. */",
        "    word\toff;\t\t/* Target offset for CALL. */",
        "    word\tss;\t\t/* Stack segment when call is executed. */",
        "    word\tsp;\t\t/* Stack offset when call is executed. */",
        "    union",
        "    {",
        "\tCALL_EA_DATA\tea;\t/* EA call specific data. */",
        "\tCALL_REG_DATA\tregind;\t/* Register call specific data. */",
        "    } extra;",
        "} CALL_STACK_ENTRY;",
        "",
        "/******IMPORTS***********/",
        "extern struct HOST_COM host_com[];",
        "extern struct HOST_LPT host_lpt[];",
        "extern char *nt_fgets(char *buffer, int len, void *input_stream);",
        "extern char *nt_gets(char *buffer);",
        "extern int vader;",
        "",
        "/******LOCAL FUNCTIONS********/",
        "LOCAL int do_ecbt\tIPT5(char *, str, char *, com, long, cs,",
        "\t\t\t     long, ip, long, len);",
        "LOCAL int do_dcbt\tIPT5(char *, str, char *, com, long, cs,",
        "\t\t\t     long, ip, long, len);",
        "LOCAL int do_pcbt\tIPT5(char *, str, char *, com, long, cs,",
        "\t\t\t     long, ip, long, len);",
        "LOCAL void check_stack\tIPT2(word, ss, word, sp);",
        "LOCAL int check_for_overflow\tIPT0();",
        "LOCAL void get_ea_from_modrm\tIPT4(CALL_STACK_ENTRY *, cs_ptr,",
        "\t\t\t\t     IU8, mod,",
        "\t\t\t\t     IU8, rm,",
        "\t\t\t\t     sys_addr, op_addr);",
        "LOCAL IS8 do_prefixes\tIPT1(sys_addr *, opcode_ptr);",
        "LOCAL int do_ntsd\tIPT5(char *, str, char *, com, long, cs,",
        "\t\t\t     long, ip, long, len);",
        "",
        "/******LOCAL VARS********/",
        "",
        "/* Table of host yoda commands. */",
        "LOCAL struct                                                                   ",
        "{                                                                               ",
        "\tchar *name;",
        "\tint (*function)\tIPT5(char *, str, char *, com, long, cs,",
        "\t\t\t     long, ip, long, len);",
        "\tchar *comment;",
        "} host_yoda_command[] =",
        "{",
        "{ \"ecbt\", do_ecbt,\t\"                        - enable call-back-tracing\" },",
        "{ \"dcbt\", do_dcbt,\t\"                        - disable call-back-tracing\" },",
        "{ \"pcbt\", do_pcbt,\t\"                        - print call-back-trace\" },",
        "{ \"ntsd\", do_ntsd,\t\"                        - break to ntsd\" }",
        "};",
        "",
        "/* Variable to enable call-back-tracing. */",
        "LOCAL IBOOL call_back_tracing_enabled = FALSE;",
        "",
        "/* Mod-rm byte effective address look-up table. */",
        "LOCAL IU8 EA_table[] =",
        "{",
        "    MR_BX | MR_SI,",
        "    MR_BX | MR_DI,",
        "    MR_BP | MR_SI,",
        "    MR_BP | MR_DI,",
        "    MR_SI,",
        "    MR_DI,",
        "    MR_D16,",
        "    MR_BX,",
        "    MR_BX | MR_SI | MR_D8,",
        "    MR_BX | MR_DI | MR_D8,",
        "    MR_BP | MR_SI | MR_D8,",
        "    MR_BP | MR_DI | MR_D8,",
        "    MR_SI | MR_D8,",
        "    MR_DI | MR_D8,",
        "    MR_BP | MR_D8,",
        "    MR_BX | MR_D8,",
        "    MR_BX | MR_SI | MR_D16,",
        "    MR_BX | MR_DI | MR_D16,",
        "    MR_BP | MR_SI | MR_D16,",
        "    MR_BP | MR_DI | MR_D16,",
        "    MR_SI | MR_D16,",
        "    MR_DI | MR_D16,",
        "    MR_BP | MR_D16,",
        "    MR_BX | MR_D16",
        "};",
        "",
        "/* Mod-rm byte string look-up table. */",
        "LOCAL CHAR *EA_strings[] =",
        "{",
        "    \"[BX + SI]\",",
        "    \"[BX + DI]\",",
        "    \"[BP + SI]\",",
        "    \"[BP + DI]\",",
        "    \"[SI]\",",
        "    \"[DI]\",",
        "    \"[%hX]\",",
        "    \"[BX]\",",
        "    \"[BX + SI + %hX]\",",
        "    \"[BX + DI + %hX]\",",
        "    \"[BP + SI + %hX]\",",
        "    \"[BP + DI + %hX]\",",
        "    \"[SI + %hX]\",",
        "    \"[DI + %hX]\",",
        "    \"[BP + %hX]\",",
        "    \"[BX + %hX]\",",
        "    \"[BX + SI + %hX]\",",
        "    \"[BX + DI + %hX]\",",
        "    \"[BP + SI + %hX]\",",
        "    \"[BP + DI + %hX]\",",
        "    \"[SI + %hX]\",",
        "    \"[DI + %hX]\",",
        "    \"[BP + %hX]\",",
        "    \"[BX + %hX]\"",
        "};",
        "",
        "/* Table of functions corresponding to register rm fields. */",
        "LOCAL word (*EA_reg_func[])() =",
        "{",
        "    getAX,",
        "    getCX,",
        "    getDX,",
        "    getBX,",
        "    getSP,",
        "    getBP,",
        "    getSI,",
        "    getDI",
        "};",
        "",
        "/* Table of names of register rm fields. */",
        "LOCAL CHAR *EA_reg_strings[] =",
        "{",
        "    \"AX\",",
        "    \"CX\",",
        "    \"DX\",",
        "    \"BX\",",
        "    \"SP\",",
        "    \"BP\",",
        "    \"SI\",",
        "    \"DI\"",
        "};",
        "",
        "/* Table of functions for getting segment values. */",
        "LOCAL word (*get_seg[])() =",
        "{",
        "    getES,",
        "    getCS,",
        "    getSS,",
        "    getDS",
        "};",
        "",
        "/* Table of segment names. */",
        "LOCAL CHAR *seg_strings[] =",
        "{",
        "    \"ES\",",
        "    \"CS\",",
        "    \"SS\",",
        "    \"DS\"",
        "};",
        "",
        "LOCAL CALL_STACK_ENTRY call_stack[MAX_CALL_STACK];",
        "LOCAL CALL_STACK_ENTRY *call_next_free = call_stack;",
        "",
        "/******EXPORT VARS*******/",
        "",
        "#ifndef PROD",
        "#ifdef HUNTER",
        "/*============================================================",
        "",
        "Function :   trap_command.",
        "",
        "Purpose  :   Writes the current trapper prompt and gets the",
        "             menu input.",
        "",
        "input    :   a pointer to a string for the current trapper prompt",
        "         :   a pointer to a character to hold the user input.",
        "",
        "returns  :   nothing.",
        "",
        "=============================================================*/",
        "",
        "void trap_command(char *str,char *ch)",
        "{",
        "char inp[80];",
        "",
        "printf(\"%s> \",str);",
        "nt_fgets(inp,80,stdin);",
        "sscanf(inp,\"%c\",ch);",
        "}",
        "#endif /* HUNTER */",
        "",
        "/*",
        "=========================================================================",
        "",
        "FUNCTION        : host_force_yoda_extensions",
        "",
        "PURPOSE         : this function is called whenever the main code of",
        "                  YODA in the base fails to recognise an instruction",
        "                  in order for host-specific commands to be implemented.",
        "",
        "RETURNED STATUS :",
        "",
        "NOTES           : on the SG port no extensions are provided.",
        "",
        "=======================================================================",
        "*/",
        "",
        "GLOBAL int host_force_yoda_extensions(char *com, long cs, long ip, long len, ",
        "\t\t\t\t\tchar *str)",
        "{",
        "#ifdef HUNTER",
        "int  quit_menus=FALSE;   /* some functions need to return to yoda prompt*/",
        "char c;",
        "char menu[] = \"\\tTrapper [m]ain menu\\n\"",
        "              \"\\tTrapper [e]rror menu\\n\"",
        "              \"\\t[Q]uit\\n\"",
        "              \"\\t? for this menu\\n\\n\";",
        "#endif /* HUNTER */",
        "    int\ti,",
        "\tretvalue;",
        "",
        "#ifdef HUNTER",
        "/* to get to this menu, the user has to type \"trap\" at the Yoda prompt */",
        "",
        "if(!strcmp(com,\"trap\")) /* test the input string */",
        "   {",
        "   printf(\"\\nYODA EXTENSIONS\\n\\n\");",
        "   printf(\"%s\",menu);",
        "   do",
        "      {",
        "      trap_command(\"trapper\",&c);",
        "      switch(c)",
        "         {",
        "         case 'm':",
        "         case 'M':",
        "            quit_menus = host_do_trapper_main_menu();",
        "         break;",
        "",
        "         case 'e':",
        "         case 'E':",
        "            quit_menus = host_do_trapper_error_menu();",
        "         break;",
        "",
        "         case '?':",
        "            printf(\"%s\",menu);",
        "         break;",
        "",
        "         default:",
        "         break;",
        "         }",
        "      }",
        "   while(c != 'q' && c != 'Q' && quit_menus == FALSE );",
        "",
        "   }",
        "else",
        "   {",
        "   /* unpleasing input, so return 1 and back to main Yoda stuff */",
        "   return(1);",
        "   }",
        "return(0);",
        "#endif /* HUNTER */",
        "",
        "    /* Check to see if we have got a command in host_yoda_command. */",
        "    retvalue = 1;",
        "    for (i = 0; i < sizeoftable(host_yoda_command); i++)",
        "    {",
        "\tif (strcmp(com, host_yoda_command[i].name) == 0)",
        "\t{",
        "\t    retvalue = (*host_yoda_command[i].function)(str, com, cs, ip, len);",
        "\t    break;",
        "\t}",
        "    }",
        "    return(retvalue);",
        "}",
        "",
        "#ifdef HUNTER",
        "/*============================================================",
        "",
        "Function :   host_do_trapper_main_menu",
        "",
        "Purpose  :   implements the main trapper menu under Yoda.",
        "",
        "",
        "=============================================================*/",
        "",
        "static int host_do_trapper_main_menu()",
        "{",
        "int    i,quit_menus = FALSE;",
        "char   c,str[80],yesno;",
        "USHORT screen_no;",
        "BOOL   compare;",
        "",
        "char menu[] = \"\\t[F]ast forward...\\n\"",
        "              \"\\t[N]ext screen\\n\"",
        "              \"\\t[P]rev screen\\n\"",
        "              \"\\t[S]how screen...\\n\"",
        "              \"\\t[C]ontinue\\n\"",
        "              \"\\t[A]bort\\n\"",
        "              \"\\t[Q]uit\\n\"",
        "              \"\\t? for this menu\\n\\n\";",
        "",
        "",
        "",
        "char continu[] = \"\\n\\ntype 'c' at yoda prompt to continue...\\n\\n\";",
        "",
        "",
        "printf(\"\\nTRAPPER MAIN MENU\\n\\n\");",
        "printf(\"%s\",menu);",
        "",
        "do",
        "   {",
        "   trap_command(\"main\",&c);",
        "   switch(c)",
        "      {",
        "      case 'f': /* fast forward */",
        "      case 'F':",
        "         {",
        "         printf(\"\\n\\nEnter the screen number where comparisons will start: \");",
        "         nt_fgets(str,80,stdin);",
        "         sscanf(str,\"%d\",&screen_no);",
        "         printf(\"\\n\\nSkipping screen comparisons up to screen %d\\n\\n\",screen_no);",
        "         bh_start_screen(screen_no);",
        "         }",
        "      break;",
        "",
        "      case 'n': /* next screen */",
        "      case 'N':",
        "         {",
        "         bh_next_screen();",
        "         printf(\"%s\",continu);",
        "         quit_menus = TRUE;",
        "         }",
        "      break;",
        "",
        "      case 'p': /* previous screen */",
        "      case 'P':",
        "         {",
        "         bh_prev_screen();",
        "         printf(\"%s\",continu);",
        "         quit_menus = TRUE;",
        "         }",
        "      break;",
        "",
        "      case 's': /* show screen */",
        "      case 'S':",
        "         {",
        "         printf(\"\\n\\nEnter the number of the screen which you want to see: \");",
        "         nt_fgets(str,80,stdin);",
        "         sscanf(str,\"%d\",&screen_no);",
        "         printf(\"\\n\\nDo you want to compare screen %d with one from\"",
        "                \"SoftPC? (y/n): \",screen_no);",
        "         nt_fgets(str,80,stdin);",
        "         sscanf(str,\"%c\",&yesno);",
        "         if(yesno == 'y' || yesno == 'Y')",
        "            compare = TRUE;",
        "         else",
        "            compare = FALSE;",
        "",
        "         bh_show_screen(screen_no,compare);",
        "         }",
        "      break;",
        "",
        "      case 'c': /* continue */",
        "      case 'C':",
        "         {",
        "         bh_continue();",
        "         printf(\"%s\",continu);",
        "         quit_menus = TRUE;",
        "         }",
        "      break;",
        "",
        "      case 'a': /* abort */",
        "      case 'A':",
        "         bh_abort();",
        "      break;",
        "",
        "      case '?':",
        "         printf(\"%s\",menu);",
        "      break;",
        "",
        "      default:",
        "      break;",
        "      }",
        "   }",
        "while(c != 'q' && c != 'Q' && quit_menus == FALSE);",
        "return(quit_menus); /* match found */",
        "}",
        "",
        "/*============================================================",
        "",
        "Function :   host_do_trapper_error_menu",
        "",
        "Purpose  :   implements the trapper error menu under Yoda.",
        "",
        "returns  :   TRUE if the user has selected a trapper function",
        "             which requires softpc to be restarted.",
        "             FALSE otherwise.",
        "",
        "=============================================================*/",
        "",
        "static int host_do_trapper_error_menu()",
        "{",
        "int  i,quit_menus=FALSE;",
        "char c;",
        "char menu[] = \"\\t[F]lip screen\\n\"",
        "              \"\\t[N]ext error\\n\"",
        "              \"\\t[P]rev error\\n\"",
        "              \"\\t[A]ll errors\\n\"",
        "              \"\\t[C]lear errors\\n\"",
        "              \"\\t[Q]uit menu\\n\"",
        "              \"\\t? for this menu\\n\\n\";",
        "",
        "",
        "printf(\"\\nTRAPPER ERROR MENU\\n\\n\");",
        "printf(\"%s\",menu);",
        "",
        "do",
        "   {",
        "   trap_command(\"error\",&c);",
        "   switch(c)",
        "      {",
        "      case 'f':",
        "      case 'F':",
        "         bh_flip_screen();",
        "         printf(\"\\n\\ntype 'c' at yoda prompt to continue...\\n\\n\");",
        "         quit_menus = TRUE;",
        "      break;",
        "",
        "      case 'n':",
        "      case 'N':",
        "         bh_next_error();",
        "      break;",
        "",
        "      case 'p':",
        "      case 'P':",
        "         bh_prev_error();",
        "      break;",
        "",
        "      case 'a':",
        "      case 'A':",
        "         bh_all_errors();",
        "      break;",
        "",
        "      case 'c':",
        "      case 'C':",
        "         bh_wipe_errors();",
        "      break;",
        "",
        "      case '?':",
        "         printf(\"%s\",menu);",
        "      break;",
        "",
        "      default:",
        "      break;",
        "      }",
        "   }",
        "while(c != 'q' && c != 'Q' && quit_menus == FALSE);",
        "",
        "if(quit_menus == TRUE)",
        "   return(TRUE); /* need to go to the yoda prompt */",
        "else",
        "   return(FALSE);  /* don't need to go to the yoda prompt */",
        "}",
        "#endif /* HUNTER */",
        "",
        "/*",
        "=========================================================================",
        "",
        "FUNCTION        : host_yoda_check_I_extensions",
        "",
        "PURPOSE         : this function is called by the YODA check_I code",
        "                  in order to provide host specific extensions.",
        "",
        "RETURNED STATUS :",
        "",
        "NOTES           : on the SG port no extensions are provided.",
        "",
        "=======================================================================",
        "*/",
        "",
        "GLOBAL void host_yoda_check_I_extensions()",
        "{",
        "    sys_addr addr;",
        "    word cs,",
        "\t ip,",
        "\t ss,",
        "\t sp;",
        "    IS8 seg_override;",
        "    IU8 opcode,",
        "\tmodrm,",
        "\tmod,",
        "\tn_field,",
        "\trm,",
        "\ti;",
        "",
        "    /* Check to see if call-back-tracing is enabled. */",
        "    if (call_back_tracing_enabled)",
        "    {",
        "",
        "\t/* Check to see if call on top of stack has been popped. */",
        "\tss = getSS();",
        "\tsp = getSP();",
        "\tcheck_stack(ss, sp);",
        "",
        "\t/* Get current op-code. */",
        "\tcs = getCS();",
        "\tip = getIP();",
        "\taddr = effective_addr(cs, ip);",
        "\tseg_override = do_prefixes(&addr);",
        "\topcode = sas_hw_at_no_check(addr);",
        "",
        "\t/* Check to see if we have a call-back-trace op-code. */",
        "\tswitch (opcode)",
        "\t{",
        "\tcase 0x9a:",
        "",
        "\t    /* 9a =  CALLF immediate */",
        "",
        "\t    /* Check there is room for another entry in call_stack. */",
        "\t    if (check_for_overflow() == -1)",
        "\t\treturn;",
        "",
        "\t    /* Fill the stack entry. */",
        "\t    call_next_free->type = CT_IMM;",
        "\t    call_next_free->cs = cs;",
        "\t    call_next_free->ip = ip;",
        "\t    call_next_free->inst_addr = addr;",
        "\t    call_next_free->nbytes = 5;",
        "\t    call_next_free->cfar = TRUE;",
        "\t    call_next_free->seg = sas_w_at_no_check(addr + 3);",
        "\t    call_next_free->off = sas_w_at_no_check(addr + 1);",
        "",
        "\t    /* Save state of stack. */",
        "\t    call_next_free->ss = ss;",
        "\t    call_next_free->sp = sp;",
        "",
        "\t    /* Store instruction bytes. */",
        "\t    for (i = 0; i < 5; i++)",
        "\t\tcall_next_free->opcode[i] = sas_hw_at_no_check(addr++);",
        "",
        "\t    /* Increment top of stack. */",
        "\t    call_next_free++;",
        "\t    break;",
        "\tcase 0xe8:",
        "",
        "\t    /* e8 = CALL immediate */",
        "",
        "\t    /* Check there is room for another entry in call_stack. */",
        "\t    if (check_for_overflow() == -1)",
        "\t\treturn;",
        "",
        "\t    /* Fill the stack entry. */",
        "\t    call_next_free->type = CT_IMM;",
        "\t    call_next_free->cs = cs;",
        "\t    call_next_free->ip = ip;",
        "\t    call_next_free->inst_addr = addr;",
        "\t    call_next_free->nbytes = 3;",
        "\t    call_next_free->cfar = FALSE;",
        "\t    call_next_free->off = ip + (word) 3 + sas_w_at_no_check(addr + 1);",
        "",
        "\t    /* Save state of stack. */",
        "\t    call_next_free->ss = ss;",
        "\t    call_next_free->sp = sp;",
        "",
        "\t    /* Store instruction bytes. */",
        "\t    for (i = 0; i < 3; i++)",
        "\t\tcall_next_free->opcode[i] = sas_hw_at_no_check(addr++);",
        "",
        "\t    /* Increment top of stack. */",
        "\t    call_next_free++;",
        "\t    break;",
        "\tcase 0xff:",
        "",
        "\t    /*",
        "\t     * ff /2 = CALL",
        "\t     * ff /3 = CALLF",
        "\t     */",
        "\t    modrm = sas_hw_at_no_check(addr + 1);",
        "\t    n_field = (modrm & 0x38) >> 3;",
        "\t    if ((n_field == 2) || (n_field == 3))",
        "\t    {",
        "",
        "\t\t/* Check there is room for another entry in call_stack. */",
        "\t\tif (check_for_overflow() == -1)",
        "\t\t    return;",
        "",
        "\t\t/* Save CS:IP of call instruction. */",
        "\t\tcall_next_free->cs = cs;",
        "\t\tcall_next_free->ip = ip;",
        "",
        "\t\t/* Store opcode address and initialise byte count. */",
        "\t\tcall_next_free->inst_addr = addr;",
        "\t\tcall_next_free->nbytes = 2;",
        "\t\t",
        "\t\t/* n-field: 2 = near, 3 = far. */",
        "\t\tcall_next_free->cfar = n_field & 1;",
        "",
        "\t\t/* If mod is 3 we have a register rm otherwise it is EA. */",
        "\t\tmod = (modrm & 0xc0) >> 6;",
        "\t\trm = modrm & 7;",
        "\t\tif (mod == 3)",
        "\t\t{",
        "\t\t    if (call_next_free->cfar)",
        "\t\t    {",
        "",
        "\t\t\t/* Can't have a far pointer in a register. */",
        "\t\t\tprintf(\"Invalid mod-rm byte after ff op-code.\\n\");",
        "\t\t\tvader = 1;",
        "\t\t\treturn;",
        "\t\t    }",
        "\t\t    else",
        "\t\t    {",
        "",
        "\t\t\t/* Near pointer contained in register. */",
        "\t\t\tcall_next_free->type = CT_REG;",
        "\t\t\tcall_next_free->off =",
        "\t\t\t    sas_w_at_no_check((*EA_reg_func[rm])());",
        "\t\t\tcall_next_free->extra.regind = rm;",
        "",
        "\t\t\t/* Save state of stack. */",
        "\t\t\tcall_next_free->ss = ss;",
        "\t\t\tcall_next_free->sp = sp;",
        "\t\t    }",
        "\t\t}",
        "\t\telse",
        "\t\t{",
        "",
        "\t\t    /* We have an EA type CALL. */",
        "\t\t    call_next_free->type = CT_EA;",
        "\t\t    call_next_free->extra.ea.seg_override = seg_override;",
        "",
        "\t\t    /* Adjust address and count for segment override. */",
        "\t\t    if (seg_override != NO_OVERRIDE)",
        "\t\t    {",
        "\t\t\tcall_next_free->inst_addr--;",
        "\t\t\tcall_next_free->nbytes++;",
        "\t\t    }",
        "",
        "\t\t    /* Work out EA from mod-rm. */",
        "\t\t    get_ea_from_modrm(call_next_free, mod, rm, addr + 2);",
        "",
        "\t\t    /* Get target segment and offset from EA. */",
        "\t\t    if (call_next_free->cfar)",
        "\t\t    {",
        "\t\t\tcall_next_free->seg =",
        "\t\t\t    sas_w_at_no_check(call_next_free->extra.ea.addr+2);",
        "",
        "\t\t\t/* Save state of stack. */",
        "\t\t\tcall_next_free->ss = ss;",
        "\t\t\tcall_next_free->sp = sp;",
        "\t\t    }",
        "\t\t    else",
        "\t\t    {",
        "",
        "\t\t\t/* Save state of stack. */",
        "\t\t\tcall_next_free->ss = ss;",
        "\t\t\tcall_next_free->sp = sp;",
        "\t\t    }",
        "\t\t    call_next_free->off =",
        "\t\t\tsas_w_at_no_check(call_next_free->extra.ea.addr);",
        "\t\t}",
        "",
        "\t\t/* Fill in the op-code bytes. */",
        "\t\tfor (i = 0, addr = call_next_free->inst_addr;",
        "\t\t     i < call_next_free->nbytes;",
        "\t\t     i++, addr++)",
        "\t\t{",
        "\t\t    call_next_free->opcode[i] = sas_hw_at_no_check(addr);",
        "\t\t}",
        "",
        "\t\t/* Increment top of stack. */",
        "\t\tcall_next_free++;",
        "\t    }",
        "\t    break;",
        "\tdefault:",
        "",
        "\t    /* Not a call-back-trace opcode so do nothing. */",
        "\t    break;",
        "\t}",
        "    }",
        "}",
        "",
        "/*",
        "=========================================================================",
        "",
        "FUNCTION        : check_stack",
        "",
        "PURPOSE         : Checks to see if the call on the top of the stack has",
        "\t\t  been popped and if so removes it from the top of the",
        "\t\t  call stack.",
        "",
        "RETURNED STATUS : void",
        "",
        "NOTES           : Originally the call stack was popped on RET instructions",
        "\t\t  but this did not work when apps did things like POP",
        "\t\t  followed by JMP. It was therefore decided to check whether",
        "\t\t  the stack had shrunk past the point where a call's return",
        "\t\t  address was stored to see if that call had returned.",
        "",
        "=======================================================================",
        "*/",
        "LOCAL void check_stack IFN2(word, ss, word, sp)",
        "{",
        "    IU32 count = 0;",
        "",
        "    /*",
        "     * Pop the call stack until we have a call whose return address is still",
        "     * on the real stack.",
        "     */",
        "    while ((call_next_free > call_stack) &&",
        "\t   (ss == (call_next_free - 1)->ss) &&",
        "\t   (sp >= (call_next_free - 1)->sp))",
        "    {",
        "\tcall_next_free--;",
        "\tcount++;",
        "    }",
        "",
        "    /* Complain if more than one call gets popped. */",
        "    if (count > 1)",
        "\tprintf(\"Call stack warning - %d calls popped at %04x:%04x\\n\",",
        "\t       count, getCS(), getIP());",
        "}",
        "",
        "/*",
        "=========================================================================",
        "",
        "FUNCTION        : do_prefixes",
        "",
        "PURPOSE         : Skips over all prefix op-codes.",
        "",
        "RETURNED STATUS : Segment override if any.",
        "",
        "NOTES           :",
        "",
        "=======================================================================",
        "*/",
        "LOCAL IS8 do_prefixes IFN1(sys_addr *, opcode_ptr)",
        "{",
        "    half_word opcode;",
        "    IS8 seg_override = NO_OVERRIDE;",
        "",
        "    /* Skip over prefix opcodes. */",
        "    opcode = sas_hw_at_no_check(*opcode_ptr);",
        "    while ((opcode == 0xf2) || (opcode == 0xf3) ||",
        "\t   (opcode == 0x26) || (opcode == 0x2e) ||",
        "\t   (opcode == 0x36) || (opcode == 0x3e))",
        "    {",
        "\tswitch (opcode)",
        "\t{",
        "\tcase 0x26:",
        "\t    seg_override = SEG_ES;",
        "\t    break;",
        "\tcase 0x2e:",
        "\t    seg_override = SEG_CS;",
        "\t    break;",
        "\tcase 0x36:",
        "\t    seg_override = SEG_SS;",
        "\t    break;",
        "\tcase 0x3e:",
        "\t    seg_override = SEG_DS;",
        "\t    break;",
        "\tdefault:",
        "",
        "\t    /* Not sure what f2 and f3 do so do this for the time being. */",
        "\t    seg_override = NO_OVERRIDE;",
        "\t    break;",
        "\t}",
        "\topcode = sas_hw_at_no_check(++(*opcode_ptr));",
        "    }",
        "",
        "    /* (*opcode_ptr) now points at the opcode. */",
        "    return(seg_override);",
        "}",
        "",
        "/*",
        "=========================================================================",
        "",
        "FUNCTION        : check_for_overflow",
        "",
        "PURPOSE         : Checks to see if the stack has overflowed.",
        "",
        "RETURNED STATUS : -1 on failure, 0 on success.",
        "",
        "NOTES           :",
        "",
        "=======================================================================",
        "*/",
        "LOCAL int check_for_overflow IFN0()",
        "{",
        "    if (call_next_free - call_stack >= MAX_CALL_STACK)",
        "    {",
        "\tprintf(\"Call stack overflow.\\n\");",
        "\tvader = 1;",
        "\treturn(-1);",
        "    }",
        "    return(0);",
        "}",
        "",
        "/*",
        "=========================================================================",
        "",
        "FUNCTION        : get_ea_from_modrm",
        "",
        "PURPOSE         : Takes a mod-rm byte and works out the effective",
        "\t\t  address and the target segment and offset.",
        "",
        "RETURNED STATUS : void",
        "",
        "NOTES           :",
        "",
        "=======================================================================",
        "*/",
        "LOCAL void get_ea_from_modrm IFN4(CALL_STACK_ENTRY *,\tcs_ptr,",
        "\t\t\t\t  IU8,\t\t\tmod,",
        "\t\t\t\t  IU8,\t\t\trm,",
        "\t\t\t\t  sys_addr,\t\tdisp_addr)",
        "{",
        "    IS16 offset = 0,",
        "\t disp;",
        "    IS8 seg,",
        "\tseg_override = cs_ptr->extra.ea.seg_override;",
        "    IU8\tflags;",
        "",
        "    /* Get index to table from mod-rm byte. */",
        "    cs_ptr->extra.ea.modrm_index = (mod << 3) | rm;",
        "    flags = EA_table[cs_ptr->extra.ea.modrm_index];",
        "",
        "    /* Use segment override if there is one otherwise default to DS. */",
        "    seg = (seg_override == NO_OVERRIDE) ? SEG_DS : seg_override;",
        "",
        "    /* Add base register value if any. */",
        "    if (flags & MR_BX)",
        "\toffset += getBX();",
        "    else if (flags & MR_BP)",
        "    {",
        "\toffset += getBP();",
        "\tif (seg_override == NO_OVERRIDE)",
        "\t    seg = SEG_SS;",
        "    }",
        "",
        "    /* Add index register value if any. */",
        "    if (flags & MR_SI)",
        "\toffset += getSI();",
        "    else if (flags & MR_DI)",
        "\toffset += getDI();",
        "",
        "    /* Add displacement if any. */",
        "    if (flags & MR_D16)",
        "    {",
        "\tcs_ptr->nbytes += 2;",
        "\tcs_ptr->extra.ea.disp_present = TRUE;",
        "\tcs_ptr->extra.ea.disp = (IS16) sas_w_at_no_check(disp_addr);",
        "\toffset += cs_ptr->extra.ea.disp;",
        "    }",
        "    else if (flags & MR_D8)",
        "    {",
        "\tcs_ptr->nbytes++;",
        "\tcs_ptr->extra.ea.disp_present = TRUE;",
        "\tcs_ptr->extra.ea.disp = (IS16) ((IS8) sas_hw_at_no_check(disp_addr));",
        "\toffset += cs_ptr->extra.ea.disp;",
        "    }",
        "    else",
        "\tcs_ptr->extra.ea.disp_present = FALSE;",
        "",
        "    /* Store segment and offset of return address. */",
        "    cs_ptr->extra.ea.seg = (*get_seg[seg])();",
        "    cs_ptr->extra.ea.off = (word) offset;",
        "    cs_ptr->extra.ea.addr = effective_addr(cs_ptr->extra.ea.seg,",
        "\t\t\t\t\t   cs_ptr->extra.ea.off);",
        "}",
        "",
        "/*",
        "=========================================================================",
        "",
        "FUNCTION        : host_yoda_help_extensions",
