        "/*",
        "=========================================================================",
        "",
        "FUNCTION        : do_ecbt",
        "",
        "PURPOSE         : this function enables call-back-tracing.",
        "",
        "RETURNED STATUS : 0 for success, 1 for failure",
        "",
        "NOTES           :",
        "",
        "=======================================================================",
        "*/",
        "LOCAL int do_ecbt\tIPT5(char *, str, char *, com, long, cs,",
        "\t\t\t     long, ip, long, len)",
        "{",
        "",
        "    /* Enable call-back-tracing if it is currently disabled. */",
        "    if (!call_back_tracing_enabled)",
        "    {",
        "\tprintf(\"Call back tracing enabled.\\n\");",
        "\tcall_back_tracing_enabled = TRUE;",
        "    }",
        "    return(0);",
        "}",
        "",
        "/*",
        "=========================================================================",
        "",
        "FUNCTION        : do_dcbt",
        "",
        "PURPOSE         : this function disables call-back-tracing.",
        "",
        "RETURNED STATUS : 0 for success, 1 for failure",
        "",
        "NOTES           :",
        "",
        "=======================================================================",
        "*/",
        "LOCAL int do_dcbt\tIPT5(char *, str, char *, com, long, cs,",
        "\t\t\t     long, ip, long, len)",
        "{",
        "",
        "    /* Disable call-back-tracing if it is currently enabled. */",
        "    if (call_back_tracing_enabled)",
        "    {",
        "",
        "\t/* Disable tracing. */",
        "\tprintf(\"Call back tracing disabled.\\n\");",
        "\tcall_back_tracing_enabled = FALSE;",
        "",
        "\t/* Reset the stack. */",
        "\tcall_next_free = call_stack;",
        "    }",
        "    return(0);",
        "}",
        "",
        "/*",
        "=========================================================================",
        "",
        "FUNCTION        : do_pcbt",
        "",
        "PURPOSE         : this function prints the call-back-trace stack.",
        "",
        "RETURNED STATUS : 0 for success, 1 for failure",
        "",
        "NOTES           :",
        "",
        "=======================================================================",
        "*/",
        "LOCAL int do_pcbt\tIPT5(char *, str, char *, com, long, cs,",
        "\t\t\t     long, ip, long, len)",
        "{",
        "    IU8 *opcode,",
        "\t i;",
        "    CALL_STACK_ENTRY *cs_ptr;",
        "",
        "    /* Print out the current call-back-trace stack. */",
        "    for (cs_ptr = call_stack; cs_ptr < call_next_free; cs_ptr++)",
        "    {",
        "",
        "\t/* Print address and op-code. */",
        "\tprintf(\"%04X:%04X\", cs_ptr->cs, cs_ptr->ip);",
        "\topcode = cs_ptr->opcode;",
        "\tfor (i = 0; i < cs_ptr->nbytes; i++)",
        "\t    printf(\" %02X\", *opcode++);",
        "",
        "\t/* Print mnemonic. */",
        "\tprintf(\"\\tCALL\");",
        "\tif (cs_ptr->cfar)",
        "\t    printf(\"F\");",
        "\tprintf(\"\\t\");",
        "",
        "\t/* Print parameters. */",
        "\tswitch (cs_ptr->type)",
        "\t{",
        "\tcase CT_IMM:",
        "",
        "\t    /* Immediate. */",
        "\t    if (cs_ptr->cfar)",
        "\t\tprintf(\"%04X:\", cs_ptr->seg);",
        "\t    printf(\"%04X\", cs_ptr->off);",
        "\t    break;",
        "\tcase CT_EA:",
        "",
        "\t    /* Effective address. */",
        "\t    if (cs_ptr->cfar)",
        "\t\tprintf(\"d\");",
        "\t    printf(\"word ptr \");",
        "",
        "\t    /* Print override if there is one. */",
        "\t    if (cs_ptr->extra.ea.seg_override != NO_OVERRIDE)",
        "\t\tprintf(\"%s:\", seg_strings[cs_ptr->extra.ea.seg_override]);",
        "",
        "\t    /* Print parameters. */",
        "\t    if (cs_ptr->extra.ea.disp_present)",
        "\t\tprintf(EA_strings[cs_ptr->extra.ea.modrm_index],",
        "\t\t       cs_ptr->extra.ea.disp);",
        "\t    else",
        "\t\tprintf(EA_strings[cs_ptr->extra.ea.modrm_index]);",
        "",
        "\t    /* Print effective address. */",
        "\t    printf(\"\\t(%04X:%04X\\t\",",
        "\t\t   cs_ptr->extra.ea.seg,",
        "\t\t   cs_ptr->extra.ea.off);",
        "",
        "\t    /* Print contents of effective address. */",
        "\t    if (cs_ptr->cfar)",
        "\t\tprintf(\"%04X:\", cs_ptr->seg);",
        "\t    printf(\"%04X)\", cs_ptr->off);",
        "\t    break;",
        "\tcase CT_REG:",
        "",
        "\t    /* Print parameter and target address. */",
        "\t    printf(EA_reg_strings[cs_ptr->extra.regind]);",
        "\t    printf(\"\\t(%04X)\", cs_ptr->off);",
        "\t    break;",
        "\tdefault:",
        "\t    break;",
        "\t}",
        "\tprintf(\"\\n\");",
        "    }",
        "",
        "    /* Return success. */",
        "    return(0);",
        "}",
