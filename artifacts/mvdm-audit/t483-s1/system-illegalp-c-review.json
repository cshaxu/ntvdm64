      "current_count": 1,
      "original": [
        "\tsys_addr bop_addr;",
        "\tCHAR buf[256];",
        "",
        "\t/* This is called when an Insignia Intel driver decides that",
        "\t * this (old) SoftWindows is not compatible.",
        "\t *",
        "\t * We should:",
        "\t * a) Put up a localised panel complaining that",
        "\t *    the named driver CS:[eIP] with decimal",
        "\t *    version AX is incompatible with the SoftWindows.",
        "\t *    N.B. The most compatible way to pass the",
        "\t *    name of the driver is by embedded bytes just",
        "\t *    after the BOP. The problem is caused by the",
        "\t *    fact that the driver may be either 16-bit RM",
        "\t *    or a 32-bit flat VxD so the address of the",
        "\t *    string can be either 16/32 bits, and we",
        "\t *    need to be able to execute (and do nothing)",
        "\t *    on the shipping SoftPC 1.xx which prevents",
        "\t *    us doing anything with 32-bit registers!",
        "\t *",
        "\t *\tBOP\tdriver_incompat",
        "\t *\tjmp\tSHORT over_name",
        "\t *\tdb\t'somename.drv', 0",
        "\t * over_name:",
        "\t *",
        "\t * b) setCF(0)",
        "\t */",
        "",
        "\tbuf[0] = '\\0';",
        "\tbop_addr = effective_addr(getCS(), GetInstructionPointer());",
        "\tif (sas_hw_at(bop_addr) == 0xEB)",
        "\t{",
        "\t\tIU8 data;",
        "\t\tchar *p;",
        "",
        "\t\tp = buf;",
        "\t\tbop_addr += 2;\t/* Skip the xEB xXX */",
        "\t\tdo {",
        "\t\t\tdata = sas_hw_at(bop_addr++);",
        "\t\t\t*p++ = data;",
        "\t\t} while (data != 0);",
        "\t\tsprintf(p-1, \" v%d.%02d\", getAX() / 100, getAX() % 100);",
        "\t}",
        "\thost_error(EG_DRIVER_MISMATCH, ERR_CONT, buf);",
        "\tsetCF(0);"
      ],
      "current": [
        "#error DIVERGENCE MVDM-HOST-DIV-537: non-NTVDM branch is not selected; see mirror register."
      ]
    },
    {
      "original_start": 191,
      "original_count": 204,
      "current_start": 164,
      "current_count": 1,
      "original": [
        "LOCAL void print_msg IPT1( IU32, ofs );",
        "",
        "void dvr_bop_trace IFN0()",
        "{",
        "\tsys_addr bop_addr;",
        "",
        "\t /*",
        "\t *\tBOP\tdriver_incompat",
        "\t *\tjmp\tSHORT over_name",
        "\t *\tdb\t'somename.drv', 0",
        "\t * over_name:",
        "\t *",
        "\t */",
        "",
        "\tbop_addr = effective_addr(getCS(), GetInstructionPointer());",
        "\tif (sas_hw_at(bop_addr) == 0xEB)",
        "\t{",
        "\t\tprint_msg(bop_addr+2); /* Skip the xEB xXX */",
        "\t}",
        "}",
        "",
        "GLOBAL void trace_msg_bop IFN0()",
        "{",
        "\tsys_addr ea, ofs;",
        "",
        "\t/* ",
        "\tStack frame expected:",
        "\tN.B. VxDs lives in a flat segment, (mostly) protected mode world!",
        "\tThis code expects the address to have been converted to a base-0",
        "\tlinear address already.",
        "",
        "\t\t|            |",
        "\t\t--------------",
        "\t\t|  4 byte    |",
        "\tESP-->\t| eff. addr  |",
        "\t\t--------------",
        "\t*/",
        "",
        "\tif (sas_hw_at(BIOS_VIRTUALISING_BYTE) != 0)",
        "\t\tfprintf(trace_file, \"** WARNING ** Virtual byte non-zero\\n\");",
        "",
        "\tea = getESP();",
        "\tea = effective_addr(getSS(), ea);",
        "\tofs = sas_dw_at_no_check(ea);",
        "\tprint_msg(ofs);",
        "}",
        "",
        "LOCAL void print_msg IFN1( IU32, ofs )",
        "{",
        "\tSAVED IBOOL start_buffer = TRUE;",
        "\tSAVED char string[164], *p = NULL;",
        "\tchar finalStr[180];",
        "\tIU32 res, width;",
        "",
        "\tif (start_buffer)",
        "\t{",
        "\t\tmemset(string, 0, sizeof(string));",
        "\t\tp = string;",
        "\t\tstart_buffer = FALSE;",
        "\t}",
        "",
        "\tdo",
        "\t{",
        "\t\t/* do things which must be done at the start of a line. */",
        "\t\t*p = sas_hw_at(ofs++);",
        "\t\tif (*p == '#')",
        "\t\t{",
        "\t\t\t/* found poss reg. sequence in string */",
        "",
        "\t\t\tp++;",
        "\t\t\tp[0] = sas_hw_at(ofs);",
        "\t\t\tif (('A' <= p[0]) && (p[0] <= 'Z'))",
        "\t\t\t\tp[0] += 'a' - 'A';",
        "\t\t\tp[1] = sas_hw_at(ofs+1);",
        "\t\t\tif (('A' <= p[1]) && (p[1] <= 'Z'))",
        "\t\t\t\tp[1] += 'a' - 'A';",
        "\t\t\tif (p[0] == 'e') ",
        "\t\t\t{",
        "\t\t\t\t/* may be esp, esi, eax, etc... */",
        "",
        "\t\t\t\tp[2] = sas_hw_at(ofs+2);",
        "\t\t\t\tif (('A' <= p[2]) && (p[2] <= 'Z'))",
        "\t\t\t\t\tp[2] += 'a' - 'A';",
        "\t\t\t\tp[3] = '\\0';",
        "\t\t\t\twidth = 8;",
        "\t\t\t}",
        "\t\t\telse",
        "\t\t\t{",
        "\t\t\t\t/* If not eXX then can only be two letters long */",
        "\t\t\t\tp[2] = '\\0';",
        "\t\t\t\twidth = 4;",
        "\t\t\t}",
        "",
        "\t\t\tif (strcmp(p, \"al\") == 0)",
        "\t\t\t{\tres = getAL(); width = 2;\t}",
        "\t\t\telse if (strcmp(p, \"ah\") == 0)",
        "\t\t\t{\tres = getAH(); width = 2;\t}",
        "\t\t\telse if (strcmp(p, \"bl\") == 0)",
        "\t\t\t{\tres = getBL(); width = 2;\t}",
        "\t\t\telse if (strcmp(p, \"bh\") == 0)",
        "\t\t\t{\tres = getBH(); width = 2;\t}",
        "\t\t\telse if (strcmp(p, \"cl\") == 0)",
        "\t\t\t{\tres = getCL(); width = 2;\t}",
        "\t\t\telse if (strcmp(p, \"ch\") == 0)",
        "\t\t\t{\tres = getCH(); width = 2;\t}",
        "\t\t\telse if (strcmp(p, \"dl\") == 0)",
        "\t\t\t{\tres = getDL(); width = 2;\t}",
        "\t\t\telse if (strcmp(p, \"dh\") == 0)",
        "\t\t\t{\tres = getDH(); width = 2;\t}",
        "\t\t\telse if (strcmp(p, \"ax\") == 0)",
        "\t\t\t\tres = getAX();",
        "\t\t\telse if (strcmp(p, \"bx\") == 0)",
        "\t\t\t\tres = getBX();",
        "\t\t\telse if (strcmp(p, \"cx\") == 0)",
        "\t\t\t\tres = getCX();",
        "\t\t\telse if (strcmp(p, \"dx\") == 0)",
        "\t\t\t\tres = getDX();",
        "\t\t\telse if (strcmp(p, \"si\") == 0)",
        "\t\t\t\tres = getSI();",
        "\t\t\telse if (strcmp(p, \"di\") == 0)",
        "\t\t\t\tres = getDI();",
        "\t\t\telse if (strcmp(p, \"sp\") == 0)",
        "\t\t\t\tres = getSP();",
        "\t\t\telse if (strcmp(p, \"bp\") == 0)",
        "\t\t\t\tres = getBP();",
        "\t\t\telse if (strcmp(p, \"eax\") == 0)",
        "\t\t\t\tres = getEAX();",
        "\t\t\telse if (strcmp(p, \"ebx\") == 0)",
        "\t\t\t\tres = getEBX();",
        "\t\t\telse if (strcmp(p, \"ecx\") == 0)",
        "\t\t\t\tres = getECX();",
        "\t\t\telse if (strcmp(p, \"edx\") == 0)",
        "\t\t\t\tres = getEDX();",
        "\t\t\telse if (strcmp(p, \"esi\") == 0)",
        "\t\t\t\tres = getESI();",
        "\t\t\telse if (strcmp(p, \"edi\") == 0)",
        "\t\t\t\tres = getEDI();",
        "\t\t\telse if (strcmp(p, \"esp\") == 0)",
        "\t\t\t\tres = getESP();",
        "\t\t\telse if (strcmp(p, \"ebp\") == 0)",
        "\t\t\t\tres = getEBP();",
        "\t\t\telse if (strcmp(p, \"cs\") == 0)",
        "\t\t\t\tres = getCS();",
        "\t\t\telse if (strcmp(p, \"ds\") == 0)",
        "\t\t\t\tres = getDS();",
        "\t\t\telse if (strncmp(p, \"es\", 2) == 0)",
        "\t\t\t{\tres = getES(); width = 4; p[2] = '\\0';\t}",
        "\t\t\telse if (strcmp(p, \"fs\") == 0)",
        "\t\t\t\tres = getFS();",
        "\t\t\telse if (strcmp(p, \"gs\") == 0)",
        "\t\t\t\tres = getGS();",
        "\t\t\telse if (strcmp(p, \"fl\") == 0)",
        "\t\t\t\tres = getFLAGS();",
        "\t\t\telse if (strcmp(p, \"efl\") == 0)",
        "\t\t\t\tres = getEFLAGS();",
        "\t\t\telse",
        "\t\t\t\t*p = '\\0';\t/* else just write the '#' */",
        "\t\t\tif (*p)",
        "\t\t\t{",
        "\t\t\t\t/* Overwrite the \"#xx\" with it's value */",
        "",
        "\t\t\t\tofs += (p[2] ? 3: 2);",
        "\t\t\t\tp--;",
        "\t\t\t\tif (width == 8)",
        "\t\t\t\t\tsprintf(p, \"%08x\", res);",
        "\t\t\t\telse if (width == 4)",
        "\t\t\t\t\tsprintf(p, \"%04x\", res);",
        "\t\t\t\telse",
        "\t\t\t\t\tsprintf(p, \"%02x\", res);",
        "\t\t\t\tp += strlen(p);",
        "\t\t\t}",
        "\t\t}",
        "\t\telse if (*p != '\\r')\t/* ignore CR's */",
        "\t\t{",
        "\t\t\tif (*p == '\\n' || (p - string >= (sizeof(string) - 4)))",
        "\t\t\t{",
        "\t\t\t\tp[1] = '\\0';",
        "\t\t\t\tsprintf(finalStr, \"intel msg at %04x:%04x : %s\",",
        "\t\t\t\t\t\tgetCS(), GetInstructionPointer(), string);",
        "#ifdef CPU_40_STYLE",
        "\t\t\t\tif (IntelMsgDest & IM_DST_TRACE)",
        "\t\t\t\t{",
        "\t\t\t\t\tfprintf(trace_file, finalStr);",
        "\t\t\t\t}",
        "#ifndef\tCCPU",
        "\t\t\t\tif (IntelMsgDest & IM_DST_RING)",
        "\t\t\t\t{",
        "\t\t\t\t\tAddToTraceXBuffer( ((GLOBAL_TraceVectorSize - 2) << 4) + 0,",
        "\t\t\t\t  \t\tfinalStr );",
        "\t\t\t\t}",
        "#endif\t/* CCPU */",
        "#else\t/* CPU_40_STYLE */",
        "\t\t\t\tfprintf(trace_file, finalStr);",
        "#endif\t/* CPU_40_STYLE */",
        "\t\t\t\tmemset(string, 0, sizeof(string));",
        "\t\t\t\tp = string;",
        "\t\t\t}",
        "\t\t\telse if (*p == '\\0')\t/* no more - stop */",
        "\t\t\t\tbreak;",
        "\t\t\telse",
        "\t\t\t\tp++;",
        "\t\t}",
        "\t} while ((p - string) < sizeof(string) - 4);",
        "}"
      ],
      "current": [
        "#error DIVERGENCE MVDM-HOST-DIV-500: non-PROD debug branch is not selected; see mirror register."
      ]
    }
