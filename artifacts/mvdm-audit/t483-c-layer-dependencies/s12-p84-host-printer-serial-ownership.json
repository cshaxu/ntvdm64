  "printerEvidence": {
    "revision": "5c5b979ec08c17d3ca2eb70e8aad62d26515d01c",
    "original": "base/mvdm/v86/monitor/i386/monitor.c: MonitorInitializePrinterInfo, MonitorEnablePrinterDirectAccess, MonitorPrinterWriteData; pinned git show and nt_lpt caller sites checked.",
    "current": "Initialize binds original printer arrays once and initializes modes; enable changes handle/mode; write appends byte to VDM_TIB buffer. This is not CPU execution ownership.",
    "boundary": "Current NtVdmControl in ntvdm-exe/monitor/source/vdm_control.c accepts only VdmQueryDir. Printer close service returns STATUS_NOT_IMPLEMENTED, and printer helper ignores that result. No claim of working physical direct printer I/O; S14 must preserve/classify this boundary before restoration."
  },
  "consoleEvidence": "nt_hosts explicitly opens CONIN$/CONOUT$ when standard handles redirected; MvdmCreateFileA duplicates session endpoint identity. MvdmGetFileType recognizes it; state calls use existing frontend channel. SetLastConsoleEventActive emits session video event. Reuse P83 dispatch proof.",
