    {
      "operation": "initialize, bind, current, enter, leave, leave_for_callout, reenter_after_callout, set_context",
      "owner": "B",
      "reason": "Current implementation uses one TLS binding, Win32 locks and opaque identity fields; it does not select a task, call the scheduler or report a request. Preserve the sole NTVDM-exported instance for the WOW32 import; no separate DLL TLS copy."
    },
    {
      "operation": "unbind validation and TLS/field clearing",
      "owner": "B",
      "reason": "May validate current binding and held lock. Must not invoke retire_thread. Clearing follows successful owner retirement, never precedes it."
    },
