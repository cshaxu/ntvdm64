+static DWORD WINAPI remote_thread_entry_probe(void *unused)
+{
+    (void)unused;
+    /* W32RemoteThread receives a native thread from its debugger, not
+     * host_CreateThread, and calls the exported cpu_createthread itself. */
+    cpu_createthread(GetCurrentThread());
+    c_cpu_simulate();
+    ccpu386exitthread();
+    return c_getAX() == 0xbeef ? 0 : 1;
