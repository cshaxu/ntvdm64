        "\t    in the given pathname.",
        "\t    TRUE if a LFN was found. *ppLongName points to the first",
        "\t    character in the LFN",
        "    NOTE: space characters are valid for FAT file names. This function",
        "\t  will return TRUE(long name found) if space characters are found",
        "\t  in the given pathname.",
        "",
        "**/",
        "",
        "// (1). base name longer than 8 chars",
        "// (2). extention longer than 3 chars",
        "// (3). more than 2 dots.",
        "// (4). two dots but not \"..\"",
        "// (5). \"basename.\"",
        "// (6). \".ext\"",
        "// note that \"basename.\" would never happen on win32 because",
        "// win32 api strips the trailing '.'",
        "#define IsInvalidDosFileName(BaseNameLen, ExtentionLen, Dots) \\",
        "\t    (BaseNameLen > 8 || ExtentionLen > 3 || Dots > 2 || \\",
        "\t     (Dots == 2 && (ExtentionLen + BaseNameLen)) || \\",
        "\t     (Dots == 1 && (!BaseNameLen && ExtentionLen)) || \\",
        "\t     (Dots == 1 && (BaseNameLen && !ExtentionLen)))",
        "",
        "BOOL\tBaseSearchLongName_U(",
        "    LPCWSTR lpPathName,",
        "    LPWSTR  *ppLongName",
        "    )",
        "",
        "{",
        "    BOOL    fLongNameFound, Done;",
        "    UINT    BaseNameLen, ExtentionLen, Dots;",
        "    LPWSTR  p;",
        "",
        "    ASSERT(lpPathName && ppLongName);",
        "",
        "    p = (LPWSTR)lpPathName;",
        "    fLongNameFound = FALSE;",
        "    *ppLongName = p;",
        "    Dots = 0;",
        "    BaseNameLen = 0;",
        "    ExtentionLen = 0;",
        "    Done = FALSE;",
        "",
        "    while (!Done && !fLongNameFound) {",
        "\tswitch (*p) {",
        "\t    case L'.':",
        "\t\tDots++;",
        "\t\tp++;",
        "\t\tbreak;",
        "\t    case L'\\\\':",
        "\t    case L'/':",
        "",
        "\t\tif (IsInvalidDosFileName(BaseNameLen, ExtentionLen, Dots)) {",
        "\t\t    fLongNameFound = TRUE;",
        "\t\t    }",
        "\t\telse {",
        "\t\t    *ppLongName = ++p;",
        "\t\t    // reset all counters for the next file/dir name",
        "\t\t    Dots = 0;",
        "\t\t    BaseNameLen = 0;",
        "\t\t    ExtentionLen = 0;",
        "\t\t    }",
        "\t\tbreak;",
        "\t    case UNICODE_NULL:",
        "\t\tif (IsInvalidDosFileName(BaseNameLen, ExtentionLen, Dots)) {",
        "\t\t    fLongNameFound = TRUE;",
        "\t\t    }",
        "\t\telse",
        "\t\t    *ppLongName = p;",
        "\t\tDone = TRUE;",
        "\t\tbreak;",
        "",
        "\t    // space is a valid char on FAT volume but not on NTFS.",
