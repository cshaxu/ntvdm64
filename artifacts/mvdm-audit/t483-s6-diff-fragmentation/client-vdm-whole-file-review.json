        "",
        "\t\tp = (LPWSTR)lpszLongPath + 2;",
        "\t\tCount = 2;",
        "\t\t// guard for UNICODE_NULL is necessary because",
        "\t\t// RtlDetermineDosPathNameType_U doesn't really",
