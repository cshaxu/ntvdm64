        "    pLocalBuffer = NULL;",
        "",
        "    if (!ARGUMENT_PRESENT(lpszLongPath)) {",
        "\tSetLastError(ERROR_INVALID_PARAMETER);",
        "\treturn 0;",
        "\t}",
        "    try {",
        "\t// decide the path type, we want to find out the position of",
        "\t// the first character of the first name",
