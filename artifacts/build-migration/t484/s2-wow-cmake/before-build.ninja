ninja_required_version = 1.10
root = O$:/repos.hobby/ntvdm64
environment = O$:/repos.hobby/ntvdm64/build/.ninja/msvc-x86-release/wow32/msvc-x86.cmd
release_cflags = /O2
cflags = /nologo /TC /c /MT /W3 /Gz /showIncludes /D_NO_CRT_STDIO_INLINE /DWIN32 /DWINNT /DNTVDM /DCPU_40_STYLE /DNEW_CPU /DCCPU /DC_VID /DSPC386 /DSIM32 /DV7VGA /DANSI /DPROD /FI "O:/repos.hobby/ntvdm64/src/non-mvdm/public/sdk/inc/nt.h" /I "O:/repos.hobby/ntvdm64/src" /I "O:/repos.hobby/ntvdm64/src/compat/include" /I "O:/repos.hobby/ntvdm64/src/mvdm-host/wow32" /I "O:/repos.hobby/ntvdm64/src/mvdm-host/inc" /I "O:/repos.hobby/ntvdm64/src/mvdm-host/softpc.new/base/inc" /I "O:/repos.hobby/ntvdm64/src/mvdm-host/softpc.new/host/inc" /I "O:/repos.hobby/ntvdm64/src/non-mvdm/public/sdk/inc" /I "O:/repos.hobby/ntvdm64/src/non-mvdm/public/internal/base/inc" /I "O:/repos.hobby/ntvdm64/src/non-mvdm/windows/core/ntuser/inc" /I "O:/repos.hobby/ntvdm64/src/non-mvdm/public/internal/windows/inc" /I "O:/repos.hobby/ntvdm64/src/non-mvdm/public/internal/shell/inc" /I "O:/repos.hobby/ntvdm64/src/non-mvdm/private/windows/inc"
wow_cflags = $cflags /DWOW_ORIGINAL_THUNK_BUILD
adapter_cflags = /nologo /TC /c /MT /W3 /Gz /showIncludes /D_NO_CRT_STDIO_INLINE /DWINNT /FI "O:/repos.hobby/ntvdm64/src/non-mvdm/public/sdk/inc/nt.h" /I "O:/repos.hobby/ntvdm64/src" /I "O:/repos.hobby/ntvdm64/src/compat/include" /I "O:/repos.hobby/ntvdm64/src/mvdm-host/wow32" /I "O:/repos.hobby/ntvdm64/src/mvdm-host/inc" /I "O:/repos.hobby/ntvdm64/src/mvdm-host/softpc.new/base/inc" /I "O:/repos.hobby/ntvdm64/src/mvdm-host/softpc.new/host/inc" /I "O:/repos.hobby/ntvdm64/src/non-mvdm/public/sdk/inc" /I "O:/repos.hobby/ntvdm64/src/non-mvdm/public/internal/base/inc" /I "O:/repos.hobby/ntvdm64/src/non-mvdm/windows/core/ntuser/inc" /I "O:/repos.hobby/ntvdm64/src/non-mvdm/public/internal/windows/inc" /I "O:/repos.hobby/ntvdm64/src/non-mvdm/public/internal/shell/inc" /I "O:/repos.hobby/ntvdm64/src/non-mvdm/private/windows/inc"
compat_wow_cflags = /nologo /TC /c /MT /W3 /Gz /showIncludes /D_NO_CRT_STDIO_INLINE /DWINNT /I "O:/repos.hobby/ntvdm64/src" /I "O:/repos.hobby/ntvdm64/src/compat/include"
control_user_flags = /UANSI /DUNICODE
rule cc
  command = cl.exe $cflags $release_cflags /Fo$out $in
  deps = msvc
  description = CC $in
rule generic_call_asm
  command = ml /nologo /c /DDBG=0 /I "O$:/repos.hobby/ntvdm64/src/non-mvdm/public/sdk/inc" /Fo$out $in
rule rc
  command = rc /nologo /fo$out $in
  description = RC $in
rule legacy_import_lib
  command = lib /nologo /machine:x86 /def:$in /out:$out
  description = IMPORTLIB $out
rule wow_dll_link
  command = link /nologo /machine:x86 /dll /map:$out.map /def:O$:/repos.hobby/ntvdm64/build/.ninja/msvc-x86-release/wow32/wow32-x86.def /out:$out $in O$:/repos.hobby/ntvdm64/build/.ninja/msvc-x86-release/worker/ntvdm.lib kernel32.lib user32.lib gdi32.lib advapi32.lib shell32.lib comdlg32.lib version.lib winmm.lib wsock32.lib oldnames.lib
  description = LINK $out
  restat = 1
