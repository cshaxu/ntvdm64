ninja_required_version = 1.10
release_cflags = /O2
cflags = /nologo /c /MT /W4 /we4013 /we4311 /we4302 /Gy /showIncludes /DWINNT /D_NO_CRT_STDIO_INLINE /D_WIN32_WINNT=0x0A00 /I "O$:/repos.hobby/ntvdm64/src/lib-nxvm" /I "O$:/repos.hobby/ntvdm64/src" /I "O$:/repos.hobby/ntvdm64/src/compat/include" /I "O$:/repos.hobby/ntvdm64/src/non-mvdm/public/sdk/inc" /I "O$:/repos.hobby/ntvdm64/src/non-mvdm/public/internal/base/inc" /I obj/basesrv
entry = wmainCRTStartup
subsystem = console
rule cc
  command = cl.exe $cflags $release_cflags /Fo$out $in
  deps = msvc
  msvc_deps_prefix = Note: including file:
rule lib
  command = lib.exe /nologo /out:$out $in
rule link
  command = link.exe /nologo /machine:x64 /subsystem:$subsystem /entry:$entry /opt:ref /out:$out /map:$out.map $in rpcrt4.lib ntdll.lib kernel32.lib shell32.lib user32.lib gdi32.lib advapi32.lib legacy_stdio_definitions.lib
rule test_link
  command = link.exe /nologo /machine:x64 /subsystem:console /opt:ref /out:$out /map:$out.map $in rpcrt4.lib ntdll.lib kernel32.lib shell32.lib user32.lib gdi32.lib advapi32.lib legacy_stdio_definitions.lib
rule idl
  command = midl.exe /nologo /env x64 /target NT100 /prefix client Client_ /prefix server Server_ /acf "O$:/repos.hobby/ntvdm64/src/common/protocol/service.acf" /out obj/basesrv /h service.h /cstub service_c.c /sstub service_s.c "O$:/repos.hobby/ntvdm64/src/common/protocol/service.idl"
build obj/basesrv/service_c.c obj/basesrv/service_s.c obj/basesrv/service.h: idl O$:/repos.hobby/ntvdm64/src/common/protocol/service.idl | O$:/repos.hobby/ntvdm64/src/common/protocol/service.acf
rule rpc_management_idl
  command = midl.exe /nologo /env x64 /target NT100 /acf "O$:/repos.hobby/ntvdm64/src/common/protocol/rpc_management.acf" /client stub /server none /out obj/basesrv /h rpc_management.h /cstub rpc_management_c.c $in
build obj/basesrv/rpc_management_c.c obj/basesrv/rpc_management.h: rpc_management_idl O$:/repos.hobby/ntvdm64/src/common/protocol/rpc_management.idl | O$:/repos.hobby/ntvdm64/src/common/protocol/rpc_management.acf
