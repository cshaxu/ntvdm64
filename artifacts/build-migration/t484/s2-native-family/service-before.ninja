  cflags = /nologo /c /MT /W4 /we4013 /we4311 /we4302 /Gy /showIncludes /DWINNT /D_NO_CRT_STDIO_INLINE /D_WIN32_WINNT=0x0A00 /I "O$:/repos.hobby/ntvdm64/src/lib-nxvm" /I "O$:/repos.hobby/ntvdm64/src" /I "O$:/repos.hobby/ntvdm64/src/compat/include" /I "O$:/repos.hobby/ntvdm64/src/non-mvdm/public/sdk/inc" /I "O$:/repos.hobby/ntvdm64/src/non-mvdm/public/internal/base/inc" /I obj/basesrv /we4312 /FI "O$:/repos.hobby/ntvdm64/src/non-mvdm/public/sdk/inc/nt.h" /I "O$:/repos.hobby/ntvdm64/src/non-mvdm/base/win32/inc" /I "O$:/repos.hobby/ntvdm64/src/non-mvdm/base/win32/server" /I "O$:/repos.hobby/ntvdm64/src/ntsrv-exe/opennt/include" /we4013
