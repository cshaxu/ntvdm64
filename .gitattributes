* text=auto eol=lf

# Asset and archive checkout behavior remains unchanged; specific pinned inputs below are byte-preserved.
assets/** !text !eol
artifacts/** !text !eol

# Imported historical and third-party trees are preserved byte-for-byte.
# Their upstream whitespace is not a project-authored formatting violation.
src/archived/** -text -whitespace
src/bochs/** -text -whitespace
src/bochs-core/** -text -whitespace
src/ms-dos-6/** -text -whitespace
src/ntvdmx64/** -text -whitespace
src/opennt/** -text -whitespace
src/opennt-45/** -text -whitespace

# Imported historical tooling and retained historical evidence are likewise
# preserved without mechanical whitespace rewriting during baseline recovery.
tools/msdos400/** -whitespace
tools/msdos6-qb45/** -whitespace
tools/opennt-4.5/** -whitespace
docs/etc/research/t1*.md -whitespace
docs/history/m0-t1*.md -whitespace

src/bochs-core/README.md text
# T266 S3 exact OpenNT inputs retained for current local staging and source maps.
src/opennt-bop/inc/** -text -whitespace
src/mvdm-host/** -text -whitespace
src/mvdm-guest/** -text -whitespace
src/non-mvdm/** -text -whitespace
# Pinned nxvm presentation inputs retain their upstream byte identity.
src/frontend-exe/lib/** -text
src/lib-nxvm/base/** -text
src/lib-nxvm/types/** -text
src/lib-nxvm/kvm-base/** -text
src/lib-nxvm/kvm-window/** -text
src/lib-nxvm/LICENSE.nxvm -text
src/lib-nxvm/LICENSE.libvterm -text
src/lib-nxvm/libvterm-0.3.3.tar.gz -text
# Shared project-owned process-hook source uses LF; vendored MinHook stays byte-exact.
src/lib-win32/process-hook/helper.[ch] text eol=lf
src/lib-win32/process-hook/late_guard.[ch] text eol=lf
src/lib-win32/process-hook/late_patch.[ch] text eol=lf
src/lib-win32/process-hook/staging.[ch] text eol=lf
src/lib-win32/process-hook/startup_hooks.[ch] text eol=lf
src/lib-win32/process-hook/minhook/** -text
src/lib-win32/process-hook/LICENSE.win16style -text whitespace=cr-at-eol
# New shared payload extension uses the upstream project C source line endings.
src/lib-win32/process-hook/payload.[ch] text eol=lf
# Pinned MIT Detours slice retains the registered upstream byte hashes.
src/lib-win32/process-hook/detours/** -text
src/opennt-softpc/bios/** -text -whitespace
src/opennt-guest/wow16/fonts/** -text -whitespace
docs/etc/legacy_code/opennt-bop/original/** -text -whitespace
# Audit ledgers, probes and reports carry exact-byte SHA-256 identities.
# Preserve their captured bytes instead of applying core.autocrlf on checkout.
artifacts/mvdm-audit/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve raw Full-run output, including native messages' terminal spaces.
artifacts/mvdm-audit/latest-source-release/full.stdout.txt -whitespace
artifacts/mvdm-audit/latest-source-release/final/run-full.log -whitespace
# A blank context line's leading space is part of this captured patch format.
artifacts/mvdm-audit/shard-3/sas-vector-runtime-fixture.patch -whitespace
# Retain the original Ninja dependency dump's terminal blank line.
artifacts/mvdm-audit/ccpu-header-macros/preprocess/run/deps.stdout.txt whitespace=blank-at-eol,space-before-tab,cr-at-eol,-blank-at-eof
artifacts/mvdm-audit/ccpu-remaining-header-source/deps.stdout.txt whitespace=blank-at-eol,space-before-tab,cr-at-eol,-blank-at-eof
# Retain the captured PowerShell failure record's terminal blank line verbatim.
artifacts/mvdm-audit/ccpu-control/initial-narrow-nonpass/failure.txt whitespace=blank-at-eol,space-before-tab,cr-at-eol,-blank-at-eof

# Preserve the exact combined hook redistribution notices from the staged package.
assets/release/nthook32-LICENSE.txt -text whitespace=cr-at-eol

# Shared Win16-style process-image source uses LF.
src/lib-win32/process-image/** text eol=lf

# Shared process-launch source uses LF.
src/lib-win32/process-launch/** text eol=lf

# Historical tools were checked out with CRLF; retain their existing form.
tools/historical/msdos400/** text=auto eol=crlf
tools/historical/msdos6-qb45/** text=auto eol=crlf
tools/historical/opennt-4.5/** text=auto eol=crlf
tools/opennt/tools16/** text=auto eol=crlf

# Exact owner-directed candidate handoff; patch context whitespace is evidence.
artifacts/t479-s6-handoff/candidate.patch -whitespace
artifacts/t479-s6-handoff/evidence/** -whitespace
artifacts/t479-s6-handoff/** -text
