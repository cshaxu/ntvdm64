@echo off
setlocal EnableExtensions DisableDelayedExpansion
for %%I in ("%~dp0..") do set "ROOT=%%~fI"
set "PATCH=%~dp0"
set "INI=%ROOT%\SYSTEM.INI"
for %%F in (WIN.COM SYSTEM.INI) do if not exist "%ROOT%\%%F" (echo Missing %%F.& exit /b 2)
for %%F in (PIF.EXE INSIGNIA.386 NTVDM64.386) do if not exist "%PATCH%%%F" (echo Missing %%F.& exit /b 2)
set "MODE=1"
set "DOSMODE=0"
set "MULTITASK=0"
if /i "%~1"=="--install" goto configure
where run16 >nul 2>nul || (echo run16.exe must be available through PATH.& exit /b 2)
set /p "MODE=Windows mode [1=Standard, 2=386 Enhanced] (default 1): "
if not "%MODE%"=="1" if not "%MODE%"=="2" (echo Choose 1 or 2.& exit /b 4)
set /p "DOSMODE=DOSONLY [0=host commands, 1=guest DOS] (default 0): "
if not "%DOSMODE%"=="0" if not "%DOSMODE%"=="1" (echo Choose 0 or 1.& exit /b 4)
if "%MODE%"=="2" set /p "MULTITASK=Enable NTVDM64.386 multitask payloads [0=no, 1=yes] (default 0): "
if not "%MULTITASK%"=="0" if not "%MULTITASK%"=="1" (echo Choose 0 or 1.& exit /b 4)
if "%MODE%"=="1" echo Standard mode does not load enhanced-mode drivers.
:configure
rem One short-lived staging directory also rejects overlapping reconfiguration.
set "WORK=%PATCH%WINCFG"
mkdir "%WORK%" 2>nul || (echo Cannot create configuration staging directory.& exit /b 5)
set "RESULT=5"
findstr /l /c:"!" "%INI%" >nul && (echo Unsupported exclamation mark in SYSTEM.INI.& goto cleanup)
setlocal EnableDelayedExpansion
set "IN386="
set "FOUND=0"
set "DRIVERCOUNT=0"
set "SEEN_INSIGNIA.386="
set "SEEN_NTVDM64.386="
set "COMMENT_NTVDM64.386=;"
if "%MULTITASK%"=="1" set "COMMENT_NTVDM64.386="
set "COMMENT_INSIGNIA.386="
if "%MODE%"=="1" set "COMMENT_INSIGNIA.386=;"
>"%WORK%\SYSTEM.INI" (
  for /f "delims=" %%A in ('findstr /n "^" "%INI%"') do (
    set "LINE=%%A"
    set "LINE=!LINE:*:=!"
    if "!LINE:~0,1!"=="[" set "IN386="
    if /i "!LINE!"=="[386Enh]" set "IN386=1"
    set "SKIP="
    if defined IN386 (
      set "ENTRY=!LINE!"
      if "!ENTRY:~0,1!"==";" set "ENTRY=!ENTRY:~1!"
      for /f "tokens=1,* delims==" %%K in ("!ENTRY!") do (
        set "KEY=%%K"
        set "KEY=!KEY: =!"
        if /i "!KEY!"=="device" for %%F in ("%%L") do (
          if /i "%%~nxF"=="INSIGNIA.386" set "SKIP=INSIGNIA.386"
          if /i "%%~nxF"=="NTVDM64.386" set "SKIP=NTVDM64.386"
        )
      )
    )
    if defined SKIP (
      set /a DRIVERCOUNT+=1
      set "SEEN_!SKIP!=1"
      if /i not "%~1"=="--install" for %%D in (!SKIP!) do echo(!COMMENT_%%D!device=!ROOT!\PATCH\%%D
    ) else echo(!LINE!
    if /i "!LINE!"=="[386Enh]" (
      set /a FOUND+=1
      if /i "%~1"=="--install" (
        echo(;device=!ROOT!\PATCH\INSIGNIA.386
        echo(;device=!ROOT!\PATCH\NTVDM64.386
      )
    )
  )
)
if not "!FOUND!"=="1" (endlocal & echo Exactly one [386Enh] section is required.& goto cleanup)
if /i not "%~1"=="--install" if not "!DRIVERCOUNT!"=="2" (endlocal & echo Expected two installed driver entries.& goto cleanup)
if /i not "%~1"=="--install" if not defined SEEN_INSIGNIA.386 (endlocal & echo Missing INSIGNIA.386 entry.& goto cleanup)
if /i not "%~1"=="--install" if not defined SEEN_NTVDM64.386 (endlocal & echo Missing NTVDM64.386 entry.& goto cleanup)
endlocal
if /i "%~1"=="--install" goto install_ini
set "ARG=/S"
set "TITLE=Windows 3.1 Standard"
if "%MODE%"=="2" set "ARG=/3"
if "%MODE%"=="2" set "TITLE=Windows 3.1 386 Enhanced"
>"%WORK%\CONFIG.NT" echo REM Generated by PATCH\WIN.CMD
>>"%WORK%\CONFIG.NT" echo dos=high, umb
>>"%WORK%\CONFIG.NT" echo device=%%SystemRoot%%\system32\himem.sys
>>"%WORK%\CONFIG.NT" echo files=128
if "%DOSMODE%"=="1" >>"%WORK%\CONFIG.NT" echo dosonly
>"%WORK%\AUTOEXEC.NT" echo @echo off
>>"%WORK%\AUTOEXEC.NT" echo SET TEMP=%PATCH%TEMP
>>"%WORK%\AUTOEXEC.NT" echo SET TMP=%PATCH%TEMP
>>"%WORK%\AUTOEXEC.NT" echo SET PATH=%ROOT%;%ROOT%\SYSTEM;%%SystemRoot%%\system32
"%PATCH%PIF.EXE" create "%WORK%\WIN.PIF" --title "%TITLE%" --program "%ROOT%\WIN.COM" --directory "%ROOT%" --arguments "%ARG%" --config "%PATCH%CONFIG.NT" --autoexec "%PATCH%AUTOEXEC.NT" --close-on-exit --w386-max-xms 65535 --w386-flags 0x1003 --nt31-flags 1 || goto cleanup
for %%F in (CONFIG.NT AUTOEXEC.NT WIN.PIF) do move /y "%WORK%\%%F" "%PATCH%%%F" >nul || goto cleanup
:install_ini
move /y "%WORK%\SYSTEM.INI" "%INI%" >nul || goto cleanup
set "RESULT=0"
:cleanup
for %%F in (SYSTEM.INI CONFIG.NT AUTOEXEC.NT WIN.PIF) do if exist "%WORK%\%%F" del /q "%WORK%\%%F"
rmdir "%WORK%" 2>nul
if not "%RESULT%"=="0" exit /b %RESULT%
if /i "%~1"=="--install" exit /b 0
set "TEMP=%PATCH%TEMP"
set "TMP=%TEMP%"
if not exist "%TEMP%\" mkdir "%TEMP%" || exit /b 4
pushd "%ROOT%" || exit /b 3
call run16 "%PATCH%WIN.PIF"
set "RESULT=%errorlevel%"
popd
exit /b %RESULT%
