@echo off
setlocal EnableExtensions DisableDelayedExpansion
rem output, released images, worker build, WOW build, optional diagnostic image
if "%~4"=="" exit /b 2
if not "%~6"=="" exit /b 2
set "repo=@NTVDM_STAGE_REPO@"
set "output=%~f1"
set "images=%~f2"
set "worker=%~f3"
set "wow=%~f4"
set "diagnostic="
if not "%~5"=="" set "diagnostic=%~f5"
set "walk=%output%"
:within
for %%I in ("%walk%\..") do set "parent=%%~fI"
if /i "%parent%"=="%repo%\build" goto validate
if /i "%parent%"=="%walk%" exit /b 2
set "walk=%parent%"
goto within
:validate
if exist "%output%" exit /b 2
if not exist "%worker%\ntvdm.exe.map" exit /b 2
if not exist "%wow%\wow32.dll.map" exit /b 2
if not defined diagnostic goto prepare
for %%I in ("%diagnostic%") do set "name=%%~nxI"
set "known="
for %%I in (ntvdm.exe WOW32.DLL) do if /i "%name%"=="%%I" set "known=1"
if not defined known exit /b 2
if not exist "%diagnostic%" exit /b 2
if not exist "%diagnostic%.map" exit /b 2
:prepare
mkdir "%output%" || exit /b 1
set "identity=%repo%\build\.ninja\build-tools\ntvdm-package-id.exe"
set "hash=%repo%\assets\release\HASH.EXE"
"%identity%" --manifest "%images%\release-manifest.json" >"%output%\images.rows"
if errorlevel 1 goto fail
for /f "usebackq tokens=1-5" %%A in ("%output%\images.rows") do (
 set "uuid=%%C"
 call :check "%images%\%%A" "%%D"
 if errorlevel 1 goto fail
 if /i "%%A"=="ntvdm.exe" call :check "%worker%\%%A" "%%E"
 if errorlevel 1 goto fail
 if /i "%%A"=="WOW32.DLL" call :check "%wow%\%%A" "%%E"
 if errorlevel 1 goto fail
)
pushd "%output%" || goto fail
cmake -E tar xf "%repo%\assets\winnt.zip"
set "unpack=%errorlevel%"
popd
if not "%unpack%"=="0" goto fail
if not exist "%output%\WINNT\system32\" goto fail
for /f "usebackq tokens=1" %%A in ("%output%\images.rows") do (
 copy /b /y "%images%\%%A" "%output%\WINNT\system32\%%A" >nul
 if errorlevel 1 goto fail
)
copy /b "%worker%\ntvdm.exe.map" "%output%\WINNT\system32\ntvdm.exe.map" >nul || goto fail
copy /b "%wow%\wow32.dll.map" "%output%\WINNT\system32\wow32.dll.map" >nul || goto fail
if not defined diagnostic goto done
copy /b /y "%diagnostic%" "%output%\WINNT\system32\%name%" >nul || goto fail
copy /b /y "%diagnostic%.map" "%output%\WINNT\system32\%name%.map" >nul || goto fail
rem Only stamp the owned diagnostic copy; preserve its raw build output.
"%identity%" "%uuid%" "%output%\WINNT\system32\%name%"
if errorlevel 1 goto fail
:done
del /q "%output%\images.rows" "%output%\input.hash"
>"%output%\prepared.txt" echo CMD diagnostic inputs prepared; not a published package.
exit /b %errorlevel%
:check
"%hash%" "%~1" >"%output%\input.hash"
if errorlevel 1 exit /b 1
set "value="
set /p "value=" <"%output%\input.hash"
if /i not "%value%"=="%~2" exit /b 1
exit /b 0
:fail
echo Diagnostic package preparation failed; incomplete output retained for diagnosis. 1>&2
exit /b 1
