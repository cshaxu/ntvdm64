@echo off
setlocal EnableExtensions DisableDelayedExpansion
rem Build-owned output followed by pairs: source file, destination leaf.
rem -GuestPatch or -GuestRoot INSTALL OWNER pairs copies to the owned guest directory.
if "%~3"=="" exit /b 2
set "repo=@NTVDM_STAGE_REPO@"
set "guest="
if /i "%~1"=="-GuestPatch" goto guest
if /i "%~1"=="-GuestRoot" goto guest
set "output=%~f1"
set "walk=%output%"
:within
for %%I in ("%walk%\..") do set "parent=%%~fI"
if /i "%parent%"=="%repo%\build" goto prepare
if /i "%parent%"=="%walk%" exit /b 2
set "walk=%parent%"
goto within
:guest
set "install=%~f2"
set "owner=%~f3"
if "%~5"=="" exit /b 2
for %%I in ("%install%\..") do if /i not "%%~fI"=="O:\tmp" exit /b 2
if not exist "%install%\.ntvdm64-guest-owner" exit /b 2
set "actual="
set /p "actual="<"%install%\.ntvdm64-guest-owner"
if /i not "%actual%"=="%owner%" exit /b 2
if not exist "%owner%\" exit /b 2
set "output=%install%"
if /i "%~1"=="-GuestPatch" set "output=%install%\PATCH"
if not exist "%output%\" exit /b 2
set "guest=1"
shift
shift
shift
goto next
:prepare
if not exist "%output%\" mkdir "%output%"
if not exist "%output%\" exit /b 1
shift
:next
if "%~1"=="" exit /b 0
if "%~2"=="" exit /b 2
if not exist "%~f1" exit /b 2
if exist "%~f1\" exit /b 2
set "leaf=%~2"
if "%leaf%"=="." exit /b 2
if "%leaf%"==".." exit /b 2
for /f "delims=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-" %%I in ("%leaf%") do exit /b 2
if exist "%output%\%leaf%\" exit /b 2
if not defined guest if exist "%output%\%leaf%" exit /b 2
copy /b /y "%~f1" "%output%\%leaf%" >nul || exit /b 1
shift
shift
goto next
