set(config_source "${NTVDM_REPO}/src/non-mvdm/base/win32/client/vdm.c")
file(READ "${config_source}" config_text)
string(REPLACE "\r\n" "\n" config_text "${config_text}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${config_source}")
function(config_body output marker)
  string(FIND "${config_text}" "${marker}" begin)
  string(FIND "${config_text}" "${marker}" last REVERSE)
  if(begin LESS 0 OR NOT begin EQUAL last)
    message(FATAL_ERROR "Original configuration closure is missing or ambiguous")
  endif()
  string(SUBSTRING "${config_text}" ${begin} -1 tail)
  string(FIND "${tail}" "\n}" end)
  if(end LESS 0)
    message(FATAL_ERROR "Original configuration closure has no terminator")
  endif()
  math(EXPR length "${end}+2")
  string(SUBSTRING "${tail}" 0 ${length} body)
  set(${output} "${body}" PARENT_SCOPE)
endfunction()
config_body(helper "static VOID BaseSetLastNTError(")
string(REGEX MATCH "#line [0-9]+\nBOOL\nBaseGetVdmConfigInfo\\(" config_marker "${config_text}")
if(NOT config_marker)
  message(FATAL_ERROR "Original VDM config function has no source line anchor")
endif()
config_body(body "${config_marker}")
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/base_vdm_config.c"
  CONTENT "#include <nt.h>\n#include <ntrtl.h>\n#include <wchar.h>\n#include <basevdm.h>\n#include <base_config.h>\n#define VDM_TAG 0\n#define MAKE_TAG(Tag) 0\n${helper}\n${body}\n" @ONLY)
