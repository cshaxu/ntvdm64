# Test-only alternate images; preserve the selected product link and profile.
function(family_diagnostic name image member source)
  string(MAKE_C_IDENTIFIER "unit_${member}" owner)
  string(MAKE_C_IDENTIFIER "image_${image}" product)
  get_target_property(flags ${owner} COMPILE_FLAGS)
  get_target_property(sources ${owner} SOURCES)
  get_source_file_property(dependencies "${sources}" OBJECT_DEPENDS)
  if(NOT dependencies)
    set(dependencies)
  endif()
  set(object "diagnostics/${name}/replacement.obj")
  family_unit("${object}" "${source}" "${flags}" ${dependencies})
  get_target_property(inputs ${product} FAMILY_LINK_INPUTS)
  get_target_property(link_flags ${product} FAMILY_LINK_FLAGS)
  list(FIND inputs "${member}" position)
  if(position LESS 0)
    message(FATAL_ERROR "Diagnostic owner not in product link: ${member}")
  endif()
  list(REMOVE_AT inputs ${position})
  list(INSERT inputs ${position} "${object}")
  family_image("diagnostics/${name}/${image}" "${link_flags}" ${inputs})
  set_property(GLOBAL APPEND PROPERTY native_diagnostics "${CMAKE_BINARY_DIR}/diagnostics/${name}/${image}")
endfunction()
if(NTVDM_COMPONENT STREQUAL "frontend")
  family_diagnostic(console-grid ntcon.exe obj/opennt-abi-host-compat/console_grid.obj
    "${NTVDM_REPO}/test/observation/console_grid_diagnostic.c")
elseif(NTVDM_COMPONENT STREQUAL "service")
  set(source "${NTVDM_REPO}/src/ntsrv-exe/main.c")
  file(READ "${source}" text)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  set(needle "if(!error)error=OpenNtBaseServiceObserveNativeCreation(service,reporter,child,flags,&identity);")
  string(FIND "${text}" "${needle}" first)
  string(FIND "${text}" "${needle}" last REVERSE)
  if(first LESS 0 OR NOT first EQUAL last)
    message(FATAL_ERROR "Native observation fault boundary changed")
  endif()
  foreach(kind IN ITEMS deny slow)
    set(replacement "if(!error)error=ERROR_ACCESS_DENIED;")
    if(kind STREQUAL "slow")
      set(replacement "if(!error){Sleep(2000);error=OpenNtBaseServiceObserveNativeCreation(service,reporter,child,flags,&identity);}")
    endif()
    string(REPLACE "${needle}" "${replacement}" body "${text}")
    set(output "${CMAKE_BINARY_DIR}/diagnostics/observe-${kind}/service.c")
    file(CONFIGURE OUTPUT "${output}" CONTENT "${body}" @ONLY)
    family_diagnostic("observe-${kind}" ntsrv.exe obj/basesrv/entry.obj "${output}")
  endforeach()
endif()
get_property(images GLOBAL PROPERTY native_diagnostics)
add_custom_target(native-diagnostics DEPENDS ${images})
