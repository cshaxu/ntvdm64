# Real RPC negative peers, using the current service profile and link closure.
if(NOT NTVDM_COMPONENT STREQUAL "service")
  return()
endif()
set(version_source "${NTVDM_REPO}/src/ntsrv-exe/main.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${version_source}" "${NTVDM_REPO}/src/common/protocol/service.idl")
file(READ "${version_source}" version_text)
string(FIND "${version_text}" "error_status_t Server_Connect" connect_start)
if(connect_start LESS 0)
  message(FATAL_ERROR "Missing Server_Connect version boundary")
endif()
string(SUBSTRING "${version_text}" 0 ${connect_start} version_head)
string(SUBSTRING "${version_text}" ${connect_start} -1 version_tail)
function(version_peer name needle replacement)
  string(FIND "${version_tail}" "${needle}" first)
  string(FIND "${version_tail}" "${needle}" last REVERSE)
  if(first LESS 0 OR NOT first EQUAL last)
    message(FATAL_ERROR "Version mutation must be unique: ${name}")
  endif()
  string(REPLACE "${needle}" "${replacement}" tail "${version_tail}")
  set(source "${CMAKE_BINARY_DIR}/diagnostics/version-${name}/service.c")
  file(CONFIGURE OUTPUT "${source}" CONTENT "${version_head}${tail}" @ONLY)
  family_diagnostic("version-${name}" ntsrv.exe obj/basesrv/entry.obj "${source}")
endfunction()
version_peer(old-app "expected[APP_VERSION_BYTES]=APP_VERSION" "expected[APP_VERSION_BYTES]=\"0.0.0\"")
version_peer(wrong-protocol "protocol!=APP_PROTOCOL_VERSION" "protocol!=(APP_PROTOCOL_VERSION+1)")
version_peer(reply-app "memcpy(server_version,expected,sizeof(expected));" "memcpy(server_version,expected,sizeof(expected)); server_version[0]='9';")
version_peer(reply-protocol "*server_protocol=APP_PROTOCOL_VERSION;" "*server_protocol=APP_PROTOCOL_VERSION+1;")
set(legacy "${CMAKE_BINARY_DIR}/diagnostics/version-legacy-interface")
file(READ "${NTVDM_REPO}/src/common/protocol/service.idl" idl)
string(REGEX MATCH "version\\(([0-9]+)\\.0\\)" version_match "${idl}")
if(NOT version_match)
  message(FATAL_ERROR "Missing current RPC interface version")
endif()
set(protocol "${CMAKE_MATCH_1}")
string(REPLACE "${version_match}" "version(1.0)" legacy_idl "${idl}")
file(CONFIGURE OUTPUT "${legacy}/legacy.idl" CONTENT "${legacy_idl}" @ONLY)
string(REPLACE "\"service.h\"" "\"legacy.h\"" body "${version_text}")
string(REPLACE "Server_vdm_service_v${protocol}_0_s_ifspec" "Server_vdm_service_v1_0_s_ifspec" body "${body}")
file(CONFIGURE OUTPUT "${legacy}/service.c" CONTENT "${body}" @ONLY)
add_custom_command(OUTPUT "${legacy}/legacy.h" "${legacy}/legacy_s.c" "${legacy}/legacy_c.c"
  COMMAND "${NTVDM_MIDL}" /nologo /env x64 /target NT100 /prefix client Client_
    /prefix server Server_ /acf "${NTVDM_REPO}/src/common/protocol/service.acf"
    /out "${legacy}" /h legacy.h /cstub legacy_c.c /sstub legacy_s.c "${legacy}/legacy.idl"
  DEPENDS "${legacy}/legacy.idl" "${NTVDM_REPO}/src/common/protocol/service.acf" VERBATIM)
get_target_property(entry_flags unit_obj_basesrv_entry_obj COMPILE_FLAGS)
get_target_property(stub_flags unit_obj_basesrv_stub_obj COMPILE_FLAGS)
family_unit("diagnostics/version-legacy-interface/entry.obj" "${legacy}/service.c" "${entry_flags}" "${legacy}/legacy.h")
family_unit("diagnostics/version-legacy-interface/stub.obj" "${legacy}/legacy_s.c" "${stub_flags}" "${legacy}/legacy.h")
get_target_property(inputs image_ntsrv_exe FAMILY_LINK_INPUTS)
get_target_property(flags image_ntsrv_exe FAMILY_LINK_FLAGS)
list(REMOVE_ITEM inputs "obj/basesrv/entry.obj" "obj/basesrv/stub.obj")
family_image("diagnostics/version-legacy-interface/ntsrv.exe" "${flags}"
  "diagnostics/version-legacy-interface/entry.obj" "diagnostics/version-legacy-interface/stub.obj" ${inputs})
set(peers)
foreach(name IN ITEMS old-app wrong-protocol reply-app reply-protocol legacy-interface)
  list(APPEND peers "${CMAKE_BINARY_DIR}/diagnostics/version-${name}/ntsrv.exe")
endforeach()
add_custom_target(version-negatives DEPENDS ${peers})
