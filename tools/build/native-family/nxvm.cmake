# The import manifest owns membership and identity of the shared library.
set(nxvm_manifest "${NTVDM_REPO}/src/ntcon-exe/nxvm-import.json")
file(READ "${nxvm_manifest}" nxvm_json)
string(JSON expected GET "${nxvm_json}" licenseSha256)
file(SHA256 "${NTVDM_REPO}/src/lib-nxvm/LICENSE.nxvm" actual)
string(TOLOWER "${expected}" expected)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "NXVM license differs from its import manifest")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${nxvm_manifest}" "${NTVDM_REPO}/src/lib-nxvm/LICENSE.nxvm")
string(JSON count LENGTH "${nxvm_json}" files)
math(EXPR last "${count}-1")
set(nxvm_objects)
foreach(index RANGE ${last})
  string(JSON path GET "${nxvm_json}" files ${index} path)
  if(NOT path MATCHES "^lib-nxvm/lib/(types|base|kvm-base|kvm-window)/[A-Za-z0-9_./-]+$"
      OR path MATCHES "\\.\\.")
    message(FATAL_ERROR "Invalid NXVM import path: ${path}")
  endif()
  string(JSON expected GET "${nxvm_json}" files ${index} sha256)
  file(SHA256 "${NTVDM_REPO}/src/${path}" actual)
  string(TOLOWER "${expected}" expected)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "NXVM import identity mismatch: ${path}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${NTVDM_REPO}/src/${path}")
  string(JSON compile GET "${nxvm_json}" files ${index} compile)
  if(compile)
    string(REGEX REPLACE "\\.c$" ".obj" object "obj/frontend/window/${path}")
    family_unit("${object}" "${NTVDM_REPO}/src/${path}"
      "${family_flags} /I \"${NTVDM_REPO}/src\" /I \"${NTVDM_REPO}/src/lib-nxvm\" /std:c11 /we4013 /DWIN32_LEAN_AND_MEAN /O2")
    list(APPEND nxvm_objects "${object}")
  endif()
endforeach()
