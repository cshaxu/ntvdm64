@echo off
setlocal EnableExtensions DisableDelayedExpansion
if not "%~2"=="" exit /b 2
set "publishing="
set "repo=@publish_repo@"
set "build=%repo%\build\.ninja\addon"
set "output=%~1"
if not defined output set "output=%repo%\assets\release"
for %%I in ("%output%") do set "output=%%~fI"
if not exist "%output%\addon-manifest.json" exit /b 2
set "stage=%build%\utility-publication"
if not exist "%stage%" mkdir "%stage%"
if errorlevel 1 exit /b 1
set "hash=%build%\hash\hash.exe"
set "identity=%repo%\build\.ninja\build-tools\ntvdm-package-id.exe"
set "pending=%stage%\addon-manifest.json"
copy /b /y "%build%\utility-manifest-prefix.json" "%pending%" >nul
if errorlevel 1 exit /b 1
@driver_checks@
set "comma="
@publish_calls@
>>"%pending%" echo ]}
if errorlevel 1 goto fail
rem Invalidate the completion record before replacing any published utility.
set "publishing=1"
del /q "%output%\addon-manifest.json"
if errorlevel 1 goto fail
for %%I in (HASH GRP LNK SZDD patch31 path31 patch95 path95 PIF) do (
  copy /b /y "%stage%\%%I.exe" "%output%\%%I.exe" >nul
  if errorlevel 1 goto fail
  fc /b "%stage%\%%I.exe" "%output%\%%I.exe" >nul
  if errorlevel 1 goto fail
)
copy /b /y "%pending%" "%output%\addon-manifest.json" >nul
if errorlevel 1 goto fail
echo PASS published nine AMD64 addon utilities
exit /b 0
:driver
"%hash%" "%output%\%~1" >"%stage%\hash.txt"
if errorlevel 1 exit /b 1
set "digest="
set /p "digest=" <"%stage%\hash.txt"
if /i not "%digest%"=="%~2" exit /b 1
exit /b 0
:utility
"%identity%" --machine x64 "%build%\%~1\%~1.exe"
if errorlevel 1 exit /b 1
copy /b /y "%build%\%~1\%~1.exe" "%stage%\%~2" >nul
if errorlevel 1 exit /b 1
fc /b "%build%\%~1\%~1.exe" "%stage%\%~2" >nul
if errorlevel 1 exit /b 1
"%hash%" "%stage%\%~2" >"%stage%\hash.txt"
if errorlevel 1 exit /b 1
set "digest="
set /p "digest=" <"%stage%\hash.txt"
if not defined digest exit /b 1
>>"%pending%" echo %comma%{"id":"%~1","file":"%~2","architecture":"amd64","sha256":"%digest%","source":"src/addon/%~1/%~1.c","sourceSha256":"%~3"}
if errorlevel 1 exit /b 1
set "comma=,"
exit /b 0
:fail
if defined publishing if exist "%output%\addon-manifest.json" del /q "%output%\addon-manifest.json"
echo Addon utility publication failed; no successful delivery recorded. 1>&2
exit /b 1
