# Fixed test projections select current source bodies. They are neither
# original guest replacements nor a second implementation of those bodies.
function(ntvdm_source_projection output source start end preamble line_directive)
  file(READ "${source}" text)
  string(REPLACE "\r\n" "\n" text "${text}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  string(FIND "${text}" "${start}" begin)
  string(FIND "${text}" "${start}" last REVERSE)
  if(begin LESS 0 OR NOT begin EQUAL last)
    message(FATAL_ERROR "Missing or ambiguous projection start: ${source}")
  endif()
  if(end STREQUAL "")
    set(length -1)
  else()
    string(FIND "${text}" "${end}" finish)
    string(FIND "${text}" "${end}" last REVERSE)
    if(finish LESS begin OR NOT finish EQUAL last)
      message(FATAL_ERROR "Missing or ambiguous projection end: ${source}")
    endif()
    math(EXPR length "${finish}-${begin}")
  endif()
  if(line_directive)
    string(SUBSTRING "${text}" 0 ${begin} prefix)
    string(REGEX MATCHALL "\n" newlines "${prefix}")
    list(LENGTH newlines line)
    math(EXPR line "${line}+1")
    string(APPEND preamble "#line ${line} \"${source}\"\n")
  endif()
  string(SUBSTRING "${text}" ${begin} ${length} body)
  file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/${output}" CONTENT "${preamble}${body}" @ONLY)
  file(SHA256 "${source}" hash)
  get_filename_component(stem "${output}" NAME_WE)
  get_filename_component(directory "${output}" DIRECTORY)
  file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/${directory}/${stem}.sha256" CONTENT "${hash}\n" @ONLY)
endfunction()

function(ntvdm_guest_memory_projection output end)
  set(preamble)
  foreach(header IN ITEMS guest_memory_access.h guest_location.h guest_memory_lease.h host_context.h)
    string(APPEND preamble "#include \"${NTVDM_REPO}/src/compat/include/${header}\"\n")
  endforeach()
  string(APPEND preamble "#include <stddef.h>\n#include <string.h>\nint fixture_guest_read(void *, uint32_t, uint8_t *, uint32_t);\nint fixture_guest_write(void *, uint32_t, const uint8_t *, uint32_t);\n#define mvdm_softpc_guest_memory_read fixture_guest_read\n#define mvdm_softpc_guest_memory_write fixture_guest_write\n")
  ntvdm_source_projection("${output}"
    "${NTVDM_REPO}/src/mvdm-host/softpc.new/base/ccpu386/ccpusas4.c"
    "int ccpu_guest_memory_acquire(" "${end}" "${preamble}" TRUE)
endfunction()
