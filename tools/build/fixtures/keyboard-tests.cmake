function(keyboard_slice output source start finish include_finish)
  file(READ "${source}" text)
  string(REPLACE "\r\n" "\n" text "${text}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  string(FIND "${text}" "${start}" begin)
  string(FIND "${text}" "${start}" last REVERSE)
  if(begin LESS 0 OR NOT begin EQUAL last)
    message(FATAL_ERROR "Missing or ambiguous keyboard projection: ${output}")
  endif()
  string(SUBSTRING "${text}" ${begin} -1 tail)
  string(FIND "${tail}" "${finish}" length)
  if(length LESS 1)
    message(FATAL_ERROR "Missing keyboard projection end: ${output}")
  endif()
  if(include_finish)
    string(LENGTH "${finish}" extra)
    math(EXPR length "${length}+${extra}")
  endif()
  string(SUBSTRING "${tail}" 0 ${length} body)
  file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/${output}.inc" CONTENT "${body}" @ONLY)
endfunction()
function(keyboard_function output source signature)
  file(READ "${source}" text)
  string(REPLACE "\r\n" "\n" text "${text}")
  string(REGEX MATCH "${signature}\\([^;{]*\\)\n\\{" start "${text}")
  if(NOT start)
    message(FATAL_ERROR "Missing keyboard function definition: ${signature}")
  endif()
  keyboard_slice("${output}" "${source}" "${start}" "\n}" TRUE)
endfunction()
