# Current source contracts only; old commit comparisons belong to evidence.
set(construction_owner "${NTVDM_REPO}/src/mvdm-host/wow32")
function(construction_read output path)
  file(READ "${path}" text)
  string(REPLACE "\r\n" "\n" text "${text}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
  set(${output} "${text}" PARENT_SCOPE)
endfunction()
# These intervals intentionally select the first end after the named start.
# Repeated cases/finalizers are scoped to their containing current function.
function(construction_region output text start end)
  string(FIND "${text}" "${start}" begin)
  if(begin LESS 0)
    message(FATAL_ERROR "Construction interval missing: ${start}")
  endif()
  string(SUBSTRING "${text}" ${begin} -1 tail)
  string(FIND "${tail}" "${end}" finish)
  if(finish LESS 0)
    message(FATAL_ERROR "Construction interval end missing: ${end}")
  endif()
  string(LENGTH "${end}" length)
  math(EXPR length "${finish}+${length}")
  string(SUBSTRING "${tail}" 0 ${length} result)
  set(${output} "${result}" PARENT_SCOPE)
endfunction()
construction_read(wow "${NTVDM_REPO}/src/mvdm-host/inc/wow.h")
construction_read(header "${construction_owner}/wmdisp32.h")
construction_read(dispatch "${construction_owner}/wmdisp32.c")
construction_read(messages "${construction_owner}/wmsg16.c")
construction_read(aliases "${construction_owner}/walias.h")
construction_read(map "${construction_owner}/wparam.c")
set(types "#pragma pack(push,1)\n")
foreach(pair IN ITEMS
    "typedef struct _PARMWP|} PARM16, *PPARM16;"
    "typedef struct _POINT16|} POINT16;"
    "typedef struct _MSG16|} MSG16;"
    "typedef struct _CREATESTRUCT16|typedef CREATESTRUCT16 UNALIGNED *PCREATESTRUCT16;"
    "typedef struct _MDICREATESTRUCT16|typedef MDICREATESTRUCT16 UNALIGNED *PMDICREATESTRUCT16;"
    "typedef struct _RECT16|typedef RECT16 UNALIGNED *PRECT16;"
    "typedef struct _DROPSTRUCT16|typedef DROPSTRUCT16 UNALIGNED *PDROPSTRUCT16;"
    "typedef struct _MOUSEHOOKSTRUCT16|typedef MOUSEHOOKSTRUCT16 UNALIGNED *PMOUSEHOOKSTRUCT16;"
    "typedef struct _CBT_CREATEWND16|typedef CBT_CREATEWND16 UNALIGNED *PCBT_CREATEWND16;"
    "typedef struct _CBTACTIVATESTRUCT16|typedef CBTACTIVATESTRUCT16 UNALIGNED *PCBTACTIVATESTRUCT16;"
    "typedef struct _EVENTMSG16|typedef EVENTMSG16 UNALIGNED *PEVENTMSG16;")
  string(FIND "${pair}" "|" split)
  string(SUBSTRING "${pair}" 0 ${split} start)
  math(EXPR split "${split}+1")
  string(SUBSTRING "${pair}" ${split} -1 end)
  if(start STREQUAL "typedef struct _CBT_CREATEWND16")
    string(APPEND types "typedef VPVOID VPCREATESTRUCT16;\n")
  endif()
  construction_region(body "${wow}" "${start}" "${end}")
  string(APPEND types "${body}\n")
endforeach()
construction_region(body "${header}" "typedef struct _WM32MSGPARAMEX *LPWM32MSGPARAMEX;" "} WM32MSGPARAMEX;")
string(APPEND types "#pragma pack(pop)\n${body}\n")
foreach(name IN ITEMS WM_QUERYDROPOBJECT OLDCBEC_SETCOMBOFOCUS OLDCBEC_KILLCOMBOFOCUS)
  string(REGEX MATCH "#define ${name}[^\n]*" value "${wow}")
  if(value STREQUAL "")
    message(FATAL_ERROR "Construction constant missing: ${name}")
  endif()
  string(APPEND types "${value}\n")
endforeach()
string(APPEND types "#include \"compat/include/wow_control_message_abi.h\"\n")
construction_region(records "${aliases}" "typedef struct _THUNKTEXTDWORD" "#define MSG16NEEDSTHUNKING")
string(REPLACE "#define MSG16NEEDSTHUNKING" "" records "${records}")
construction_region(map_types "${map}" "typedef struct tagParamNode* LPPARAMNODE;" "MAPPARAM gParamMap;")
foreach(kind IN ITEMS construction transaction)
  set(directory "${CMAKE_BINARY_DIR}/message-${kind}")
  file(CONFIGURE OUTPUT "${directory}/message_construction_lifetime.h"
    CONTENT "#include \"compat/include/wow_message_lifetime.h\"\n" @ONLY)
  file(CONFIGURE OUTPUT "${directory}/message_construction_types.h" CONTENT "${types}" @ONLY)
  file(CONFIGURE OUTPUT "${directory}/message_construction_messages.h" CONTENT "${records}" @ONLY)
  file(CONFIGURE OUTPUT "${directory}/message_construction_map_types.h" CONTENT "${map_types}" @ONLY)
  set(pairs walloc16|stackalloc16 wparam|FindParamMap wparam|GetParam16
    wparam|AddParamMap wparam|ParamMapUpdateNode wparam|DeleteParamMap wparam|FreeParamMap
    wmdisp32|WM32MDICreate wmdisp32|WM32Create wmdisp32|WM32GetText wmdisp32|WM32SetText
    wmdisp32|WM32GetDlgCode wmdisp32|WM32AskCBFormatName wmdisp32|WM32WinHelp
    wmdisp32|WM32SizeClipBoard wmdisp32|WM32DropObject wcntl32|WM32CBDir)
  if(kind STREQUAL "transaction")
    foreach(name IN ITEMS WM32EMGetRect WM32EMSetRect WM32EMReplaceSel WM32EMGetLine
        WM32EMSetTabStops WM32CBAddString WM32CBGetLBText WM32CBGetDropDownControlRect
        WM32LBGetText WM32LBDir WM32LBGetSelItems WM32LBSetTabStops WM32LBGetItemRect WM32LBAddString)
      list(APPEND pairs "wcntl32|${name}")
    endforeach()
    list(APPEND pairs wcommdlg|WM32msgSHAREVIOLATION wowhooks|ThunkCbtHook
      wowhooks|GetEventMessage16 wowhooks|ThunkJournalHook wowhooks|ThunkMouseHook)
  endif()
  set(bodies "")
  foreach(pair IN LISTS pairs)
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 file)
    list(GET parts 1 name)
    ntvdm_function_body(body "${construction_owner}/${file}.c" "${name}")
    if(name STREQUAL "WM32EMGetLine")
      set(body "#pragma warning(push)\n#pragma warning(disable:4244)\n${body}\n#pragma warning(pop)")
    endif()
    string(APPEND bodies "${body}\n\n")
  endforeach()
  construction_region(body "${messages}" "    case WM_SETTEXT:" "    case WM_ACTIVATEAPP:")
  string(REPLACE "    case WM_ACTIVATEAPP:" "" body "${body}")
  string(APPEND bodies "BOOL FASTCALL ThunkWMMsg16(LPMSGPARAMEX lpmpex) { LONG lParam=lpmpex->Parm16.WndProc.lParam; PLONG plParamNew=&lpmpex->lParam; switch(lpmpex->Parm16.WndProc.wMsg) {\n${body}\n} return TRUE; }\n")
  ntvdm_function_body(release "${construction_owner}/wmsg16.c" UnThunkWMMsg16)
  construction_region(body "${release}" "    case WM_SETTEXT:" "    case WM_GETTEXT:")
  string(REPLACE "    case WM_GETTEXT:" "" body "${body}")
  string(APPEND bodies "VOID FASTCALL UnThunkWMMsg16(LPMSGPARAMEX lpmpex) { switch(lpmpex->Parm16.WndProc.wMsg) {\n${body}\n} }\n")
  foreach(name IN ITEMS ThunkCBMsg16 UnThunkCBMsg16)
    ntvdm_function_body(body "${construction_owner}/wmsgcb.c" "${name}")
    string(APPEND bodies "${body}\n\n")
  endforeach()
  string(FIND "${dispatch}" "#include \"compat/include/wow_worker_state.h\"" begin)
  if(begin LESS 0)
    message(FATAL_ERROR "Construction lifetime interval missing")
  endif()
  string(SUBSTRING "${dispatch}" ${begin} -1 lifetime)
  string(REGEX REPLACE "#include[^\n]*\n" "" lifetime "${lifetime}")
  string(APPEND bodies "${lifetime}\n")
  if(kind STREQUAL "transaction")
    construction_region(branch "${dispatch}" "    if (uMsg == EM_SCROLLCARET) {" "        return 0;   // notification message, no return code\n    }")
    set(marker "        stack.completed = TRUE; /* DIV-349: successful native-only notification. */")
    string(FIND "${branch}" "${marker}" found)
    if(found LESS 0)
      message(FATAL_ERROR "Successful notification must commit")
    endif()
    construction_read(dialog "${construction_owner}/wcommdlg.c")
    construction_region(dialog "${dialog}" "UINT APIENTRY\nWCD32CommonDialogProc(" "WCD32ChooseColor(PVDMFRAME")
    construction_region(filter "${dialog}" "            } else if(uMsg == msgWOWCHOOSEFONT) {" "            } else {")
    string(REPLACE "            } else {" "            }" filter "${filter}")
    string(REPLACE "            } else if(" "            if (" filter "${filter}")
    construction_region(finalizer "${dialog}" "    } __finally {" "\n}\n")
    string(APPEND bodies "static UINT fixture_common_dialog_filter(UINT uMsg,UINT msgWOWCHOOSEFONT) { wow_message_stack stack; WM32MSGPARAMEX wm32mpex = {0}; wow_message_stack_enter(&stack); __try {\n${filter}\nreturn 1;\n${finalizer}\n")
    construction_region(finalizer "${dispatch}" "    } __finally {" "\n}\n")
    foreach(variant IN ITEMS current omitted)
      set(selected "${branch}")
      if(variant STREQUAL "omitted")
        string(REPLACE "${marker}" "" selected "${selected}")
      endif()
      string(APPEND bodies "static LONG fixture_notification_${variant}(HWND hwnd,UINT uMsg,UINT uParam,LONG lParam) { wow_message_stack stack; WM32MSGPARAMEX wm32mpex = {0}; (void)uParam; (void)lParam; wow_message_stack_enter(&stack); __try {\n${selected}\nreturn -1;\n${finalizer}\n")
    endforeach()
    foreach(pair IN ITEMS wmsg16|ThunkMsg16 wmdisp32|W32Win16DlgProcEx wudlg|WU32IsDialogMessage)
      string(REPLACE "|" ";" parts "${pair}")
      list(GET parts 0 file)
      list(GET parts 1 name)
      ntvdm_function_body(body "${construction_owner}/${file}.c" "${name}")
      string(APPEND bodies "${body}\n\n")
    endforeach()
  endif()
  file(CONFIGURE OUTPUT "${directory}/message_construction_exact_body.h" CONTENT "${bodies}" @ONLY)
  set(target "wow-message-${kind}-contract")
  fixture(${target} CL test/observation/wow_message_construction_fixture.c)
  set_property(TARGET ${target}_objects PROPERTY COMPILE_OPTIONS /nologo /TC /O2 /W4 /WX /wd4700 /wd4701 /wd4706 /wd4127 /wd4213)
  target_include_directories(${target}_objects PRIVATE "${directory}")
  if(kind STREQUAL "transaction")
    target_compile_definitions(${target}_objects PRIVATE TRANSACTION_GROUP)
  endif()
endforeach()
