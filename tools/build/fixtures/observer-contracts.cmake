# Tests of maintained diagnostic observers, using their actual hook provider.
set(hook "${NTVDM_REPO}/src/lib-win32/process-hook")
if(NTVDM_ARCH STREQUAL "x86")
  set(decoder hde32)
else()
  set(decoder hde64)
endif()
foreach(kind IN ITEMS console palette guard-win101 guard-win31)
  if(kind MATCHES "^guard-" AND NOT NTVDM_ARCH STREQUAL "x86")
    continue()
  endif()
  if(kind STREQUAL "console")
    set(fixture_source console_trace_fixture)
    set(observer win31_console_trace)
  elseif(kind STREQUAL "palette")
    set(fixture_source palette_trace_fixture)
    set(observer win101_palette_trace)
  else()
    set(fixture_source install_guard_fixture)
    if(kind STREQUAL "guard-win101")
      set(observer win101_install_write_guard)
    else()
      set(observer win31_setup_write_guard)
    endif()
  endif()
  fixture(observer-${kind} CL "test/observation/fixtures/${fixture_source}.c"
    "test/observation/${observer}.c" "${hook}/startup_hooks.c"
    "${hook}/minhook/src/buffer.c" "${hook}/minhook/src/trampoline.c"
    "${hook}/minhook/src/hde/${decoder}.c")
  set_property(TARGET observer-${kind}_objects PROPERTY COMPILE_OPTIONS /nologo /std:c11 /W4 /we4013)
  target_compile_definitions(observer-${kind}_objects PRIVATE _WIN32_WINNT=0x0A00)
  set_property(TARGET observer-${kind}_objects PROPERTY FIXTURE_LIBRARIES kernel32.lib)
  if(kind STREQUAL "palette")
    set_property(TARGET observer-${kind}_objects PROPERTY FIXTURE_LIBRARIES kernel32.lib gdi32.lib)
  endif()
endforeach()
if(NTVDM_ARCH STREQUAL "x64")
  fixture(console-api-late CL test/observation/fixtures/console_api_late_fixture.c)
  set_property(TARGET console-api-late_objects PROPERTY COMPILE_OPTIONS /nologo /std:c11)
  set_property(TARGET console-api-late_objects PROPERTY FIXTURE_LIBRARIES user32.lib)
  add_custom_command(OUTPUT "${CMAKE_BINARY_DIR}/console-api/ntcon.exe"
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different console-api-late.exe console-api/ntcon.exe
    DEPENDS "${CMAKE_BINARY_DIR}/console-api-late.exe" VERBATIM)
  add_custom_target(console-api-late-contract DEPENDS console-api-probes "${CMAKE_BINARY_DIR}/console-api/ntcon.exe")
endif()
