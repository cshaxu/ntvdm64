if(NOT NTVDM_ARCH STREQUAL "x86")
  return()
endif()
set(original "${NTVDM_REPO}/src/mvdm-host/wow32")
set(bodies "")
foreach(pair IN ITEMS "walloc16|stackalloc16" "wdde|CopyDataAddNode"
    "wdde|CopyDataFindData16" "wdde|CopyDataFindData32" "wdde|CopyDataDeleteNode"
    "wmdisp32|WM32CopyData")
  string(REPLACE "|" ";" parts "${pair}")
  list(GET parts 0 file)
  list(GET parts 1 name)
  ntvdm_function_body(body "${original}/${file}.c" "${name}")
  string(APPEND bodies "${body}\n\n")
endforeach()
ntvdm_source_projection(copydata-stackfree.inc "${original}/walloc16.c"
  "#ifdef DEBUG\nVOID FASTCALL StackFree16" "" "" FALSE)
file(READ "${CMAKE_BINARY_DIR}/copydata-stackfree.inc" stackfree)
string(APPEND bodies "${stackfree}\n\n")
file(READ "${original}/wmsg16.c" text)
string(REPLACE "\r\n" "\n" text "${text}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}/wmsg16.c")
string(REGEX MATCHALL "    case WM_COPYDATA:" cases "${text}")
list(LENGTH cases count)
if(NOT count EQUAL 2)
  message(FATAL_ERROR "Expected thunk/unthunk COPYDATA cases")
endif()
foreach(kind IN ITEMS thunk unthunk)
  string(FIND "${text}" "    case WM_COPYDATA:" begin)
  string(SUBSTRING "${text}" ${begin} -1 tail)
  string(SUBSTRING "${tail}" 21 -1 rest)
  string(FIND "${rest}" "    case WM_" finish)
  if(finish LESS 0)
    message(FATAL_ERROR "COPYDATA case end missing")
  endif()
  math(EXPR length "${finish}+21")
  string(SUBSTRING "${tail}" 0 ${length} ${kind})
  string(SUBSTRING "${rest}" ${finish} -1 text)
endforeach()
string(APPEND bodies "BOOL FASTCALL ThunkWMMsg16(LPMSGPARAMEX lpmpex) { WORD wParam=lpmpex->Parm16.WndProc.wParam; LONG lParam=lpmpex->Parm16.WndProc.lParam; PLONG plParamNew=&lpmpex->lParam; switch(lpmpex->Parm16.WndProc.wMsg) {\n${thunk}\n} return TRUE; }\n#pragma warning(push)\n#pragma warning(disable:4189)\nVOID FASTCALL UnThunkWMMsg16(LPMSGPARAMEX lpmpex) { switch(lpmpex->Parm16.WndProc.wMsg) {\n${unthunk}\n} }\n#pragma warning(pop)\n")
foreach(pair IN ITEMS "wmsg16|ThunkMsg16" "wumsg|WU32PostAppMessage"
    "wowhooks|ThunkCallWndProcHook" "wowhooks|ThunkMsgFilterHook")
  string(REPLACE "|" ";" parts "${pair}")
  list(GET parts 0 file)
  list(GET parts 1 name)
  ntvdm_function_body(body "${original}/${file}.c" "${name}")
  if(name STREQUAL "ThunkMsgFilterHook")
    set(body "#pragma warning(push)\n#pragma warning(disable:4701 4703)\n${body}\n#pragma warning(pop)")
  endif()
  string(APPEND bodies "${body}\n\n")
endforeach()
ntvdm_source_projection(copydata-lifetime.inc "${original}/wmdisp32.c"
