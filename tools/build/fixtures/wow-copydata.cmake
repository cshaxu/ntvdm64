file(READ "${CMAKE_BINARY_DIR}/copydata-lifetime.inc" lifetime)
string(REGEX REPLACE "#include[^\r\n]*\r?\n" "" lifetime "${lifetime}")
string(APPEND bodies "${lifetime}")
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/copydata_exact_body.h" CONTENT "${bodies}" @ONLY)
