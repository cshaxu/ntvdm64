if(NOT NTVDM_ARCH STREQUAL "x86")
  return()
endif()
foreach(pair IN ITEMS "Control|ccpu_control_probe.asm" "SignFlags|ccpu_sign_flag_probe.asm"
    "BitMemory|ccpu_bit_memory_probe.asm" "BiosDispatch|bios_dispatch_probe.asm"
    "DummyInt|bios_dispatch_probe.asm" "SystemDevices|system_capability.asm"
    "DiskReset|disks_capability.asm" "VideoInvalid|bios_dispatch_probe.asm"
    "SlaveBios|slave_bios_vector_probe.asm" "RtcEntry|rtc_entry_probe.asm" "RtcAlarm|rtc_alarm_probe.asm")
  string(REPLACE "|" ";" parts "${pair}")
  list(GET parts 0 name)
  list(GET parts 1 source)
  set(flags)
  if(name STREQUAL "DummyInt")
    list(APPEND flags -DCPU_PROBE_DUMMY_INT_ONLY=1)
  elseif(name STREQUAL "VideoInvalid")
    list(APPEND flags -DCPU_PROBE_VIDEO_INVALID_ONLY=1)
  endif()
  guest_probe(cpu-integration "${name}.COM" "${source}" ${flags})
  if(NOT name MATCHES "^(BitMemory|SlaveBios|RtcEntry|RtcAlarm)$")
    guest_probe(cpu-integration "${name}-negative.COM" "${source}" ${flags} -DCPU_PROBE_NEGATIVE_ORACLE=1)
  endif()
endforeach()
guest_probe(cpu-integration Transfer.COM ccpu_transfer_probe.asm)
guest_probe(cpu-integration Transfer-negative.COM ccpu_transfer_probe.asm -DCPU_TRANSFER_NEGATIVE=1)
guest_probe(cpu-integration Alu.COM ccpu_alu_probe.asm)
guest_probe(cpu-integration CallReturn.COM ems_call_return_probe.asm)
guest_probe(cpu-integration Mapping.COM ems_mapping_probe.asm)
guest_probe(cpu-integration PICIRQ.COM pic_reset_eoi_guest.asm)
get_property(outputs GLOBAL PROPERTY guest_cpu-integration)
add_custom_target(cpu-guest-probes DEPENDS ${outputs})
set(NTVDM_SERIAL_MASK "0" CACHE STRING "Expected COM1-COM9 bit mask")
if(NOT NTVDM_SERIAL_MASK MATCHES "^(0|[1-9][0-9]?[0-9]?)$" OR NTVDM_SERIAL_MASK GREATER 511)
  message(FATAL_ERROR "Serial mask must be a decimal integer from 0 through 511")
endif()
guest_probe(serial-discovery S45VCD.COM dpmi_vcd_serial_ports.asm "-DEXPECT_PORT_MASK=${NTVDM_SERIAL_MASK}")
get_property(serial_outputs GLOBAL PROPERTY guest_serial-discovery)
add_custom_target(serial-discovery DEPENDS ${serial_outputs})
