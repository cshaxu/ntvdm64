# Explicit opt-in upstream comparison; never a product build input.
set(NTVDM_MEDIA_ORIGINAL_ROOT "" CACHE PATH "Read-only original MVDM media-owner source")
if(NOT NTVDM_ARCH STREQUAL "x86" OR NOT NTVDM_MEDIA_ORIGINAL_ROOT)
  return()
endif()
function(media_owner_projection source start end output)
  file(READ "${source}" text)
  string(REPLACE "\r\n" "\n" text "${text}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  string(FIND "${text}" "${start}" begin)
  string(FIND "${text}" "${start}" last REVERSE)
  if(begin LESS 0 OR NOT begin EQUAL last)
    message(FATAL_ERROR "Media owner start missing or ambiguous: ${source}")
  endif()
  string(SUBSTRING "${text}" ${begin} -1 remainder)
  string(FIND "${remainder}" "${end}" length)
  if(length LESS 0)
    message(FATAL_ERROR "Media owner end missing: ${source}")
  endif()
  string(LENGTH "${end}" extra)
  math(EXPR length "${length}+${extra}")
  string(SUBSTRING "${remainder}" 0 ${length} body)
  file(CONFIGURE OUTPUT "${output}" CONTENT "${body}" @ONLY NEWLINE_STYLE LF)
endfunction()
foreach(kind current original)
  if(kind STREQUAL "current")
    set(source "${NTVDM_REPO}/src/mvdm-host")
  else()
    set(source "${NTVDM_MEDIA_ORIGINAL_ROOT}")
  endif()
  set(output "${CMAKE_BINARY_DIR}/media-owner/${kind}")
  file(MAKE_DIRECTORY "${output}")
  media_owner_projection("${source}/dos/dem/demgset.c" "BOOL\nGetMediaId(" "return TRUE;\n}" "${output}/dem-media-body.inc")
  media_owner_projection("${source}/dos/dem/dosdef.h" "#pragma pack(1)\n\ntypedef struct _VOLINFO" "typedef VOLINFO *PVOLINFO;" "${output}/dem-media-type.inc")
  fixture(media-owner-${kind} CL test/mvdm/oemuni/oemuni_media_fixture.c)
  set_property(TARGET media-owner-${kind}_objects PROPERTY COMPILE_OPTIONS /nologo /W4)
  target_include_directories(media-owner-${kind}_objects PRIVATE "${output}")
endforeach()
add_custom_target(media-owner DEPENDS media-owner-current media-owner-original)
