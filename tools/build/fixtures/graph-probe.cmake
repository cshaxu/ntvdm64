function(ntvdm_graph_probe output)
  set(input "${NTVDM_REPO}/test/observation/wow_page_cost_probe.h")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
  file(READ "${input}" original)
  string(REGEX MATCHALL "\"ntvdm.exe\"" modules "${original}")
  string(REGEX MATCHALL "data.version != 1 \\|\\|" checks "${original}")
  list(LENGTH modules module_count)
  list(LENGTH checks check_count)
  if(NOT module_count EQUAL 1 OR NOT check_count EQUAL 1)
    message(FATAL_ERROR "Graph probe boundaries changed")
  endif()
  string(REPLACE "\"ntvdm.exe\"" "\"WOW32.DLL\"" body "${original}")
  string(REPLACE "data.version != 1 ||" "data.version != 1 || data.reserved != 0 ||" body "${body}")
  file(CONFIGURE OUTPUT "${output}" CONTENT "${body}" @ONLY NEWLINE_STYLE LF)
endfunction()
