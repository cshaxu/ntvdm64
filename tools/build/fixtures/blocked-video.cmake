set(video_source "${NTVDM_REPO}/src/mvdm-host/softpc.new/host/src/nt_graph.c")
file(READ "${video_source}" video_text)
string(REPLACE "\r\n" "\n" video_text "${video_text}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${video_source}")
set(video_body)
foreach(signature IN ITEMS "static void publish_text_update(void)" "void nt_graphics_tick(void)" "void nt_flush_screen(void)")
  string(FIND "${video_text}" "${signature}\n{" begin)
  string(FIND "${video_text}" "${signature}\n{" last REVERSE)
  if(begin LESS 0 OR NOT begin EQUAL last)
    message(FATAL_ERROR "Missing or ambiguous video function: ${signature}")
  endif()
  string(SUBSTRING "${video_text}" ${begin} -1 rest)
  # Selected source functions use column-zero closing braces only at top level.
  string(FIND "${rest}" "\n}\n" end)
  if(end LESS 0)
    message(FATAL_ERROR "Missing video function boundary: ${signature}")
  endif()
  math(EXPR length "${end}+2")
  string(SUBSTRING "${rest}" 0 ${length} body)
  string(APPEND video_body "${body}\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/blocked_video_tick.inc" CONTENT "${video_body}" @ONLY)
fixture(blocked-video-tick CL test/ntvdm-exe/softpc/blocked_video_tick_test.c)
set_property(TARGET blocked-video-tick_objects PROPERTY COMPILE_OPTIONS /nologo /O2 /W4 /WX /TC)
target_include_directories(blocked-video-tick_objects PRIVATE "${CMAKE_BINARY_DIR}")
