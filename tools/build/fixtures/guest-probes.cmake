# Independently authored observation binaries, never original guest rebuilds.
find_program(NTVDM_NASM NAMES nasm.exe REQUIRED)
function(guest_probe group filename source)
  set(input "${NTVDM_REPO}/test/observation/${source}")
  set(directory "${CMAKE_BINARY_DIR}/guest-probes/${group}")
  set(output "${directory}/${filename}")
  file(MAKE_DIRECTORY "${directory}")
  add_custom_command(OUTPUT "${output}"
    COMMAND "${NTVDM_NASM}" -f bin ${ARGN} -o "${output}" "${input}"
    DEPENDS "${input}" "${NTVDM_NASM}" VERBATIM)
  set_property(GLOBAL APPEND PROPERTY "guest_${group}" "${output}")
  set_property(GLOBAL APPEND PROPERTY guest_outputs "${output}")
endfunction()

