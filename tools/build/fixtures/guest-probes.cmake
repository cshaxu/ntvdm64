# Profile-bound witnesses shared by the Win31 setup and Win95 launch matrices.
if(NTVDM_WIN31_INSTALL)
  string(LENGTH "${NTVDM_WIN31_INSTALL}" path_length)
  if(NOT NTVDM_WIN31_INSTALL MATCHES "^[A-Za-z]:[\\/][A-Za-z0-9_ .:/\\-]+$" OR path_length GREATER 100)
    message(FATAL_ERROR "Invalid short ASCII Win31 fixture installation path")
  endif()
  set(install "-DW31_INSTALL='${NTVDM_WIN31_INSTALL}'")
  guest_probe(win31-profile SCHED.COM ../integration/multitask/win31-scheduling-child.asm "${install}")
  guest_probe(win31-profile FULLKEY.COM win31_fullscreen_key.asm "${install}")
  guest_probe(win31-profile RUNA.COM win31_dos_pair.asm "${install}" "-DROLE='A'" "-DPEER='B'")
  guest_probe(win31-profile RUNB.COM win31_dos_pair.asm "${install}" "-DROLE='B'" "-DPEER='A'")
  guest_probe(win31-profile PROMPT.EXE win31_startup_contract.asm "${install}" -DW31_PROMPT_CHECK)
  guest_probe(win31-profile PAIR.EXE win31_startup_contract.asm "${install}" -DW31_PROMPT_CHECK -DW31_PROMPT_PAIR)
  guest_probe(win31-profile SCHEDULE.EXE win31_startup_contract.asm "${install}" -DW31_PROMPT_CHECK -DW31_SCHEDULING_CHECK)
  guest_probe(win31-profile INTERACT.EXE win31_startup_contract.asm "${install}" -DW31_PROMPT_CHECK -DW31_SCHEDULING_CHECK -DW31_SCHEDULING_INTERACTIVE)
  get_property(profile_outputs GLOBAL PROPERTY guest_win31-profile)
  add_custom_target(win31-profile DEPENDS ${profile_outputs})
endif()
