if(NOT NTVDM_ARCH STREQUAL "x86")
  return()
endif()
set(owner "${NTVDM_REPO}/src/mvdm-host/wow32")
construction_read(source "${owner}/mapembed.c")
set(bodies "")
foreach(name IN ITEMS UpdateEmbeddingAllKeys UpdateClassesRootSubKey)
  construction_region(body "${source}" "VOID\n${name}(" "\n}")
  string(APPEND bodies "${body}\n\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/embedding_exact.h" CONTENT "${bodies}" @ONLY)
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/embedding_provider_path.h" CONTENT "#include \"${NTVDM_REPO}/src/compat/mvdm_shadow_registry.c\"\n" @ONLY)
set(bodies "")
foreach(name IN ITEMS SortedInsert BuildStrList GetSupportedFaxDrivers BuildPath InstallWowFaxPrinter)
  ntvdm_function_body(body "${owner}/wow32fax.c" "${name}")
  string(APPEND bodies "${body}\n\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/fax_exact.h" CONTENT "${bodies}" @ONLY)
construction_read(header "${NTVDM_REPO}/src/mvdm-host/inc/wowgdi.h")
set(bodies "")
set(types "")
foreach(name IN ITEMS GetFontData GetGlyphOutline GetKerningPairs)
  ntvdm_function_body(body "${owner}/wgdi31.c" "WG32${name}")
  string(APPEND bodies "${body}\n\n")
  string(TOUPPER "${name}16" type)
  construction_region(record "${header}" "typedef struct _${type}" "typedef ${type} UNALIGNED *P${type};")
  string(APPEND types "${record}\n\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/font_exact.h" CONTENT "${bodies}" @ONLY)
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/font_types.h" CONTENT "${types}" @ONLY)
ntvdm_function_body(body "${owner}/wgpal.c" WG32GetPaletteEntries)
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/original-getpaletteentries.inc" CONTENT "${body}\n" @ONLY)
ntvdm_function_body(body "${owner}/wstruc.c" putpaletteentry16)
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/original-putpaletteentry.inc" CONTENT "${body}\n" @ONLY)
foreach(kind IN ITEMS embedding_root fax_failure font_output palette_output)
  fixture(wow-output-${kind} CL "test/integration/wow_${kind}_test.c")
  set_property(TARGET wow-output-${kind}_objects PROPERTY COMPILE_OPTIONS /nologo /TC /O2)
  target_compile_definitions(wow-output-${kind}_objects PRIVATE _CRT_SECURE_NO_WARNINGS)
  target_include_directories(wow-output-${kind}_objects PRIVATE "${CMAKE_BINARY_DIR}")
endforeach()
set_property(TARGET wow-output-embedding_root_objects PROPERTY FIXTURE_LIBRARIES advapi32.lib ntdll.lib user32.lib)
foreach(kind IN ITEMS font_output palette_output)
  target_compile_options(wow-output-${kind}_objects PRIVATE /W4 /WX)
  set_property(TARGET wow-output-${kind}_objects PROPERTY FIXTURE_LIBRARIES gdi32.lib user32.lib)
endforeach()
add_custom_target(wow-output-contracts DEPENDS wow-output-embedding_root wow-output-fax_failure wow-output-font_output wow-output-palette_output)
