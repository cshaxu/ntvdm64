if(NOT NTVDM_ARCH STREQUAL "x86")
  return()
endif()
construction_read(page "${NTVDM_REPO}/src/compat/mvdm_softpc_wow_page_domain.c")
set(bodies "")
foreach(pair IN ITEMS
    "static int __cdecl compare_class_reference(|int mvdm_softpc_wow_page_domain_collect_observed_classes("
    "static int copy_current_window_view(|int mvdm_softpc_wow_page_domain_copy_window_view(")
  string(REPLACE "|" ";" parts "${pair}")
  list(GET parts 0 start)
  list(GET parts 1 end)
  construction_region(body "${page}" "${start}" "${end}")
  string(REPLACE "${end}" "" body "${body}")
  string(APPEND bodies "${body}")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/class_copy_body.h" CONTENT "${bodies}" @ONLY)
set(bodies "")
foreach(name IN ITEMS publish_guest_return publish_scheduled_return)
  ntvdm_function_body(body "${NTVDM_REPO}/src/compat/wow_user_task_lifecycle.c" "${name}")
  string(APPEND bodies "${body}\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/native_wait_publication_body.h" CONTENT "${bodies}" @ONLY)
foreach(kind IN ITEMS class_copy native_wait_publication)
  if(kind STREQUAL "class_copy")
    set(source wow_class_copy_unwind_fixture.c)
  else()
    set(source wow_native_wait_publication_fixture.c)
  endif()
  fixture(wow-unwind-${kind} CL "test/observation/${source}")
  set_property(TARGET wow-unwind-${kind}_objects PROPERTY COMPILE_OPTIONS /nologo /TC /O2 /W4 /WX)
  target_include_directories(wow-unwind-${kind}_objects PRIVATE "${CMAKE_BINARY_DIR}" "${NTVDM_REPO}/src")
  set_property(TARGET wow-unwind-${kind}_objects PROPERTY FIXTURE_LIBRARIES user32.lib)
endforeach()
add_custom_target(wow-return-unwind DEPENDS wow-unwind-class_copy wow-unwind-native_wait_publication)
