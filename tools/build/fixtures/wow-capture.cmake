if(NOT NTVDM_ARCH STREQUAL "x86")
  return()
endif()
set(capture_owner "${NTVDM_REPO}/src/compat/wow_window_capture.c")
set(capture_bodies "")
foreach(name IN ITEMS wow_native_window_observation_edge wow_native_window_normalize_chains)
  ntvdm_function_body(body "${capture_owner}" "${name}")
  string(APPEND capture_bodies "${body}\n\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/chain_exact_body.h" CONTENT "${capture_bodies}" @ONLY)
set(capture_bodies "")
foreach(name IN ITEMS wow_user_window_sample_links wow_native_window_capture
    wow_native_window_observation_put wow_native_window_observation_edge
    wow_native_window_normalize_chains)
  ntvdm_function_body(body "${capture_owner}" "${name}")
  string(APPEND capture_bodies "${body}\n\n")
endforeach()
foreach(name IN ITEMS project_graph_attempt project_graph)
  ntvdm_function_body(body "${NTVDM_REPO}/src/compat/wow_user_object_bindings.c" "${name}")
  string(APPEND capture_bodies "${body}\n\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/capture_exact_body.h" CONTENT "${capture_bodies}" @ONLY)
foreach(kind IN ITEMS chain reacquire)
  if(kind STREQUAL "chain")
    set(source wow_native_chain_capture_fixture.c)
  else()
    set(source wow_native_capture_reacquire_fixture.c)
  endif()
  fixture(wow-capture-${kind} CL "test/observation/${source}")
  set_property(TARGET wow-capture-${kind}_objects PROPERTY COMPILE_OPTIONS /nologo /TC /O2 /W4 /WX)
  target_include_directories(wow-capture-${kind}_objects PRIVATE "${CMAKE_BINARY_DIR}")
  set_property(TARGET wow-capture-${kind}_objects PROPERTY FIXTURE_LIBRARIES user32.lib)
endforeach()
