if(NOT NTVDM_ARCH STREQUAL "x86")
  return()
endif()
set(dde_source "${NTVDM_REPO}/src/mvdm-host/wow32")
ntvdm_source_projection(dde-types.inc "${dde_source}/wdde.h"
  "typedef struct _HDDE {" "} DDEINFO, *PDDEINFO;" "" FALSE)
ntvdm_source_projection(dde-conversion.inc "${dde_source}/wdde.h"
  "typedef struct _DDECONVERSIONPAIR" "} DDECONVERSION, *PDDECONVERSION;" "" FALSE)
file(READ "${CMAKE_BINARY_DIR}/dde-types.inc" types)
file(READ "${CMAKE_BINARY_DIR}/dde-conversion.inc" conversion)
file(READ "${dde_source}/wdde.h" header)
string(REGEX MATCHALL "#define DDE_[^\r\n]+" flags "${header}")
list(LENGTH flags count)
if(NOT count EQUAL 4)
  message(FATAL_ERROR "DDE flag family changed")
endif()
string(JOIN "\n" flags ${flags})
set(types "${types}} DDEINFO, *PDDEINFO;\n#define FIXTURE_CONVERSION 1\n${conversion}} DDECONVERSION, *PDDECONVERSION;\n${flags}\n")
foreach(name IN ITEMS dde_alias_types.h execute_types.h)
  file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/${name}" CONTENT "${types}" @ONLY)
endforeach()
file(READ "${dde_source}/wdde.c" source)
if(source MATCHES "BOOL[ \t\n]+W32MarkDDEHandle[ \t]*\\(")
  set(mark BOOL)
else()
  set(mark VOID)
endif()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/dde_alias_mark_prototype.h"
  CONTENT "static ${mark} W32MarkDDEHandle(HAND16);\n" @ONLY)
set(bodies "")
foreach(name IN ITEMS DDEAddhandle DDEDeletehandle DDEFindPair16 DDEFindPair32
    DDEFindNode16 DDEFindNode32 DDEFindAckNode W32MarkDDEHandle W32UnMarkDDEHandle
    W32DDEFreeGlobalMem32 W32DdeFreeHandle16 DDETrackhandle DDERollback32)
  ntvdm_function_body(body "${dde_source}/wdde.c" "${name}")
  string(APPEND bodies "${body}\n\n")
endforeach()
ntvdm_function_body(post "${dde_source}/wumsg.c" WU32PostMessage)
string(FIND "${post}" "DWORD error = GetLastError();" begin)
string(FIND "${post}" "\n    }\n#line " finish REVERSE)
if(begin LESS 0 OR finish LESS begin)
  message(FATAL_ERROR "DDE PostMessage cleanup boundary changed")
endif()
math(EXPR length "${finish}-${begin}")
string(SUBSTRING "${post}" ${begin} ${length} cleanup)
string(REPLACE "wow_message_unwind16(&mpex);" "" cleanup "${cleanup}")
string(REPLACE "mpex." "mpex->" cleanup "${cleanup}")
string(REPLACE "&postConversion" "conversion" cleanup "${cleanup}")
string(APPEND bodies "static VOID W32CancelDDEPost(LPMSGPARAMEX mpex, PDDECONVERSION conversion){\n${cleanup}\n}\n")
ntvdm_function_body(body "${dde_source}/wmdisp32.c" WM32DDEAck)
string(APPEND bodies "${body}\n")
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/dde_alias_exact_bodies.h" CONTENT "${bodies}" @ONLY)
file(READ "${dde_source}/wmsg16.c" text)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${dde_source}/wmsg16.c")
string(REPLACE "\r\n" "\n" text "${text}")
string(FIND "${text}" "    case WM_DDE_EXECUTE:" begin)
if(begin LESS 0)
  message(FATAL_ERROR "DDE EXECUTE case missing")
endif()
string(SUBSTRING "${text}" ${begin} -1 tail)
string(FIND "${tail}" "    case WM_COPYDATA:" finish)
if(finish LESS 0)
  message(FATAL_ERROR "DDE EXECUTE case end missing")
endif()
string(SUBSTRING "${tail}" 0 ${finish} body)
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/execute_body.h"
  CONTENT "static BOOL execute(LPMSGPARAMEX lpmpex,INT fWhoCalled){WORD wParam=lpmpex->Parm16.WndProc.wParam;LONG lParam=lpmpex->Parm16.WndProc.lParam;PLONG plParamNew=&lpmpex->lParam;switch(lpmpex->Parm16.WndProc.wMsg){\n${body}\n}return TRUE;}\n" @ONLY)
fixture(wow-dde-alias CL test/observation/wow_dde_alias_fixture.c)
set_property(TARGET wow-dde-alias_objects PROPERTY COMPILE_OPTIONS /nologo /TC /O2 /Gz /W4 /WX /wd4127 /wd4213 /wd4305 /wd4706)
fixture(wow-dde-execute CL test/observation/wow_dde_execute_fixture.c)
set_property(TARGET wow-dde-execute_objects PROPERTY COMPILE_OPTIONS /nologo /TC /O2 /W4)
foreach(name IN ITEMS wow-dde-alias wow-dde-execute)
  target_include_directories(${name}_objects PRIVATE "${CMAKE_BINARY_DIR}")
endforeach()
add_custom_target(wow-dde DEPENDS wow-dde-alias wow-dde-execute)
foreach(direction IN ITEMS 16 32)
  ntvdm_function_body(body "${dde_source}/wdde.c" "DDECopyhData${direction}")
  file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/conversion${direction}-body.h" CONTENT "${body}" @ONLY)
  fixture(wow-dde-conversion${direction} CL "test/observation/wow_dde_conversion${direction}_fixture.c")
  set_property(TARGET wow-dde-conversion${direction}_objects PROPERTY COMPILE_OPTIONS /nologo /TC /O2)
  target_include_directories(wow-dde-conversion${direction}_objects PRIVATE "${CMAKE_BINARY_DIR}")
endforeach()
