if(NOT NTVDM_ARCH STREQUAL "x86")
  return()
endif()
set(dib_source "${NTVDM_REPO}/src/mvdm-host/wow32/wdib.c")
construction_read(dib "${dib_source}")
construction_region(owner "${dib}" "HDC W32HandleDibDrv" "BOOL W32AddDibInfo")
construction_region(cleanup "${owner}" "finally {" "\n    return hdcMem;")
string(REGEX REPLACE "^finally " "" cleanup "${cleanup}")
string(REPLACE "\n    return hdcMem;" "" cleanup "${cleanup}")
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/dib_failure_cleanup.h" CONTENT "${cleanup}" @ONLY)
set(bodies "")
foreach(name IN ITEMS W32FreeDibInfoHandle W32CheckAndFreeDibInfo W32FreeDibInfo W32FindAndLockDibInfo WK32FindAndReleaseDib)
  ntvdm_function_body(body "${dib_source}" "${name}")
  string(APPEND bodies "${body}\n\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/dib_retirement_exact.h" CONTENT "${bodies}" @ONLY)
construction_read(header "${NTVDM_REPO}/src/mvdm-host/wow32/wdib.h")
construction_region(types "${header}" "typedef struct _DIBINFO" "} DIBINFO, *PDIBINFO;")
construction_read(header "${NTVDM_REPO}/src/mvdm-host/inc/wowkrn.h")
construction_region(record "${header}" "typedef struct _FINDANDRELEASEDIB16" "typedef FINDANDRELEASEDIB16 UNALIGNED *PFINDANDRELEASEDIB16;")
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/dib_retirement_types.h" CONTENT "${types}\n${record}" @ONLY)
foreach(kind IN ITEMS failure_cleanup retirement)
  fixture(wow-dib-${kind} CL "test/integration/wow_dib_${kind}_test.c")
  set_property(TARGET wow-dib-${kind}_objects PROPERTY COMPILE_OPTIONS /nologo /TC /O2 /W4 /WX)
  target_compile_definitions(wow-dib-${kind}_objects PRIVATE _CRT_SECURE_NO_WARNINGS)
  target_include_directories(wow-dib-${kind}_objects PRIVATE "${CMAKE_BINARY_DIR}")
  set_property(TARGET wow-dib-${kind}_objects PROPERTY FIXTURE_LIBRARIES gdi32.lib user32.lib)
endforeach()
add_custom_target(wow-dib-contracts DEPENDS wow-dib-failure_cleanup wow-dib-retirement)
