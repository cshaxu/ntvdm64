# Existing ThunkNLS unit: project only the current production initialization.
set(nls_source "${NTVDM_REPO}/src/mvdm-host/wow32/wow32.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${nls_source}")
file(READ "${nls_source}" nls_text)
set(nls_start "    cb = sizeof(fThunkStrRtns);")
string(FIND "${nls_text}" "${nls_start}" begin)
string(FIND "${nls_text}" "${nls_start}" last REVERSE)
if(begin LESS 0 OR NOT begin EQUAL last)
  message(FATAL_ERROR "ThunkNLS initialization boundary changed")
endif()
string(SUBSTRING "${nls_text}" ${begin} -1 remainder)
string(FIND "${remainder}" "#ifdef DEBUG" length)
if(length LESS 1)
  message(FATAL_ERROR "ThunkNLS initialization end missing")
endif()
string(SUBSTRING "${remainder}" 0 ${length} BODY)
configure_file("${NTVDM_REPO}/test/mvdm-host/wow_thunk_nls_fixture.c.in"
  "${CMAKE_BINARY_DIR}/wow-thunk-nls.c" @ONLY NEWLINE_STYLE LF)
