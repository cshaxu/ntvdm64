if(NOT NTVDM_ARCH STREQUAL "x86")
  return()
endif()
construction_read(font_source "${NTVDM_REPO}/src/mvdm-host/softpc.new/host/src/nt_fulsc.c")
construction_region(font_body "${font_source}" "GLOBAL VOID calcScreenParams IFN2( USHORT *, pCharHeight, USHORT *, pVgaHeight )\n{" "\n}")
ntvdm_function_body(startup_body "${NTVDM_REPO}/src/ntvdm-exe/softpc/mvdm_standalone_worker.c" begin_character_io)
foreach(kind IN ITEMS font startup)
  foreach(case IN ITEMS fixed regression-control)
    set(CALLBACK "${${kind}_body}")
    if(case STREQUAL "regression-control")
      if(kind STREQUAL "font")
        string(REGEX REPLACE "[ \t\n]*if \\(charHeight != get_char_height\\(\\)\\)[ \t\n]*\\{[^}]*\\}" "" CALLBACK "${CALLBACK}")
      else()
        string(REPLACE "CONSOLE_WINDOW_PRESENTATION_ONLY" "CONSOLE_WINDOW_TEXT_FRAME_REQUIRED" CALLBACK "${CALLBACK}")
      endif()
      if(CALLBACK STREQUAL "${${kind}_body}")
        message(FATAL_ERROR "Missing current ${kind} correction for negative control")
      endif()
    endif()
    set(output "${CMAKE_BINARY_DIR}/presentation-${kind}-${case}.c")
    configure_file("${NTVDM_REPO}/test/ntvdm-exe/softpc/presentation_${kind}.c.in" "${output}" @ONLY)
    fixture(presentation-${kind}-${case} CL "${output}")
    if(kind STREQUAL "font")
      set_property(TARGET presentation-${kind}-${case}_objects PROPERTY COMPILE_OPTIONS /nologo /W3)
    else()
      set_property(TARGET presentation-${kind}-${case}_objects PROPERTY COMPILE_OPTIONS /nologo /W4 /WX)
    endif()
  endforeach()
  add_custom_target(presentation-contract-${kind} DEPENDS presentation-${kind}-fixed presentation-${kind}-regression-control)
endforeach()
add_custom_target(presentation-contract-all DEPENDS presentation-contract-font presentation-contract-startup)
