if(NOT NTVDM_ARCH STREQUAL "x86")
  return()
endif()
set(test "${NTVDM_REPO}/test/observation")
set(root "${CMAKE_BINARY_DIR}/guest-probes/latency")
include(graph-probe.cmake)
set(graph "${root}/graph")
file(MAKE_DIRECTORY "${graph}")
foreach(name wow_mine_latency_probe.c wow_mine_gameplay_probe.c wow_page_cost_data.h)
  configure_file("${test}/${name}" "${graph}/${name}" COPYONLY)
endforeach()
ntvdm_graph_probe("${graph}/wow_page_cost_probe.h")
set(targets)
foreach(mask IN ITEMS 0 1 2 8 9 10 12 14 17 25)
  set(source "${test}/wow_mine_latency_probe.c")
  if(mask GREATER_EQUAL 16)
    set(source "${graph}/wow_mine_latency_probe.c")
  endif()
  set(name wow-latency-${mask})
  fixture(${name} CL "${source}")
  set_property(TARGET ${name}_objects PROPERTY COMPILE_OPTIONS /nologo /O2 /W3 /D_CRT_SECURE_NO_WARNINGS)
  foreach(pair IN ITEMS "1|PAGE_COST_PROFILE" "2|OBSERVER_COST" "4|CALLBACK_COST" "8|CALLBACK_WORKLOAD")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 bit)
    list(GET parts 1 define)
    math(EXPR enabled "${mask} & ${bit}")
    if(enabled)
      target_compile_definitions(${name}_objects PRIVATE "T447_${define}")
    endif()
  endforeach()
  set_property(TARGET ${name}_objects PROPERTY FIXTURE_LIBRARIES user32.lib gdi32.lib dwmapi.lib)
  list(APPEND targets ${name})
endforeach()
fixture(wow-native-sample CL test/observation/wow_native_pc_sample.c)
set_property(TARGET wow-native-sample_objects PROPERTY COMPILE_OPTIONS /nologo /O2 /W3 /D_CRT_SECURE_NO_WARNINGS)
set_property(TARGET wow-native-sample_objects PROPERTY FIXTURE_LIBRARIES user32.lib)
add_custom_target(wow-latency-probes DEPENDS ${targets} wow-native-sample)
