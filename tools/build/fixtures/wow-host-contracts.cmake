ntvdm_function_body(clipboard_body "${NTVDM_REPO}/src/mvdm-host/wow32/wuclip.c" WU32SetClipboardData)
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/selected-set-clipboard.inc" CONTENT "${clipboard_body}" @ONLY)
set(keyboard_body "")
foreach(name IN ITEMS WKB32ToAscii WKB32MapVirtualKey)
  ntvdm_function_body(body "${NTVDM_REPO}/src/mvdm-host/wow32/wkbman.c" "${name}")
  if(NOT keyboard_body STREQUAL "")
    string(APPEND keyboard_body "\n")
  endif()
  string(APPEND keyboard_body "${body}")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/selected-keyboard.inc" CONTENT "${keyboard_body}" @ONLY)
foreach(pair IN ITEMS "clipboard|wow_clipboard_format_fixture.c" "keyboard|wow_keyboard_boundary_fixture.c")
  string(REPLACE "|" ";" parts "${pair}")
  list(GET parts 0 name)
  list(GET parts 1 source)
  fixture(wow-boundary-${name} CL "test/adapter-mvdm-host-out/wow/${source}")
  set_property(TARGET wow-boundary-${name}_objects PROPERTY COMPILE_OPTIONS /nologo /TC /W3 /O2)
  target_include_directories(wow-boundary-${name}_objects PRIVATE
    "${CMAKE_BINARY_DIR}" "${NTVDM_REPO}/src/mvdm-host/inc")
  set_property(TARGET wow-boundary-${name}_objects PROPERTY FIXTURE_LIBRARIES user32.lib)
endforeach()
add_custom_target(wow-controlled-boundaries DEPENDS wow-boundary-clipboard wow-boundary-keyboard)
