# Current reverse-message ownership contracts; historical failures stay in evidence.
function(reverse_slice output text start end)
  construction_region(body "${text}" "${start}" "${end}")
  string(LENGTH "${body}" size)
  string(LENGTH "${end}" suffix)
  math(EXPR size "${size}-${suffix}")
  string(SUBSTRING "${body}" 0 ${size} body)
  set(${output} "${body}" PARENT_SCOPE)
endfunction()
