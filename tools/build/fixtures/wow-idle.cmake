if(NOT NTVDM_ARCH STREQUAL "x86")
  return()
endif()
foreach(kind IN ITEMS workers tasks)
  fixture(wow-idle-${kind} CL test/observation/wow_idle_${kind}_probe.c)
  set_property(TARGET wow-idle-${kind}_objects PROPERTY COMPILE_OPTIONS /nologo /O2 /W4 /WX)
endforeach()
add_custom_target(wow-idle-hosts DEPENDS wow-idle-workers wow-idle-tasks)
set(outputs)
set(source "${NTVDM_REPO}/test/observation/win16_idle_probe.asm")
foreach(mode IN ITEMS separate shared)
  set(root "${CMAKE_BINARY_DIR}/guest-probes/idle/${mode}")
  file(MAKE_DIRECTORY "${root}")
  foreach(role IN ITEMS first peer)
    set(flags)
    set(name IDLPROBE)
    if(mode STREQUAL "shared")
      list(APPEND flags -DSHARED_WITNESS)
      if(role STREQUAL "first")
        list(APPEND flags -DTICK_LIMIT=16)
      else()
        list(APPEND flags -DNO_REGISTER -DTICK_LIMIT=4)
      endif()
    elseif(role STREQUAL "peer")
      list(APPEND flags -DTICK_LIMIT=12)
    endif()
    if(role STREQUAL "peer")
      set(name IDLPEER)
      list(PREPEND flags -DPEER)
    endif()
    add_custom_command(OUTPUT "${root}/${name}.EXE" "${root}/${role}.lst"
      COMMAND "${NTVDM_NASM}" -f bin ${flags} -o "${root}/${name}.EXE"
        -l "${root}/${role}.lst" "${source}"
      DEPENDS "${source}" "${NTVDM_NASM}" VERBATIM)
    list(APPEND outputs "${root}/${name}.EXE" "${root}/${role}.lst")
  endforeach()
endforeach()
add_custom_target(wow-idle-probes DEPENDS wow-idle-hosts ${outputs})
