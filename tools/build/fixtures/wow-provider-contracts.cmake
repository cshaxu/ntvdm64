if(NOT NTVDM_ARCH STREQUAL "x86")
  return()
endif()
set(owner "${NTVDM_REPO}/src/mvdm-host/wow32")
set(bodies "")
foreach(name IN ITEMS GetPrn16 Prn32 FreePrn WG32OpenJob WG32CloseJob)
  ntvdm_function_body(body "${owner}/wspool.c" "${name}")
  string(APPEND bodies "${body}\n\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/spool_exact.h" CONTENT "${bodies}" @ONLY)
set(prefixes "")
foreach(name IN ITEMS WG32DeviceMode WG32ExtDeviceMode WG32DeviceCapabilities WG32GetEnvironment)
  if(name STREQUAL "WG32GetEnvironment")
    set(source "${owner}/wgdi.c")
  else()
    set(source "${owner}/wgprnset.c")
  endif()
  ntvdm_function_body(body "${source}" "${name}")
  string(FIND "${body}" "    if (!(spoolerapis[" decision)
  if(decision LESS 0)
    message(FATAL_ERROR "Missing spool loader boundary: ${name}")
  endif()
  string(SUBSTRING "${body}" ${decision} -1 tail)
  construction_region(block "${tail}" "    if (!(spoolerapis[" "\n    }")
  if(NOT block MATCHES "LoadLibraryAndGetProcAddresses")
    message(FATAL_ERROR "Missing spool loader call: ${name}")
  endif()
  string(LENGTH "${block}" size)
  math(EXPR size "${decision}+${size}")
  string(SUBSTRING "${body}" 0 ${size} prefix)
  # As before, the sentinel rejects a path beyond the failed-load boundary.
  if(name STREQUAL "WG32GetEnvironment")
    set(label "exitpath:")
  else()
    set(label "ExitPath:")
  endif()
  string(FIND "${body}" "${label}" cleanup)
  if(cleanup LESS size)
    message(FATAL_ERROR "Missing original loader cleanup: ${name}")
  endif()
  string(SUBSTRING "${body}" ${cleanup} -1 suffix)
  string(APPEND prefixes "${prefix}\nreturn 0xfeed;\n${suffix}\n\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/loader_prefixes.h" CONTENT "${prefixes}" @ONLY)
set(bodies "")
foreach(name IN ITEMS WWS32FindAsyncTaskHandle32 WWS32CancelAsyncRequestsForTask WWS32FindAndRemoveAsyncContext WWS32DispatchPostMessage)
  if(name STREQUAL "WWS32DispatchPostMessage")
    set(source "${owner}/wsext.c")
  else()
    set(source "${owner}/wsdata.c")
  endif()
  ntvdm_function_body(body "${source}" "${name}")
  string(APPEND bodies "${body}\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/winsock_rundown_exact.h" CONTENT "${bodies}" @ONLY)
construction_read(header "${owner}/winsockp.h")
construction_region(record "${header}" "#define WWS32_ASYNC_RETIRED" "PWINSOCK_ASYNC_CONTEXT_BLOCK;")
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/winsock_context_exact.h" CONTENT "${record}" @ONLY)
foreach(kind IN ITEMS spool_failure spool_loader_failure winsock_rundown)
  fixture(wow-provider-${kind} CL "test/integration/wow_${kind}_test.c")
  set_property(TARGET wow-provider-${kind}_objects PROPERTY COMPILE_OPTIONS /nologo /TC /O2)
  target_include_directories(wow-provider-${kind}_objects PRIVATE "${CMAKE_BINARY_DIR}")
endforeach()
foreach(kind IN ITEMS spool_failure spool_loader_failure)
  target_compile_definitions(wow-provider-${kind}_objects PRIVATE _CRT_SECURE_NO_WARNINGS)
endforeach()
set_property(TARGET wow-provider-spool_loader_failure_objects PROPERTY FIXTURE_LIBRARIES user32.lib)
add_custom_target(wow-provider-contracts DEPENDS wow-provider-spool_failure wow-provider-spool_loader_failure wow-provider-winsock_rundown)

ntvdm_function_body(environment_size "${owner}/wkman.c" "WOWGetEnvironmentSize")
ntvdm_function_body(environment_clone "${owner}/wshimdb.c" "WOWCloneEnvironment")
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/environment_clone_exact.h"
  CONTENT "${environment_size}\n${environment_clone}\n" @ONLY)
fixture(wow-environment-clone CL "test/mvdm-host/wow32/environment_clone_fixture.c")
set_property(TARGET wow-environment-clone_objects PROPERTY COMPILE_OPTIONS /nologo /TC /O2)
target_include_directories(wow-environment-clone_objects PRIVATE "${CMAKE_BINARY_DIR}")
add_dependencies(wow-provider-contracts wow-environment-clone)
