if(NOT NTVDM_ARCH STREQUAL "x86")
  return()
endif()
# Share the current message-contract interval selector, not its test cases.
set(owner "${NTVDM_REPO}/src/mvdm-host/wow32")
construction_read(wow "${NTVDM_REPO}/src/mvdm-host/inc/wow.h")
construction_read(user "${NTVDM_REPO}/src/mvdm-host/inc/wowusr.h")
construction_read(compat "${NTVDM_REPO}/src/mvdm-host/inc/wowcmpat.h")
construction_read(aliases "${owner}/walias.h")
construction_read(forward "${owner}/wmdisp32.h")
construction_read(map "${owner}/wparam.c")
construction_region(body "${wow}" "typedef struct _PARMWP" "} PARM16, *PPARM16;")
set(types "#pragma pack(push,1)\n${body}\n")
construction_region(body "${user}" "typedef struct _SETWINDOWTEXT16" "typedef SETWINDOWTEXT16 UNALIGNED *PSETWINDOWTEXT16;")
string(APPEND types "${body}\n#pragma pack(pop)\n")
construction_region(body "${aliases}" "typedef struct _DLGDATA" "} MSGPARAMEX;")
string(APPEND types "${body}\n")
construction_region(body "${forward}" "typedef struct _WM32MSGPARAMEX *LPWM32MSGPARAMEX;" "} WM32MSGPARAMEX;")
string(APPEND types "${body}\n")
foreach(name IN ITEMS OLDCB_DIR OLDCBEC_SETCOMBOFOCUS OLDCBEC_KILLCOMBOFOCUS
    WOWCF_NOCBDIRTHUNK WOWCF_DSBASEDSTRINGPOINTERS WOWCF_DBASEHANDLEBUG)
  string(REGEX MATCH "#define ${name}[^\n]*" value "${wow}\n${compat}")
  if(value STREQUAL "")
    message(FATAL_ERROR "Parameter contract constant missing: ${name}")
  endif()
  string(APPEND types "${value}\n")
endforeach()
set(directory "${CMAKE_BINARY_DIR}/parameter-map")
file(CONFIGURE OUTPUT "${directory}/parameter_types.h" CONTENT "${types}" @ONLY)
construction_region(body "${map}" "#define MAPCACHESIZE" "MAPPARAM gParamMap;")
file(CONFIGURE OUTPUT "${directory}/parameter_map_records.h" CONTENT "${body}" @ONLY)
ntvdm_function_body(end "${owner}/wparam.c" IsCacheBlock)
construction_region(body "${map}" "BOOL IsCacheBlock(PBLKCACHE pc, LPVOID pv);" "${end}")
file(CONFIGURE OUTPUT "${directory}/parameter_cache.h" CONTENT "${body}" @ONLY)
set(bodies "")
foreach(pair IN ITEMS wparam|FindParamMap wparam|GetParam16 wparam|AddParamMap
    wparam|ParamMapUpdateNode wparam|DeleteParamMap wparam|W32CheckThunkParamFlag
    wparam|FreeParamMap wparam|InitParamMap wmdisp32|WM32SetText wcntl32|WM32CBDir
    wmsgcb|ThunkCBMsg16 wmsgcb|UnThunkCBMsg16)
  string(REPLACE "|" ";" parts "${pair}")
  list(GET parts 0 file)
  list(GET parts 1 name)
  ntvdm_function_body(body "${owner}/${file}.c" "${name}")
  string(APPEND bodies "${body}\n\n")
endforeach()
ntvdm_function_body(messages "${owner}/wmsg16.c" ThunkWMMsg16)
construction_region(body "${messages}" "    case WM_SETTEXT:" "    case WM_ACTIVATEAPP:")
string(REPLACE "    case WM_ACTIVATEAPP:" "" body "${body}")
string(APPEND bodies "BOOL FASTCALL ThunkWMMsg16(LPMSGPARAMEX lpmpex){LONG lParam=lpmpex->Parm16.WndProc.lParam;PLONG plParamNew=&lpmpex->lParam;switch(lpmpex->Parm16.WndProc.wMsg){\n${body}\n}return TRUE;}\n\n")
ntvdm_function_body(release "${owner}/wmsg16.c" UnThunkWMMsg16)
construction_region(body "${release}" "    case WM_SETTEXT:" "    case WM_GETTEXT:")
string(REPLACE "    case WM_GETTEXT:" "" body "${body}")
string(APPEND bodies "VOID FASTCALL UnThunkWMMsg16(LPMSGPARAMEX lpmpex){switch(lpmpex->Parm16.WndProc.wMsg){\n${body}\n}}\n\n")
ntvdm_function_body(body "${owner}/wuwind.c" WU32SetWindowText)
string(APPEND bodies "${body}\n\n")
foreach(name IN ITEMS wow_message_free16 release_mdi wow_message_release32
    wow_message_unwind32 wow_message_unwind16)
  ntvdm_function_body(body "${owner}/wmdisp32.c" "${name}")
  string(APPEND bodies "${body}\n\n")
endforeach()
file(CONFIGURE OUTPUT "${directory}/parameter_exact.h" CONTENT "${bodies}" @ONLY)
fixture(wow-parameter-map CL test/observation/wow_parameter_map_fixture.c)
set_property(TARGET wow-parameter-map_objects PROPERTY COMPILE_OPTIONS /nologo /TC /O2 /W4 /WX /wd4706 /wd4127 /wd4213 /wd4306)
target_include_directories(wow-parameter-map_objects PRIVATE "${directory}" "${NTVDM_REPO}/src")
