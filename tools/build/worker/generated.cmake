include("${CMAKE_CURRENT_LIST_DIR}/../OriginalVdmConfig.cmake")
include(exports.cmake)
set(base "${NTVDM_REPO}/src/mvdm-host/softpc.new/base")
set(cvidc_tool "${NTVDM_REPO}/build/.ninja/build-tools/ntvdm-cvidc.exe")
execute_process(COMMAND "${cvidc_tool}" "${CMAKE_BINARY_DIR}/generated/cvidc_cpu_binding.inc"
  "${base}" COMMAND_ERROR_IS_FATAL ANY)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${cvidc_tool}")
foreach(file IN ITEMS cvidc/c2cpusad.h cvidc/cpu4gen.h inc/sas.h cvidc/evidgen.h
    cpu/src/evid/vglob.c cvidc/sinit011.c cvidc/sinit012.c cvidc/sinit013.c inc/egaports.h)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${base}/${file}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${NTVDM_REPO}/src/compat/include/generated/x86/prod/sas4gen.h")
file(READ "${CMAKE_BINARY_DIR}/generated/cvidc_cpu_binding.inc" binding)
string(REGEX MATCHALL "X[(][^,]+,[ \t]*[A-Za-z_][A-Za-z0-9_]*[)]" matches "${binding}")
set(providers)
foreach(entry IN LISTS matches)
  string(REGEX REPLACE "X[(][^,]+,[ \t]*([^)]*)[)]" "\\1" name "${entry}")
  if(NOT name MATCHES "^(c_cpu_calc_q_ev_inst_for_time|c_sas_overwrite_memory)$|^mvdm_cvidc_")
    list(APPEND providers "${name}")
  endif()
endforeach()
list(REMOVE_DUPLICATES providers)
set(stubs "/* Generated test-only inert provider symbols. */\n")
foreach(name IN LISTS providers)
  string(APPEND stubs "void ${name}(void) {}\n")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/cvidc_vector_provider_stubs.c" CONTENT "${stubs}" @ONLY)

file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/frontend-font")
set(font_tool "${NTVDM_REPO}/build/.ninja/build-tools/ntvdm-font.exe")
set(rom "${NTVDM_REPO}/src/mvdm-guest/softpc.new/roms/v7vga.rom")
add_custom_command(OUTPUT "${CMAKE_BINARY_DIR}/frontend-font/native_pc_font.h"
  COMMAND "${font_tool}" "${rom}" "${CMAKE_BINARY_DIR}/frontend-font/native_pc_font.h"
  DEPENDS "${font_tool}" "${rom}" VERBATIM)
set(resource "${NTVDM_REPO}/src/mvdm-host/softpc.new/obj.vdm/resource.rc")
file(READ "${resource}" content)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${resource}")
foreach(name IN ITEMS bios1 bios4 v7vga)
  string(TOUPPER "${name}" symbol)
  set(path "${NTVDM_REPO}/src/mvdm-guest/softpc.new/roms/${name}.rom")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Missing original ROM: ${path}")
  endif()
  string(APPEND content "\nSOFTPC_${symbol} RCDATA \"${path}\"\n")
  list(APPEND worker_roms "${path}")
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/softpc-embedded-roms.rc" CONTENT "${content}" @ONLY)

