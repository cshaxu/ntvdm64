# Original SOURCES remains the membership authority. Architecture-specific
# lists and the next make assignment terminate the portable C source block.
function(worker_original_sources output manifest)
  file(STRINGS "${manifest}" lines)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
  set(active FALSE)
  set(names)
  foreach(line IN LISTS lines)
    string(STRIP "${line}" line)
    if(line MATCHES "^#")
      continue()
    endif()
    if(NOT active)
      if(NOT line MATCHES "^SOURCES[ \t]*=[ \t]*(.*)$")
        continue()
      endif()
      set(line "${CMAKE_MATCH_1}")
      set(active TRUE)
    elseif(line MATCHES "^(!INCLUDE|UMTYPE|i386_SOURCES|MIPS_SOURCES|ALPHA_SOURCES|C_DEFINES|[A-Z][A-Z0-9_]*=)")
      break()
    endif()
    string(REGEX MATCHALL "[A-Za-z0-9_]+[.]c" selected "${line}")
    list(APPEND names ${selected})
  endforeach()
  if(NOT names)
    message(FATAL_ERROR "No portable C SOURCES in ${manifest}")
  endif()
  list(REMOVE_DUPLICATES names)
  set(${output} "${names}" PARENT_SCOPE)
endfunction()
