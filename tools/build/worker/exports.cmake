# Preserve original CPU40 exports and the released private ordinal ABI.
set(export_source "${NTVDM_REPO}/src/mvdm-host/softpc.new/obj.vdm/ntvdm.src")
set(ordinal_source "${NTVDM_REPO}/src/ntvdm-exe/ntvdm-export-ordinals.csv")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
  "${export_source}" "${ordinal_source}" "${CMAKE_CURRENT_LIST_DIR}/private-exports.def")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated")
set(preprocessed "${CMAKE_BINARY_DIR}/generated/ntvdm-original-cpu40.def")
execute_process(COMMAND "${CMAKE_C_COMPILER}" /nologo /TC /P "/Fi${preprocessed}"
  /Di386 /DCPU_40_STYLE "${export_source}" COMMAND_ERROR_IS_FATAL ANY)
file(STRINGS "${preprocessed}" original_exports)
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/private-exports.def" private_exports)
file(STRINGS "${ordinal_source}" ordinal_rows)
list(POP_FRONT ordinal_rows heading)
if(NOT heading STREQUAL "name,ordinal")
  message(FATAL_ERROR "Invalid NTVDM ordinal heading")
endif()
set(names)
set(numbers)
foreach(row IN LISTS ordinal_rows)
  if(NOT row MATCHES "^([A-Za-z_][A-Za-z0-9_]*),([0-9]+)$")
    message(FATAL_ERROR "Invalid NTVDM ordinal: ${row}")
  endif()
  set(name "${CMAKE_MATCH_1}")
  set(number "${CMAKE_MATCH_2}")
  if(name IN_LIST names OR number IN_LIST numbers OR number LESS 1 OR number GREATER 65535)
    message(FATAL_ERROR "Duplicate or invalid NTVDM ordinal: ${row}")
  endif()
  list(APPEND names "${name}")
  list(APPEND numbers "${number}")
  set(ordinal_${name} "${number}")
endforeach()
set(exports)
set(seen)
foreach(line IN LISTS original_exports private_exports)
  if(line MATCHES "^[ \t]*#[ \t]*line")
    continue()
  elseif(line MATCHES "^[ \t]*call_ica_hw_interrupt[ \t]*=")
    set(line "    call_ica_hw_interrupt = _mvdm_public_ica_interrupt@12")
  elseif(line MATCHES "^[ \t]*NAME[ \t]+")
    set(line "NAME ntvdm.exe")
  endif()
  if(line MATCHES "^[ \t]*([A-Za-z_][A-Za-z0-9_]*)([ \t]*=[ \t]*[^ \t;]+)?([ \t]+DATA)?([ \t]*(;.*)?)$")
    set(name "${CMAKE_MATCH_1}")
    if(name IN_LIST names)
      if(name IN_LIST seen)
        message(FATAL_ERROR "Duplicate NTVDM export: ${name}")
      endif()
      list(APPEND seen "${name}")
      set(line "    ${name}${CMAKE_MATCH_2} @${ordinal_${name}}${CMAKE_MATCH_3}${CMAKE_MATCH_4}")
    endif()
  endif()
  string(APPEND exports "${line}\n")
endforeach()
list(SORT names)
foreach(name IN LISTS names)
  if(NOT name IN_LIST seen)
    string(APPEND exports "    ${name} @${ordinal_${name}}\n")
  endif()
endforeach()
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/ntvdm-wow32-provider.def"
  CONTENT "${exports}" @ONLY)
