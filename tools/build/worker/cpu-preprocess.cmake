# Observe current per-unit profiles; no object, archive or image is rebuilt.
set(root "${CMAKE_BINARY_DIR}/diagnostics/ccpu-headers")
file(MAKE_DIRECTORY "${root}")
set(commands)
set(outputs)
set(native_objects)
set(profiles "")
foreach(name IN ITEMS c_div64 c_tlb c_tsksw c_xfer c_xtrn c_main c_reg zfrsrvd)
  set(owner "unit_obj_ccpu_${name}_obj")
  get_target_property(flags ${owner} COMPILE_FLAGS)
  get_target_property(source ${owner} SOURCES)
  if(NOT flags MATCHES "/DCPU_40_STYLE" OR NOT flags MATCHES "/DSPC386")
    message(FATAL_ERROR "CCPU preprocessing requires selected CPU40/SPC386 owner")
  endif()
  list(LENGTH source count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "CCPU observation owner must have exactly one source")
  endif()
  separate_arguments(options NATIVE_COMMAND "${flags}")
  set(output "${root}/${name}.i")
  list(APPEND commands COMMAND "${CMAKE_C_COMPILER}" ${options} /P "/Fi${output}" "${source}")
  list(APPEND outputs "${output}")
  list(APPEND native_objects "$<TARGET_OBJECTS:${owner}>")
  string(APPEND profiles "${name}\t${source}\t${flags}\n")
endforeach()
# Explicit observation always re-runs, so changed included headers are not stale.
add_custom_target(ccpu-header-selection ${commands} BYPRODUCTS ${outputs} VERBATIM)
file(GENERATE OUTPUT "${root}/objects.txt" CONTENT "$<JOIN:${native_objects},\n>\n")
file(CONFIGURE OUTPUT "${root}/profiles.tsv" CONTENT "${profiles}" @ONLY NEWLINE_STYLE LF)
