function(worker_paths output)
  set(paths)
  foreach(path IN LISTS ARGN)
    if(NOT IS_ABSOLUTE "${path}" AND path MATCHES "[./\\]")
      set(path "${CMAKE_BINARY_DIR}/${path}")
    endif()
    list(APPEND paths "${path}")
  endforeach()
  set(${output} "${paths}" PARENT_SCOPE)
endfunction()

function(worker_unit output source flags)
  string(MAKE_C_IDENTIFIER "unit_${output}" unit)
  worker_paths(source "${source}")
  if(source MATCHES "[.](cpp|cxx)$")
    set_source_files_properties("${source}" PROPERTIES LANGUAGE C)
  endif()
  add_library(${unit} OBJECT "${source}")
  set_target_properties(${unit} PROPERTIES EXCLUDE_FROM_ALL TRUE COMPILE_FLAGS "${flags}")
  worker_paths(dependencies ${ARGN})
  if(flags MATCHES "frontend-font")
    list(APPEND dependencies "${CMAKE_BINARY_DIR}/frontend-font/native_pc_font.h")
  endif()
  if(dependencies)
    set_property(SOURCE "${source}" APPEND PROPERTY OBJECT_DEPENDS "${dependencies}")
  endif()
  worker_paths(destination "${output}")
  get_filename_component(directory "${destination}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  add_custom_command(OUTPUT "${destination}"
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "$<TARGET_OBJECTS:${unit}>" "${destination}"
    DEPENDS ${unit} "$<TARGET_OBJECTS:${unit}>" VERBATIM)
  if(EXISTS "${source}")
    file(SHA256 "${source}" hash)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
    set_property(GLOBAL APPEND PROPERTY worker_manifest
      "{\"path\":\"${source}\",\"sha256\":\"${hash}\",\"object\":\"${output}\"}")
  endif()
endfunction()

function(worker_archive output)
  worker_paths(dependencies ${ARGN})
  add_custom_command(OUTPUT "${CMAKE_BINARY_DIR}/${output}"
    COMMAND "${NTVDM_LIB}" /nologo "/out:${output}" ${ARGN}
    DEPENDS ${dependencies} VERBATIM)
endfunction()

function(worker_resource output source flags)
  worker_paths(dependencies "${source}" ${ARGN})
  if(source MATCHES "/softpc-embedded-roms[.]rc$")
    list(APPEND dependencies ${worker_roms})
  endif()
  separate_arguments(options NATIVE_COMMAND "${flags}")
  get_filename_component(directory "${CMAKE_BINARY_DIR}/${output}" DIRECTORY)
  file(MAKE_DIRECTORY "${directory}")
  add_custom_command(OUTPUT "${CMAKE_BINARY_DIR}/${output}"
    COMMAND "${CMAKE_RC_COMPILER}" ${options} "/fo${output}" "${source}"
    DEPENDS ${dependencies} VERBATIM)
endfunction()

function(worker_link output before after)
  cmake_parse_arguments(PARSE_ARGV 3 link "TIB_CHECK;NO_LINK_INPUTS" "" "INPUTS;DEPENDS")
  string(REPLACE "$out" "${output}" before "${before}")
  string(REPLACE "$out" "${output}" after "${after}")
  separate_arguments(prefix NATIVE_COMMAND "${before}")
  separate_arguments(suffix NATIVE_COMMAND "${after}")
  worker_paths(dependencies ${link_INPUTS} ${link_DEPENDS})
  set(byproducts)
  if(before MATCHES "/implib:([^ \t]+)")
    list(APPEND byproducts "${CMAKE_BINARY_DIR}/${CMAKE_MATCH_1}")
  elseif(before MATCHES "/(dll|def:)")
    get_filename_component(stem "${output}" NAME_WE)
    list(APPEND byproducts "${CMAKE_BINARY_DIR}/${stem}.lib")
  endif()
  if(before MATCHES "/map:([^ \t]+)")
    list(APPEND byproducts "${CMAKE_BINARY_DIR}/${CMAKE_MATCH_1}")
  endif()
  set(check)
  if(link_TIB_CHECK)
    set(check COMMAND "${NTVDM_REPO}/build/.ninja/build-tools/ntvdm-tib.exe"
      "${output}.map" obj/dpmi/dpmiint.obj)
    list(APPEND dependencies "${NTVDM_REPO}/build/.ninja/build-tools/ntvdm-tib.exe")
  endif()
  set(inputs "${link_INPUTS}")
  if(link_NO_LINK_INPUTS)
    set(inputs)
  endif()
  add_custom_command(OUTPUT "${CMAKE_BINARY_DIR}/${output}"
    COMMAND "${CMAKE_LINKER}" ${prefix} ${inputs} ${suffix}
    ${check} DEPENDS ${dependencies} BYPRODUCTS ${byproducts} VERBATIM)
  string(MAKE_C_IDENTIFIER "image_${output}" target)
  add_custom_target(${target} DEPENDS "${CMAKE_BINARY_DIR}/${output}")
  set_property(TARGET ${target} PROPERTY WORKER_LINK_INPUTS "${link_INPUTS}")
endfunction()

function(worker_group name)
  worker_paths(dependencies ${ARGN})
  add_custom_target(${name} DEPENDS ${dependencies})
endfunction()
