# One configuration owner, shared by CMake and the manifest Ninja generators.
get_filename_component(NTVDM_REPO "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
file(TO_CMAKE_PATH "${NTVDM_REPO}/build/.ninja" _cache_root)
if(NOT NTVDM_BINARY_DIR)
  message(FATAL_ERROR "NTVDM_BINARY_DIR is required")
endif()
get_filename_component(_binary "${NTVDM_BINARY_DIR}" ABSOLUTE BASE_DIR "${NTVDM_REPO}")
file(REAL_PATH "${_binary}" _real_binary)
file(REAL_PATH "${_cache_root}" _real_cache)
string(TOLOWER "${_real_binary}/" _check_binary)
string(TOLOWER "${_real_cache}/" _check_cache)
string(FIND "${_check_binary}" "${_check_cache}" _inside)
if(NOT _inside EQUAL 0 OR _check_binary STREQUAL _check_cache)
  message(FATAL_ERROR "Ninja build trees must be strictly below ${_cache_root}")
endif()
# Do not accept an alias through a junction/symlink into another tree.
string(TOLOWER "${_binary}" _spelled)
string(TOLOWER "${_real_binary}" _resolved)
if(NOT _spelled STREQUAL _resolved)
  message(FATAL_ERROR "Ninja build tree cannot traverse a link/junction")
endif()
set(NTVDM_CCACHE_ENV
  "CCACHE_DIR=${NTVDM_REPO}/build/.ccache"
  "CCACHE_TEMPDIR=${NTVDM_REPO}/build/.ccache/tmp"
  "CCACHE_MAXSIZE=5G")
set(NTVDM_COMPILER_LAUNCHER "")
if(NTVDM_USE_CCACHE)
  if(NOT NTVDM_CCACHE_EXECUTABLE)
    find_program(NTVDM_CCACHE_EXECUTABLE NAMES ccache REQUIRED)
  endif()
  if(NOT EXISTS "${NTVDM_CCACHE_EXECUTABLE}")
    message(FATAL_ERROR "Selected ccache does not exist")
  endif()
  file(MAKE_DIRECTORY "${NTVDM_REPO}/build/.ccache/tmp")
  set(NTVDM_COMPILER_LAUNCHER "${CMAKE_COMMAND};-E;env;${NTVDM_CCACHE_ENV};${NTVDM_CCACHE_EXECUTABLE}")
endif()
if(CMAKE_SCRIPT_MODE_FILE)
  file(MAKE_DIRECTORY "${_binary}")
  set(_command "")
  foreach(_arg IN LISTS NTVDM_COMPILER_LAUNCHER)
    string(APPEND _command "\"${_arg}\" ")
  endforeach()
  string(APPEND _command "cl.exe")
  # Avoid touching identical generated inputs on reconfiguration.
  file(CONFIGURE OUTPUT "${_binary}/compiler-command.txt" CONTENT "${_command}" @ONLY)
endif()
