# Real current SHELL32 reference plus the current product callback adapter.
get_target_property(shell_scope_flags obj_compat_wow_shell_callback_obj COMPILE_FLAGS)
wow_unit(wow_shell_scope_fixture "${NTVDM_REPO}/test/adapter-mvdm-host-out/wow/wow_shell_scope_fixture.c" "${shell_scope_flags}")
set_property(TARGET wow_shell_scope_fixture PROPERTY EXCLUDE_FROM_ALL TRUE)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/shell-callback-profile.txt" CONTENT "${shell_scope_flags}\n")
set(shell_targets)
foreach(kind IN ITEMS native native-outer adapter adapter-outer)
  set(flags "/nologo /TC /O2 /MT /W4 /WX")
  set(provider)
  if(kind MATCHES "^adapter")
    string(APPEND flags " /DTEST_ADAPTER")
    set(provider wow_shell_scope_fixture)
  endif()
  if(kind MATCHES "outer$")
    string(APPEND flags " /DTEST_OUTER_BOUNDARY")
  endif()
  wow_unit(shell_probe_${kind} "${NTVDM_REPO}/test/observation/wow_shell_callback_probe.c" "${flags}")
  set_property(TARGET shell_probe_${kind} PROPERTY EXCLUDE_FROM_ALL TRUE)
  set(shell_objects "$<TARGET_OBJECTS:shell_probe_${kind}>")
  if(provider)
    list(APPEND shell_objects "$<TARGET_OBJECTS:${provider}>")
  endif()
  set(output "${CMAKE_BINARY_DIR}/shell-callback-${kind}.exe")
  add_custom_command(OUTPUT "${output}"
    COMMAND "${CMAKE_C_COMPILER}" /nologo /MT "/Fe${output}" ${shell_objects} /link kernel32.lib
    DEPENDS shell_probe_${kind} ${provider} ${shell_objects} COMMAND_EXPAND_LISTS VERBATIM)
  add_custom_target(wow-shell-${kind} DEPENDS "${output}")
  list(APPEND shell_targets wow-shell-${kind})
endforeach()
add_custom_target(wow-shell-callback DEPENDS ${shell_targets})
