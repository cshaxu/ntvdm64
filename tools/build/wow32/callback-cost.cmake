# Optional diagnostic, composed from the exact product object/link owners.
set(source "${NTVDM_REPO}/src/compat/wow_window_words_binding.c")
file(READ "${source}" original)
string(REPLACE "\r\n" "\n" original "${original}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
set(rename "BOOL WINAPI wow_window_dispatch_immutable(")
set(renamed "static BOOL WINAPI callback_cost_body(")
set(needle "        *result = DispatchClientMessage(&view, message, wp, lp, procedure);\n    } __finally {")
set(marked "        callback_cost_phase_enter();\n        *result = DispatchClientMessage(&view, message, wp, lp, procedure);\n        callback_cost_phase_leave();\n    } __finally {")
foreach(boundary IN ITEMS rename needle)
  string(FIND "${original}" "${${boundary}}" first)
  string(FIND "${original}" "${${boundary}}" last REVERSE)
  if(first LESS 0 OR NOT first EQUAL last)
    message(FATAL_ERROR "Callback diagnostic boundary changed: ${boundary}")
  endif()
endforeach()
string(REPLACE "${rename}" "${renamed}" body "${original}")
string(REPLACE "${needle}" "${marked}" body "${body}")
string(REPLACE "${marked}" "${needle}" restored "${body}")
string(REPLACE "${renamed}" "${rename}" restored "${restored}")
if(NOT restored STREQUAL original)
  message(FATAL_ERROR "Callback diagnostic reversal failed")
endif()
set(root "${CMAKE_BINARY_DIR}/diagnostics/callback-cost")
file(MAKE_DIRECTORY "${root}")
set(test "${NTVDM_REPO}/test/observation")
file(CONFIGURE OUTPUT "${root}/callback-profile.c" CONTENT
  "#include \"${test}/wow_callback_cost_instrument.h\"\n${body}\n#include \"${test}/wow_callback_cost_dispatch.h\"\n" @ONLY NEWLINE_STYLE LF)
get_target_property(flags obj_compat_wow_window_words_binding_obj COMPILE_FLAGS)
add_library(callback_cost_object OBJECT "${root}/callback-profile.c")
set_target_properties(callback_cost_object PROPERTIES EXCLUDE_FROM_ALL TRUE COMPILE_FLAGS "${flags}")
set(diagnostic_objects ${objects})
list(FIND diagnostic_objects "$<TARGET_OBJECTS:obj_compat_wow_window_words_binding_obj>" index)
if(index LESS 0)
  message(FATAL_ERROR "Callback product object missing")
endif()
list(REMOVE_AT diagnostic_objects ${index})
list(INSERT diagnostic_objects ${index} "$<TARGET_OBJECTS:callback_cost_object>")
add_library(wow_callback_cost SHARED EXCLUDE_FROM_ALL ${diagnostic_objects})
set_target_properties(wow_callback_cost PROPERTIES LINKER_LANGUAGE C PREFIX ""
  OUTPUT_NAME WOW32 RUNTIME_OUTPUT_DIRECTORY "${root}" ARCHIVE_OUTPUT_DIRECTORY "${root}")
add_dependencies(wow_callback_cost wow-imports)
get_target_property(libraries wow32 LINK_LIBRARIES)
target_link_libraries(wow_callback_cost PRIVATE ${libraries})
target_link_options(wow_callback_cost PRIVATE "/map:${root}/WOW32.DLL.map" "/def:${CMAKE_BINARY_DIR}/wow32-x86.def")
set_property(TARGET wow_callback_cost APPEND PROPERTY LINK_DEPENDS "${CMAKE_BINARY_DIR}/wow32-x86.def")
file(GENERATE OUTPUT "${root}/objects.txt" CONTENT "$<JOIN:${diagnostic_objects},\n>\n")
file(GENERATE OUTPUT "${root}/callback-object.txt" CONTENT "$<TARGET_OBJECTS:callback_cost_object>\n")
add_custom_target(wow-callback-cost DEPENDS wow_callback_cost)
