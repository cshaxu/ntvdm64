# Read-only sizing witnesses in two source copies; never mutate product inputs.
set(root "${CMAKE_BINARY_DIR}/diagnostics/window-sizing")
set(sources)
foreach(kind IN ITEMS words creation)
  set(input "${NTVDM_REPO}/src/compat/wow_window_${kind}_binding.c")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
  file(READ "${input}" body)
  string(REPLACE "\r\n" "\n" body "${body}")
  string(FIND "${body}" "#include <stdio.h>" found)
  if(found LESS 0)
    message(FATAL_ERROR "Sizing diagnostic include boundary changed")
  endif()
  string(REPLACE "#include <stdio.h>" "#include <stdio.h>\n#include \"${NTVDM_REPO}/test/observation/wow_window_sizing_diagnostic.h\"" body "${body}")
  if(kind STREQUAL "words")
    set(needle "*result = DispatchClientMessage(&view, message, wp, lp, procedure);")
    set(replacement "sizing_witness(\"before\",window,message,lp); ${needle} sizing_witness(\"after\",window,message,lp);")
    set(expected 2)
  else()
    set(needle "trace_creation(&scope, result, error);")
    set(replacement "sizing_witness(\"created\",result,0,(LPARAM)scope.request); ${needle}")
    set(expected 1)
  endif()
  string(REPLACE "${needle}" "" without "${body}")
  string(LENGTH "${body}" before)
  string(LENGTH "${without}" after)
  string(LENGTH "${needle}" size)
  math(EXPR count "(${before}-${after})/${size}")
  if(NOT count EQUAL expected)
    message(FATAL_ERROR "Sizing diagnostic witness boundary changed")
  endif()
  string(REPLACE "${needle}" "${replacement}" body "${body}")
  set(output "${root}/wow_window_${kind}_binding.c")
  file(CONFIGURE OUTPUT "${output}" CONTENT "${body}" @ONLY NEWLINE_STYLE LF)
  list(APPEND sources "${output}")
endforeach()
wow_diagnostic_provider(window-sizing
  "obj_compat_wow_window_words_binding_obj;obj_compat_wow_window_creation_binding_obj"
  "${sources}" "${CMAKE_BINARY_DIR}/wow32-x86.def")
