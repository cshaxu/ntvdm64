# Reuse the real product profile, object order and libraries for one test TU.
function(wow_diagnostic_provider name owner source definition)
  set(root "${CMAKE_BINARY_DIR}/diagnostics/${name}")
  string(MAKE_C_IDENTIFIER "diagnostic_${name}" target)
  get_target_property(flags ${owner} COMPILE_FLAGS)
  if(NOT flags)
    message(FATAL_ERROR "Missing diagnostic compile owner: ${owner}")
  endif()
  add_library(${target}_object OBJECT EXCLUDE_FROM_ALL "${source}")
  set_target_properties(${target}_object PROPERTIES COMPILE_FLAGS "${flags}")
  set(selected ${objects})
  list(FIND selected "$<TARGET_OBJECTS:${owner}>" index)
  if(index LESS 0)
    message(FATAL_ERROR "Diagnostic owner missing from product link: ${owner}")
  endif()
  list(REMOVE_AT selected ${index})
  list(INSERT selected ${index} "$<TARGET_OBJECTS:${target}_object>")
  add_library(${target} SHARED EXCLUDE_FROM_ALL ${selected})
  set_target_properties(${target} PROPERTIES LINKER_LANGUAGE C PREFIX ""
    OUTPUT_NAME WOW32 RUNTIME_OUTPUT_DIRECTORY "${root}" ARCHIVE_OUTPUT_DIRECTORY "${root}")
  add_dependencies(${target} wow-imports)
  get_target_property(libraries wow32 LINK_LIBRARIES)
  target_link_libraries(${target} PRIVATE ${libraries})
  target_link_options(${target} PRIVATE "/map:${root}/WOW32.map" "/def:${definition}")
  set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${definition}")
  file(GENERATE OUTPUT "${root}/objects.txt" CONTENT "$<JOIN:${selected},\n>\n")
  file(GENERATE OUTPUT "${root}/product-objects.txt" CONTENT "$<JOIN:${objects},\n>\n")
  file(GENERATE OUTPUT "${root}/callback-object.txt" CONTENT "$<TARGET_OBJECTS:${target}_object>\n")
  file(GENERATE OUTPUT "${root}/original-object.txt" CONTENT "$<TARGET_OBJECTS:${owner}>\n")
  add_custom_target(wow-${name} DEPENDS ${target})
endfunction()
