# Reuse the real product profile, object order and libraries for selected test TUs.
function(wow_diagnostic_provider name owner source definition)
  set(root "${CMAKE_BINARY_DIR}/diagnostics/${name}")
  string(MAKE_C_IDENTIFIER "diagnostic_${name}" target)
  list(LENGTH owner owner_count)
  list(LENGTH source source_count)
  if(NOT owner_count EQUAL source_count)
    message(FATAL_ERROR "Diagnostic source/owner count differs")
  endif()
  set(selected ${objects})
  set(original_objects)
  set(replacement_objects)
  set(i 0)
  foreach(unit IN LISTS owner)
    list(GET source ${i} input)
    set(object "${target}_object")
    if(i GREATER 0)
      string(APPEND object "${i}")
    endif()
    get_target_property(flags ${unit} COMPILE_FLAGS)
    if(NOT flags)
      message(FATAL_ERROR "Missing diagnostic compile owner: ${unit}")
    endif()
    add_library(${object} OBJECT EXCLUDE_FROM_ALL "${input}")
    set_target_properties(${object} PROPERTIES COMPILE_FLAGS "${flags}")
    list(FIND selected "$<TARGET_OBJECTS:${unit}>" index)
    if(index LESS 0)
      message(FATAL_ERROR "Diagnostic owner missing from product link: ${unit}")
    endif()
    list(REMOVE_AT selected ${index})
    list(INSERT selected ${index} "$<TARGET_OBJECTS:${object}>")
    list(APPEND original_objects "$<TARGET_OBJECTS:${unit}>")
    list(APPEND replacement_objects "$<TARGET_OBJECTS:${object}>")
    math(EXPR i "${i}+1")
  endforeach()
  add_library(${target} SHARED EXCLUDE_FROM_ALL ${selected})
  set_target_properties(${target} PROPERTIES LINKER_LANGUAGE C PREFIX ""
    OUTPUT_NAME WOW32 RUNTIME_OUTPUT_DIRECTORY "${root}" ARCHIVE_OUTPUT_DIRECTORY "${root}")
  add_dependencies(${target} wow-imports)
  get_target_property(libraries wow32 LINK_LIBRARIES)
  target_link_libraries(${target} PRIVATE ${libraries})
  target_link_options(${target} PRIVATE "/map:${root}/WOW32.map" "/def:${definition}")
  set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${definition}")
  file(GENERATE OUTPUT "${root}/objects.txt" CONTENT "$<JOIN:${selected},\n>\n")
  file(GENERATE OUTPUT "${root}/product-objects.txt" CONTENT "$<JOIN:${objects},\n>\n")
  file(GENERATE OUTPUT "${root}/callback-object.txt" CONTENT "$<JOIN:${replacement_objects},\n>\n")
  file(GENERATE OUTPUT "${root}/original-object.txt" CONTENT "$<JOIN:${original_objects},\n>\n")
  add_custom_target(wow-${name} DEPENDS ${target})
endfunction()
