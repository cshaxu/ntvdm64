# Two test-only projections of the original attach/detach owner.
set(source "${NTVDM_REPO}/src/mvdm-host/wow32/wow32.c")
file(READ "${source}" original)
string(REPLACE "\r\n" "\n" original "${original}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
function(attach_replace old new)
  string(FIND "${body}" "${old}" first)
  string(FIND "${body}" "${old}" last REVERSE)
  if(first LESS 0 OR NOT first EQUAL last)
    message(FATAL_ERROR "WOW attach diagnostic boundary changed: ${old}")
  endif()
  string(REPLACE "${old}" "${new}" replaced "${body}")
  set(body "${replaced}" PARENT_SCOPE)
endfunction()
foreach(kind IN ITEMS attach-failure missing-init)
  set(root "${CMAKE_BINARY_DIR}/diagnostics/${kind}")
  set(body "${original}")
  set(definition "${CMAKE_BINARY_DIR}/wow32-x86.def")
  if(kind STREQUAL "attach-failure")
    set(marker "${NTVDM_REPO}/test/observation/wow_attach_failure_marker.inc")
    file(READ "${marker}" marker_text)
    attach_replace("BOOLEAN\nW32DllInitialize(" "${marker_text}BOOLEAN\nW32DllInitialize(")
    attach_replace("if (!CreateSmallHeap())" "if (wow_fixture_attach_failure())")
  else()
    set(marker "${NTVDM_REPO}/test/observation/wow_unload_marker.inc")
    file(READ "${marker}" marker_text)
    attach_replace("BOOLEAN\nW32DllInitialize(" "${marker_text}BOOLEAN\nW32DllInitialize(")
    attach_replace("InitializeListHead(&TimerList);" "InitializeListHead(&TimerList); wow_fixture_unload_marker(\"attach\\n\",7);")
    attach_replace("HeapDestroy (hWOWHeap);" "HeapDestroy (hWOWHeap); wow_fixture_unload_marker(\"detach\\n\",7);")
    file(READ "${definition}" def)
    string(REGEX MATCHALL "\n[ \t]*W32Init[ \t]*\r?\n" matches "${def}")
    list(LENGTH matches count)
    if(NOT count EQUAL 1)
      message(FATAL_ERROR "Missing exact W32Init diagnostic export")
    endif()
    string(REGEX REPLACE "\n[ \t]*W32Init[ \t]*\r?\n" "\n    W32InitS31Hidden=W32Init\n" def "${def}")
    set(definition "${root}/diagnostic.def")
    file(CONFIGURE OUTPUT "${definition}" CONTENT "${def}" @ONLY)
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${marker}")
  file(CONFIGURE OUTPUT "${root}/wow32.c" CONTENT "${body}" @ONLY NEWLINE_STYLE LF)
  wow_diagnostic_provider(${kind} original_wow32 "${root}/wow32.c" "${definition}")
endforeach()
