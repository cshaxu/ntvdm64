set(root "${CMAKE_BINARY_DIR}/diagnostics/common-return")
set(header "${NTVDM_REPO}/test/observation/wow_common_return_diagnostic.h")
set(sources)
foreach(name IN ITEMS wow_user_task_lifecycle wow_user_thunk_scope)
  set(input "${NTVDM_REPO}/src/compat/${name}.c")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
  file(READ "${input}" body)
  string(REPLACE "\r\n" "\n" body "${body}")
  if(name STREQUAL "wow_user_task_lifecycle")
    set(begin "#define WOW_NATIVE_MAPPED_DESTROY_WINDOW")
    string(FIND "${body}" "${begin}" first)
    if(first LESS 0)
      message(FATAL_ERROR "Destroy diagnostic boundary missing")
    endif()
    string(SUBSTRING "${body}" ${first} -1 tail)
    string(FIND "${tail}" "\n}" length)
    if(length LESS 0)
      message(FATAL_ERROR "Destroy diagnostic end missing")
    endif()
    math(EXPR length "${length}+2")
    string(SUBSTRING "${tail}" 0 ${length} old)
    set(needle [=[    return restored ? result : failed; \]=])
    string(FIND "${old}" "${needle}" found)
    if(found LESS 0)
      message(FATAL_ERROR "Destroy diagnostic return changed")
    endif()
    set(trace [=[    wow_diag_destroy.raw = w; \
    wow_diag_destroy.full = native; \
    wow_diag_destroy.result = result; \
]=])
    string(REPLACE "${needle}" "${trace}${needle}" replacement "${old}")
    string(REPLACE "${old}" "#define WOW_DIAG_DESTROY_STORAGE\n#include \"${header}\"\n${replacement}" body "${body}")
  else()
    set(needle "ULONG WINAPI wow_user_invoke_thunk(wow_thunk_procedure thunk, struct _VDMFRAME *frame)")
    string(FIND "${body}" "${needle}" found)
    if(found LESS 0)
      message(FATAL_ERROR "Thunk diagnostic boundary changed")
    endif()
    string(REPLACE "${needle}" "#define WOW_DIAG_FAILURE_REPORT\n#include \"${header}\"\n${needle}" body "${body}")
    set(needle "    trace_thunk(frame, thunk);")
    string(FIND "${body}" "${needle}" found)
    if(found LESS 0)
      message(FATAL_ERROR "Thunk admission diagnostic changed")
    endif()
    string(REPLACE "${needle}" "    wow_diag_failure_report(thunk, frame);\n${needle}" body "${body}")
  endif()
  set(output "${root}/${name}.c")
  if(name STREQUAL "wow_user_thunk_scope")
    string(PREPEND body "#include \"precomp.h\"\n")
  endif()
  file(CONFIGURE OUTPUT "${output}" CONTENT "${body}" @ONLY NEWLINE_STYLE LF)
  list(APPEND sources "${output}")
endforeach()
wow_diagnostic_provider(common-return
  "obj_compat_wow_user_task_lifecycle_obj;obj_compat_wow_user_thunk_scope_obj"
  "${sources}" "${CMAKE_BINARY_DIR}/wow32-x86.def")
# Diagnostic-only inspection of original VDMFRAME and file-write arguments.
get_target_property(witness_flags original_wcall16 COMPILE_FLAGS)
set_target_properties(diagnostic_common_return_object1
  PROPERTIES COMPILE_FLAGS "${witness_flags}")
