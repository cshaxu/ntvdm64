function(wow_lifecycle_tests)
# Reuse product object identities; no Ninja command parser or duplicate compiler driver.
get_target_property(lifecycle_flags obj_compat_wow_user_task_lifecycle_obj COMPILE_FLAGS)
get_target_property(layout_flags obj_opennt-user_clglobal_obj COMPILE_FLAGS)
string(REGEX MATCHALL "/I[ ]*\"[^\"]+\"" layout_includes "${layout_flags}")
string(JOIN " " layout_includes ${layout_includes})
string(APPEND lifecycle_flags " ${layout_includes} /I \"${NTVDM_REPO}/src/wow32-dll/include\"")
set(lifecycle_original_flags "${lifecycle_flags}")
string(REPLACE "/Gz" "/Gd" lifecycle_flags "${lifecycle_flags}")
foreach(pair IN ITEMS "seams|wow_combined_fixture_seams.c"
    "imports|wow_worker_static_imports.c" "parent|wow_page_domain_parent_stub.c"
    "task|wow_user_task_lifecycle_fixture.c")
  string(REPLACE "|" ";" pair "${pair}")
  list(GET pair 0 kind)
  list(GET pair 1 file)
  set(flags "${lifecycle_flags}")
  if(kind STREQUAL "parent")
    string(APPEND flags " /DWOW_TASK_CLASS_PROJECTION_FIXTURE")
  endif()
  wow_unit(lifecycle_${kind} "${NTVDM_REPO}/test/adapter-mvdm-host-out/wow/${file}" "${flags}")
  set_property(TARGET lifecycle_${kind} PROPERTY EXCLUDE_FROM_ALL TRUE)
endforeach()
set(retirement_source "${NTVDM_REPO}/src/compat/wow_user_task_lifecycle.c")
file(READ "${retirement_source}" retirement_text)
string(REPLACE "\r\n" "\n" retirement_text "${retirement_text}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${retirement_source}")
ntvdm_function_body(retirement_body "${retirement_source}" retire_task)
set(needle "wow_cleanup_handle *entry = &owner->objects->entries[index];")
string(FIND "${retirement_body}" "${needle}" first)
string(FIND "${retirement_body}" "${needle}" last REVERSE)
if(first LESS 0 OR NOT first EQUAL last)
  message(FATAL_ERROR "Expected one current retirement scan")
endif()
string(REPLACE "${needle}" "${needle}\n        if (index == 0) wow_fixture_retirement_lock(binding->runtime);"
  retirement_probe "${retirement_body}")
string(REPLACE "${retirement_body}"
  "extern void WINAPI wow_fixture_retirement_lock(wow_user_runtime *);\n${retirement_probe}"
  retirement_text "${retirement_text}")
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/lifecycle-retirement-lock.c" CONTENT "${retirement_text}" @ONLY)
get_target_property(retirement_flags obj_compat_wow_user_task_lifecycle_obj COMPILE_FLAGS)
wow_unit(lifecycle_retirement_lock "${CMAKE_BINARY_DIR}/lifecycle-retirement-lock.c" "${retirement_flags}")
set_property(TARGET lifecycle_retirement_lock PROPERTY EXCLUDE_FROM_ALL TRUE)
foreach(kind IN ITEMS class menu)
  set(flags "${lifecycle_flags}")
  if(kind STREQUAL "class")
    string(APPEND flags " /DWOW_CLASS_CLIENT_FIXTURE")
  else()
    string(APPEND flags " /DWOW_TASK_CLASS_PROJECTION_FIXTURE /DWOW_MENU_CLEANUP_FIXTURE")
  endif()
  wow_unit(lifecycle_parent_${kind} "${NTVDM_REPO}/test/adapter-mvdm-host-out/wow/wow_page_domain_parent_stub.c" "${flags}")
  set_property(TARGET lifecycle_parent_${kind} PROPERTY EXCLUDE_FROM_ALL TRUE)
endforeach()
get_target_property(redir_flags original_wkfileio COMPILE_FLAGS)
wow_unit(lifecycle_wkfileio "${NTVDM_REPO}/src/mvdm-host/wow32/wkfileio.c" "${redir_flags} /DVdmRedirLoaded=wow_fixture_provider_VdmRedirLoaded")
set_property(TARGET lifecycle_wkfileio PROPERTY EXCLUDE_FROM_ALL TRUE)
get_target_property(lifecycle_provider wow32 SOURCES)
list(REMOVE_ITEM lifecycle_provider "$<TARGET_OBJECTS:original_wkfileio>" "$<TARGET_OBJECTS:obj_wow32_res>")
list(APPEND lifecycle_provider "$<TARGET_OBJECTS:lifecycle_wkfileio>")
add_library(lifecycle_provider STATIC EXCLUDE_FROM_ALL ${lifecycle_provider})
set_target_properties(lifecycle_provider PROPERTIES LINKER_LANGUAGE C)
get_target_property(startup_flags obj_compat_wow_user_registration_bridge_obj COMPILE_FLAGS)
wow_unit(lifecycle_registration "${NTVDM_REPO}/src/compat/wow_user_registration_bridge.c"
  "${startup_flags} /DNtvdmReportWowStartup=wow_fixture_NtvdmReportWowStartup")
set_property(TARGET lifecycle_registration PROPERTY EXCLUDE_FROM_ALL TRUE)
set(startup_provider ${lifecycle_provider})
list(REMOVE_ITEM startup_provider "$<TARGET_OBJECTS:obj_compat_wow_user_registration_bridge_obj>")
list(APPEND startup_provider "$<TARGET_OBJECTS:lifecycle_registration>")
add_library(lifecycle_startup_provider STATIC EXCLUDE_FROM_ALL ${startup_provider})
set_target_properties(lifecycle_startup_provider PROPERTIES LINKER_LANGUAGE C)
get_target_property(scope_flags obj_compat_wow_user_task_lifecycle_obj COMPILE_FLAGS)
wow_unit(lifecycle_scope "${NTVDM_REPO}/src/compat/wow_user_task_lifecycle.c"
  "${scope_flags} /Dwow_task_callback_enter=wow_fixture_real_callback_enter /Dwow_task_callback_leave=wow_fixture_real_callback_leave")
set_property(TARGET lifecycle_scope PROPERTY EXCLUDE_FROM_ALL TRUE)
set(procedure_provider ${lifecycle_provider})
list(REMOVE_ITEM procedure_provider "$<TARGET_OBJECTS:obj_compat_wow_user_task_lifecycle_obj>")
list(APPEND procedure_provider "$<TARGET_OBJECTS:lifecycle_scope>")
add_library(lifecycle_procedure_provider STATIC EXCLUDE_FROM_ALL ${procedure_provider})
set_target_properties(lifecycle_procedure_provider PROPERTIES LINKER_LANGUAGE C)
get_target_property(dialog_flags obj_compat_wow_dialog_finalization_binding_obj COMPILE_FLAGS)
wow_unit(lifecycle_dialog_scope "${NTVDM_REPO}/test/adapter-mvdm-host-out/wow/wow_dialog_scope_faults.c" "${dialog_flags}")
set_property(TARGET lifecycle_dialog_scope PROPERTY EXCLUDE_FROM_ALL TRUE)
set(dialog_provider ${lifecycle_provider})
list(REMOVE_ITEM dialog_provider "$<TARGET_OBJECTS:obj_compat_wow_dialog_finalization_binding_obj>")
list(APPEND dialog_provider "$<TARGET_OBJECTS:lifecycle_dialog_scope>")
add_library(lifecycle_dialog_provider STATIC EXCLUDE_FROM_ALL ${dialog_provider})
set_target_properties(lifecycle_dialog_provider PROPERTIES LINKER_LANGUAGE C)
foreach(spec IN ITEMS "unwind|obj_compat_wow_window_creation_binding_obj|wow_creation_unwind_injection.c"
    "allocation|obj_opennt-user_queue_obj|wow_init_allocation_fixture.c"
    "release|obj_compat_wow_user_task_lifecycle_obj|wow_init_release_fixture.c")
  string(REPLACE "|" ";" spec "${spec}")
  list(GET spec 0 name)
  list(GET spec 1 owner)
  list(GET spec 2 source)
  get_target_property(flags ${owner} COMPILE_FLAGS)
  wow_unit(lifecycle_fault_${name} "${NTVDM_REPO}/test/adapter-mvdm-host-out/wow/${source}" "${flags}")
  set_property(TARGET lifecycle_fault_${name} PROPERTY EXCLUDE_FROM_ALL TRUE)
endforeach()
set(unwind_provider ${lifecycle_provider})
list(REMOVE_ITEM unwind_provider "$<TARGET_OBJECTS:obj_compat_wow_window_creation_binding_obj>")
list(APPEND unwind_provider "$<TARGET_OBJECTS:lifecycle_fault_unwind>")
set(rollback_provider ${lifecycle_provider})
list(REMOVE_ITEM rollback_provider "$<TARGET_OBJECTS:obj_opennt-user_queue_obj>" "$<TARGET_OBJECTS:obj_compat_wow_user_task_lifecycle_obj>")
list(APPEND rollback_provider "$<TARGET_OBJECTS:lifecycle_fault_allocation>" "$<TARGET_OBJECTS:lifecycle_fault_release>")
set(lock_provider ${lifecycle_provider})
list(REMOVE_ITEM lock_provider "$<TARGET_OBJECTS:obj_compat_wow_user_task_lifecycle_obj>")
list(APPEND lock_provider "$<TARGET_OBJECTS:lifecycle_retirement_lock>")
foreach(kind IN ITEMS unwind rollback lock)
  add_library(lifecycle_${kind}_provider STATIC EXCLUDE_FROM_ALL ${${kind}_provider})
  set_target_properties(lifecycle_${kind}_provider PROPERTIES LINKER_LANGUAGE C)
endforeach()
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/lifecycle-provider-objects.txt" CONTENT "$<JOIN:${lifecycle_provider},\n>\n")
get_filename_component(lifecycle_worker "${NTVDM_PARENT_IMPORT_LIBRARY}" DIRECTORY)
# The CMD entry builds these exact worker-owned objects before this target.
if(EXISTS "${lifecycle_worker}/lifecycle-inputs.txt")
  file(STRINGS "${lifecycle_worker}/lifecycle-inputs.txt" lifecycle_worker_inputs)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lifecycle_worker}/lifecycle-inputs.txt")
  set(native_cases native-send native-reply native-nested native-seen native-identity native-foreign native-indirect)
  set(page_cases window-borrow graph-snapshot standard-class class-procedure native-creation creation-unwind window-reclaim menu-resource
    original-modal initial-publication dialog-lifecycle)
  set(lifecycle_cases task init-rollback retirement-lock ${native_cases}
    original-hook-cleanup task-order thunk-scope start-notification menu-cleanup class-client class-query class-lifetime
    process-retirement init-notification native-dispatch-gate window-procedure ${page_cases})
  foreach(spec IN ITEMS "standard-class|wow_standard_class_fixture.c|wow_standard_class_fixture"
      "class-procedure|wow_class_procedure_fixture.c|wow_class_procedure_fixture"
      "native-creation|wow_native_creation_binding_fixture.c|wow_native_creation_fixture")
    string(REPLACE "|" ";" spec "${spec}")
    list(GET spec 0 kind)
    list(GET spec 1 source)
    list(GET spec 2 entry)
    wow_unit(lifecycle_entry_${kind} "${NTVDM_REPO}/test/adapter-mvdm-host-out/wow/${source}"
      "${lifecycle_flags} /Dmain=${entry}")
    set_property(TARGET lifecycle_entry_${kind} PROPERTY EXCLUDE_FROM_ALL TRUE)
  endforeach()
  wow_unit(lifecycle_entry_creation-unwind "${NTVDM_REPO}/test/adapter-mvdm-host-out/wow/wow_native_creation_binding_fixture.c"
    "${lifecycle_flags} /Dmain=wow_native_creation_fixture /DWOW_CREATION_UNWIND_FIXTURE")
  set_property(TARGET lifecycle_entry_creation-unwind PROPERTY EXCLUDE_FROM_ALL TRUE)
  wow_unit(lifecycle_typed_callers "${NTVDM_REPO}/test/adapter-mvdm-host-out/wow/wow_typed_procedure_callers.c" "${lifecycle_original_flags}")
  set_property(TARGET lifecycle_typed_callers PROPERTY EXCLUDE_FROM_ALL TRUE)
  ntvdm_source_projection("menu-macros.inc" "${NTVDM_REPO}/src/mvdm-host/wow32/wres16.c"
    "#define VALIDPUT" "MODNAME(" "" FALSE)
  ntvdm_source_projection("menu-converter.inc" "${NTVDM_REPO}/src/mvdm-host/wow32/wres16.c"
    "DWORD ConvertMenu16(" "DWORD ConvertDialog16(" "" FALSE)
  ntvdm_function_body(menu_load "${NTVDM_REPO}/src/mvdm-host/wow32/wumenu.c" WU32LoadMenu)
  ntvdm_function_body(menu_indirect "${NTVDM_REPO}/src/mvdm-host/wow32/wumenu.c" WU32LoadMenuIndirect)
  file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/original-menu-thunks.inc"
    CONTENT "${menu_load}\n${menu_indirect}\n" @ONLY)
  file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/original-menu-convert.inc"
    CONTENT "#include \"menu-macros.inc\"\n#include \"menu-converter.inc\"\n" @ONLY)
  ntvdm_function_body(menu_cover "${NTVDM_REPO}/src/non-mvdm/windows/core/ntuser/client/clres.c" WOWFindResourceExWCover)
  ntvdm_source_projection("original-menu-resource-inputs.inc"
    "${NTVDM_REPO}/src/non-mvdm/windows/core/ntuser/client/clmenu.c"
    "HMENU CommonLoadMenu(" "" "${menu_cover}\n" FALSE)
  foreach(kind IN ITEMS resource thunk)
    string(TOUPPER "${kind}" upper)
    set(definition WOW_${upper}_BOUND_FIXTURE)
    if(kind STREQUAL "thunk")
      set(definition WOW_MENU_THUNK_BOUND_FIXTURE)
    endif()
    wow_unit(lifecycle_menu_${kind} "${NTVDM_REPO}/test/adapter-mvdm-host-out/wow/wow_original_menu_${kind}_fixture.c"
      "${lifecycle_original_flags} /D${definition} /I \"${CMAKE_BINARY_DIR}\"")
    set_property(TARGET lifecycle_menu_${kind} PROPERTY EXCLUDE_FROM_ALL TRUE)
  endforeach()
  ntvdm_source_projection("startup-owner.inc" "${NTVDM_REPO}/src/mvdm-host/wow32/wkman.c"
    "BOOL WINAPI wow_original_task_cleanup_uninitialized(" "VOID WINAPI wow_original_task_retire_async(" "" FALSE)
  wow_unit(lifecycle_startup_td "${NTVDM_REPO}/test/adapter-mvdm-host-out/wow/wow_startup_td_fixture.c"
    "${lifecycle_original_flags} /I \"${CMAKE_BINARY_DIR}\"")
  set_property(TARGET lifecycle_startup_td PROPERTY EXCLUDE_FROM_ALL TRUE)
  ntvdm_source_projection("lifecycle-after.h" "${NTVDM_REPO}/src/compat/wow_user_task_lifecycle.c"
    "#define WOW_NATIVE_CALL_AFTER(" "#define WOW_NATIVE_CALL_RESULT(" "" FALSE)
  ntvdm_source_projection("lifecycle-message.h" "${NTVDM_REPO}/src/compat/wow_user_task_lifecycle.c"
    "#define WOW_NATIVE_MESSAGE(" "WOW_NATIVE_MESSAGE(SendMessageA," "" FALSE)
  file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/wow_native_fixture_call.h"
    CONTENT "#include \"lifecycle-after.h\"\n#include \"lifecycle-message.h\"\n" @ONLY)
  foreach(kind IN LISTS lifecycle_cases)
    set(fixture lifecycle_task)
    set(parent lifecycle_parent)
    set(provider lifecycle_provider)
    set(worker_inputs ${lifecycle_worker_inputs})
    set(extra)
    if(kind STREQUAL "initial-publication")
      set(provider lifecycle_startup_provider)
      list(APPEND extra "$<TARGET_OBJECTS:lifecycle_startup_td>")
    endif()
    if(kind STREQUAL "menu-resource")
      list(APPEND extra "$<TARGET_OBJECTS:lifecycle_menu_resource>" "$<TARGET_OBJECTS:lifecycle_menu_thunk>")
    endif()
    if(kind STREQUAL "window-procedure" OR kind IN_LIST page_cases)
      set(parent)
      file(STRINGS "${lifecycle_worker}/lifecycle-real-inputs.txt" worker_inputs)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lifecycle_worker}/lifecycle-real-inputs.txt")
    endif()
    if(kind STREQUAL "window-reclaim")
      file(STRINGS "${lifecycle_worker}/lifecycle-reclaim-inputs.txt" worker_inputs)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lifecycle_worker}/lifecycle-reclaim-inputs.txt")
    endif()
    if(kind STREQUAL "dialog-lifecycle")
      set(provider lifecycle_dialog_provider)
      file(STRINGS "${lifecycle_worker}/lifecycle-dialog-inputs.txt" worker_inputs)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lifecycle_worker}/lifecycle-dialog-inputs.txt")
    endif()
    if(kind STREQUAL "standard-class" OR kind STREQUAL "class-procedure" OR kind STREQUAL "native-creation" OR kind STREQUAL "creation-unwind")
      list(APPEND extra "$<TARGET_OBJECTS:lifecycle_entry_${kind}>")
      if(kind STREQUAL "class-procedure")
        list(APPEND extra "$<TARGET_OBJECTS:lifecycle_typed_callers>")
      endif()
    endif()
    if(kind STREQUAL "creation-unwind")
      set(provider lifecycle_unwind_provider)
    elseif(kind STREQUAL "init-rollback")
      set(provider lifecycle_rollback_provider)
    elseif(kind STREQUAL "retirement-lock")
      set(provider lifecycle_lock_provider)
    endif()
    if(kind STREQUAL "window-procedure" OR kind STREQUAL "native-dispatch-gate")
      set(provider lifecycle_procedure_provider)
    endif()
    if(kind STREQUAL "process-retirement" OR kind STREQUAL "init-notification")
      if(kind STREQUAL "process-retirement")
        set(profile retirement)
      else()
        set(profile startup)
        set(provider lifecycle_startup_provider)
        list(APPEND extra "$<TARGET_OBJECTS:lifecycle_startup_td>")
      endif()
      file(STRINGS "${lifecycle_worker}/lifecycle-${profile}-inputs.txt" worker_inputs)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lifecycle_worker}/lifecycle-${profile}-inputs.txt")
    endif()
    if(NOT kind STREQUAL "task")
      set(flags "${lifecycle_flags}")
      set(source wow_user_task_lifecycle_fixture.c)
      if(kind IN_LIST native_cases)
        string(APPEND flags " /DWOW_NATIVE_SEND_FIXTURE /I \"${CMAKE_BINARY_DIR}\"")
      endif()
      if(kind IN_LIST native_cases AND NOT kind STREQUAL "native-send")
        string(REPLACE "native-" "" option "${kind}")
        string(TOUPPER "${option}" option)
        string(APPEND flags " /DWOW_NATIVE_${option}_FIXTURE")
      endif()
      if(kind STREQUAL "init-rollback")
        string(APPEND flags " /DWOW_INIT_ROLLBACK_FIXTURE")
      elseif(kind STREQUAL "retirement-lock")
        string(APPEND flags " /DWOW_RETIREMENT_LOCK_PROBE")
      elseif(kind STREQUAL "original-hook-cleanup")
        set(source wow_original_hook_cleanup_fixture.c)
        set(flags "${lifecycle_original_flags}")
      elseif(kind STREQUAL "task-order")
        set(source wow_task_order_fixture.c)
        string(APPEND flags " /we4113 /we4047")
      elseif(kind STREQUAL "thunk-scope")
        set(source wow_user_thunk_scope_fixture.c)
        set(flags "${lifecycle_original_flags} /we4113 /we4047")
      elseif(kind STREQUAL "start-notification")
        string(APPEND flags " /DWOW_START_NOTIFICATION_FIXTURE")
      elseif(kind STREQUAL "process-retirement")
        set(source wow_process_retirement_fixture.c)
      elseif(kind STREQUAL "init-notification")
        set(source wow_init_notification_fixture.c)
      elseif(kind STREQUAL "native-dispatch-gate")
        set(source wow_native_dispatch_gate_fixture.c)
      elseif(kind STREQUAL "window-procedure")
        set(source wow_window_procedure_fixture.c)
      elseif(kind IN_LIST page_cases)
        set(source ../../mvdm-host/wow_page_domain_fixture.c)
        string(APPEND flags " /DWOW_WINDOW_BORROW_FIXTURE")
        if(kind STREQUAL "graph-snapshot")
          string(APPEND flags " /DWOW_GRAPH_SNAPSHOT_FIXTURE")
        elseif(kind STREQUAL "standard-class")
          string(APPEND flags " /DWOW_STANDARD_CLASS_FIXTURE")
        elseif(kind STREQUAL "class-procedure")
          string(APPEND flags " /DWOW_CLASS_PROCEDURE_FIXTURE")
        elseif(kind STREQUAL "native-creation" OR kind STREQUAL "creation-unwind")
          string(APPEND flags " /DWOW_NATIVE_CREATION_FIXTURE")
        elseif(kind STREQUAL "window-reclaim")
          string(APPEND flags " /DWOW_RECLAIM_FAILURE_FIXTURE")
        elseif(kind STREQUAL "menu-resource")
          string(APPEND flags " /DWOW_RESOURCE_CLIENT_FIXTURE")
        elseif(kind STREQUAL "original-modal")
          string(APPEND flags " /DWOW_ORIGINAL_MODAL_FIXTURE")
        elseif(kind STREQUAL "initial-publication")
          string(APPEND flags " /DWOW_INITIAL_PUBLICATION_FIXTURE")
        elseif(kind STREQUAL "dialog-lifecycle")
          string(APPEND flags " /DWOW_ORIGINAL_MODAL_FIXTURE /DWOW_REAL_DIALOG_LIFECYCLE_FIXTURE")
        endif()
      elseif(kind STREQUAL "menu-cleanup")
        string(APPEND flags " /DWOW_MENU_CLEANUP_FIXTURE")
        set(parent lifecycle_parent_menu)
      elseif(kind MATCHES "^class-")
        set(parent lifecycle_parent_class)
        if(kind STREQUAL "class-client")
          set(source wow_class_client_fixture.c)
        elseif(kind STREQUAL "class-query")
          set(source wow_class_query_fixture.c)
        else()
          set(source wow_window_class_lifetime_fixture.c)
        endif()
      endif()
      set(fixture lifecycle_${kind})
      wow_unit(${fixture} "${NTVDM_REPO}/test/adapter-mvdm-host-out/wow/${source}" "${flags}")
      set_property(TARGET ${fixture} PROPERTY EXCLUDE_FROM_ALL TRUE)
    endif()
    set(output "${CMAKE_BINARY_DIR}/lifecycle-${kind}.exe")
  set(lifecycle_direct ${extra})
  if(fixture)
    list(APPEND lifecycle_direct "$<TARGET_OBJECTS:${fixture}>")
  endif()
  if(parent)
    list(APPEND lifecycle_direct "$<TARGET_OBJECTS:${parent}>")
  endif()
  list(APPEND lifecycle_direct
    "$<TARGET_OBJECTS:lifecycle_imports>" "$<TARGET_OBJECTS:lifecycle_seams>"
    "$<TARGET_OBJECTS:obj_wow32-system-import-abi-aliases_obj>"
    "$<TARGET_OBJECTS:obj_wow32-parent-import-abi-aliases_obj>")
  add_custom_command(OUTPUT "${output}"
    COMMAND "${CMAKE_LINKER}" /nologo /NODEFAULTLIB:ntvdm.lib "/out:${output}" "/map:${output}.map"
      ${lifecycle_direct} "$<TARGET_FILE:${provider}>" ${worker_inputs}
      "${CMAKE_BINARY_DIR}/legacy-wow-user32.lib" "${CMAKE_BINARY_DIR}/legacy-wow-kernel32.lib"
      "${CMAKE_BINARY_DIR}/legacy-wow-ntdll.lib" version.lib comdlg32.lib rpcrt4.lib kernel32.lib
      user32.lib gdi32.lib shell32.lib advapi32.lib ntdll.lib oldnames.lib libcmt.lib libvcruntime.lib libucrt.lib
    DEPENDS ${provider} ${fixture} ${parent} lifecycle_imports lifecycle_seams wow-imports
      ${lifecycle_direct} "$<TARGET_FILE:${provider}>" ${worker_inputs}
    COMMAND_EXPAND_LISTS VERBATIM)
  add_custom_target(wow-lifecycle-${kind} DEPENDS "${output}")
  endforeach()
endif()
endfunction()
wow_lifecycle_tests()
